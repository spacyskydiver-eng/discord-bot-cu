<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Collective Union Events</title>
<meta name="description" content="Collective Union Events: The Great War, 17 December 2026.">
<meta name="theme-color" content="#0D1120">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/app.css?v=<%= v %>">
<link rel="stylesheet" href="/assets/neural.css?v=<%= v %>">
<link rel="stylesheet" href="/assets/views.css?v=<%= v %>">
<link rel="stylesheet" href="/assets/nova.css?v=<%= v %>">
<link rel="stylesheet" href="/assets/menu-bg.css?v=<%= v %>">
<link rel="preload" as="image" href="<%= media.menuPoster %>.webp" type="image/webp">
<script>window.CUE = <%- cueJson %>; window.CUE_ASSET_V = '<%= v %>';</script>
</head>
<body class="theme-dark ui-nova has-menubg">
<%- include('partials/menu-bg') %>
<noscript>
  <div style="max-width:640px;margin:40px auto;padding:0 16px;font-family:Inter,system-ui,sans-serif;color:#E8EBF8;line-height:1.6">
    <h1 style="font-size:24px">Collective Union Events</h1>
    <p>This site needs JavaScript.</p>
    <% for (const s of noscriptSessions) { %><p><b><%= s.title %></b>: <%= s.when %>.</p><% } %>
  </div>
</noscript>
<div class="app-container" id="app">
  <div class="loading-screen" id="loading">
    <div class="loading-orb"></div>
    <div class="loading-text">Opening CUE…</div>
  </div>
</div>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script defer src="/assets/graph3d.js?v=<%= v %>"></script>
<script defer src="/assets/app.js?v=<%= v %>"></script>
<script defer src="/assets/leaders.js?v=<%= v %>"></script>
<script defer src="/assets/staff-apply.js?v=<%= v %>"></script>
<script defer src="/assets/account.js?v=<%= v %>"></script>
<% if (staffScript) { %><script defer src="<%= staffScript %>"></script><% } %>
</body>
</html>
