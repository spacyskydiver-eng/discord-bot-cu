<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Collective Union Events</title>
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/assets/menu-bg.css">
<style>
:root { --bg: #05060D; --card: #0D1120; --line: rgba(140,155,255,.16); --text: #E8EBF8; --muted: #A7AFD2; --faint: #6E769C; --violet: #8B5CF6; }
* { box-sizing: border-box; margin: 0; padding: 0; }
body { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; background: var(--bg); color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
.card { width: 100%; max-width: 460px; text-align: center; padding: 44px 32px; background: rgba(13,17,32,.78); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 24px 70px rgba(0,0,0,.55); }
.k { font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: #A78BFA; font-weight: 650; margin-bottom: 14px; }
h1 { font-size: 30px; letter-spacing: -.02em; line-height: 1.1; margin-bottom: 12px; }
p { color: var(--muted); line-height: 1.6; font-size: 15px; }
.who { margin-top: 20px; font-size: 13px; color: var(--faint); }
.btn { display: inline-block; margin-top: 24px; padding: 11px 20px; border-radius: 12px; border: 1px solid rgba(139,92,246,.45); background: rgba(139,92,246,.14); color: #E9DDFF; font-size: 14px; font-weight: 600; text-decoration: none; }
.btn:hover { background: rgba(139,92,246,.24); }
</style>
</head>
<body>
<%- include('partials/menu-bg') %>
<main class="card">
  <div class="k">Collective Union Events</div>
  <h1>Back soon</h1>
  <p>The website is down for maintenance while we get ready for The Great War. Check the Discord for updates.</p>
  <% if (user) { %>
    <p class="who">Signed in as <%= user.username %></p>
    <a class="btn" href="/auth/logout">Sign out</a>
  <% } else { %>
    <a class="btn" href="/auth/discord">Sign in with Discord</a>
  <% } %>
</main>
</body>
</html>
