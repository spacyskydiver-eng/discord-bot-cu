<% const pub = !!locals.pub, viewer = !!locals.viewer || pub; %>
<%# pub: the public map at /map (no values, coordinates, grid or admin controls; its data is the public cut) %>
<%- include('partials/head', { pageTitle: pub ? 'The Great War: Map' : viewer ? 'Campaign Map' : 'Campaign Map · Control Centre' }) %>
<%- include('partials/header') %>
<style>
.cm { --sea: #12324f; --ink: #0c0e11; --paper: #f3ecd9; --hud: rgba(14,17,24,.92); --line: rgba(255,255,255,.12);
  display: grid; grid-template-columns: 1fr 340px; height: calc(100vh - 64px); min-height: 560px; background: #0b0d12; }
.cm-stage { position: relative; overflow: hidden; background: radial-gradient(120% 90% at 50% 40%, #1a4468 0%, #12324f 55%, #0b2036 100%);
  touch-action: none; user-select: none; -webkit-user-select: none; cursor: grab; }
.cm-stage.dragging { cursor: grabbing; }
.cm-stage > svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.cm-hud { pointer-events: none; }
.cm-font { font-family: 'Baloo 2', system-ui, sans-serif; }

/* board pieces */
.t-shape { stroke: none; transition: opacity .15s; }
.t-edge { fill: none; stroke: var(--ink); stroke-width: 3px; stroke-linejoin: round; vector-effect: non-scaling-stroke; pointer-events: none; transition: opacity .15s; }
.t-rim { fill: none; stroke: rgba(255,255,255,.28); stroke-width: 5px; vector-effect: non-scaling-stroke; }
.t-sheen { fill: url(#cm-sheen); pointer-events: none; }
.t-shadow { fill: rgba(0,0,0,.55); }
/* detail and relief (maps that carry them: edges, rivers, surround, relief) */
.surround { fill: #6b716c; }
.coast-halo { fill: none; stroke-linejoin: round; }
.veil { fill: rgba(6,14,24,.55); pointer-events: none; }
.frame-line { fill: none; stroke: rgba(255,255,255,.35); stroke-width: 1.5px; stroke-dasharray: 6 5; vector-effect: non-scaling-stroke; pointer-events: none; }
.relief { mix-blend-mode: overlay; pointer-events: none; }
.river { fill: none; stroke: #2f6fa3; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; pointer-events: none; opacity: .9; }
.e-inner { fill: none; stroke: rgba(12,14,17,.5); stroke-width: 1px; vector-effect: non-scaling-stroke; stroke-linejoin: round; pointer-events: none; }
.e-coast { fill: none; stroke: var(--ink); stroke-width: 1.6px; vector-effect: non-scaling-stroke; stroke-linejoin: round; pointer-events: none; }
.e-nation { fill: none; stroke: var(--ink); stroke-width: 3px; vector-effect: non-scaling-stroke; stroke-linejoin: round; pointer-events: none; }
.land { fill: #8f918c; stroke: #2b2d2f; stroke-width: 1.4px; vector-effect: non-scaling-stroke; }
.ter { stroke: #2b2d2f; stroke-width: 1.4px; vector-effect: non-scaling-stroke; }
.glow-wide { fill: none; stroke-width: 16px; stroke-opacity: .35; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
.glow-thin { fill: none; stroke-width: 8px; stroke-opacity: .9; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
.grid-line { stroke: rgba(255,255,255,.16); stroke-width: 1px; vector-effect: non-scaling-stroke; }
.grid-axis { stroke: rgba(255,214,102,.45); stroke-width: 1.4px; vector-effect: non-scaling-stroke; }
.sel-outline { fill: none; stroke: #fff; stroke-width: 4.5px; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
.nb-outline { fill: none; stroke: #ffd666; stroke-width: 3px; stroke-dasharray: 7 5; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
.dim .t-shape:not(.lit) { opacity: .38; }
.dim .t-sheen, .dim .t-rim { opacity: .5; }

.route-sea { stroke: rgba(255,255,255,.92); stroke-width: 2.2px; stroke-dasharray: 2 7; stroke-linecap: round; fill: none; }
.route-other { stroke: #ffc94d; stroke-width: 2.2px; stroke-dasharray: 2 6; stroke-linecap: round; fill: none; }
.route-end { fill: #fff; stroke: rgba(0,0,0,.6); stroke-width: 1.2px; }
.route-end.other { fill: #ffc94d; }
.route-lit { stroke-width: 3.2px; }
.tok-ring { stroke: #0c0e11; stroke-width: 2px; }
.tok-inner { fill: none; stroke: rgba(255,255,255,.75); stroke-width: 1.5px; }
.tok-num { font-weight: 800; text-anchor: middle; dominant-baseline: central; letter-spacing: .02em; }
<% if (!pub) { %>.tok-val rect { fill: #ffd666; stroke: #0c0e11; stroke-width: 1.6px; }
.tok-val text { font-weight: 800; text-anchor: middle; dominant-baseline: central; fill: #16181d; }
<% } %>.lbl { font-weight: 800; text-anchor: middle; fill: #fff; paint-order: stroke; stroke: rgba(8,10,14,.85); stroke-width: 3.2px; stroke-linejoin: round; letter-spacing: .02em; }
.lbl-mark { font-weight: 700; font-size: 11px; fill: #ffe8a8; paint-order: stroke; stroke: rgba(8,10,14,.9); stroke-width: 3px; }
.grid-lbl { font: 600 10px Inter, sans-serif; fill: rgba(255,255,255,.6); paint-order: stroke; stroke: rgba(8,10,14,.8); stroke-width: 2.5px; }
.cross { stroke: #fff; stroke-width: 1.5px; }

/* controls */
.cm-ctl { position: absolute; display: flex; gap: 6px; z-index: 3; }
.cm-zoom { top: 14px; right: 14px; flex-direction: column; }
.cm .cm-btn { width: 40px; height: 40px; border-radius: 10px; border: 2px solid var(--ink); background: var(--paper); color: #1b1d22;
  font: 800 20px 'Baloo 2', sans-serif; cursor: pointer; box-shadow: 0 3px 0 rgba(0,0,0,.45); display: grid; place-items: center; }
.cm .cm-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(0,0,0,.45); }
.cm .cm-btn.small { font-size: 12px; }
.cm-layers { top: 14px; left: 14px; flex-wrap: wrap; max-width: calc(100% - 90px); }
.cm .cm-chip { padding: 6px 12px; border-radius: 999px; border: 2px solid var(--ink); background: var(--paper); color: #1b1d22;
  font: 800 13px 'Baloo 2', sans-serif; cursor: pointer; box-shadow: 0 2px 0 rgba(0,0,0,.45); }
.cm .cm-chip[aria-pressed="false"] { background: rgba(243,236,217,.35); color: #e9e4d6; border-color: rgba(0,0,0,.5); }
<% if (!pub) { %>.cm-coord { position: absolute; left: 14px; bottom: 14px; z-index: 3; padding: 6px 12px; border-radius: 10px; background: var(--hud);
  border: 1px solid var(--line); color: #fff; font: 700 13px Inter, sans-serif; font-variant-numeric: tabular-nums; pointer-events: none; }
.cm-coord b { color: #ffd666; font-weight: 700; }
<% } %>.cm-tip { position: absolute; z-index: 4; pointer-events: none; padding: 4px 10px; border-radius: 8px; background: var(--paper); color: #16181d;
  border: 2px solid var(--ink); font: 800 14px 'Baloo 2', sans-serif; transform: translate(-50%, calc(-100% - 14px)); white-space: nowrap; display: none; }

/* legend */
.cm-legend { position: absolute; left: 14px; bottom: 56px; z-index: 3; width: 270px; max-height: calc(100% - 130px); overflow: auto;
  background: var(--hud); border: 1px solid var(--line); border-radius: 14px; color: #e8e9ee; font-size: 12.5px; }
.cm-legend summary { cursor: pointer; padding: 10px 14px; font: 800 15px 'Baloo 2', sans-serif; color: #fff; list-style: none; }
.cm-legend summary::-webkit-details-marker { display: none; }
.cm-legend summary::after { content: '+'; float: right; color: #ffd666; }
.cm-legend[open] summary::after { content: '\2212'; }
.cm-legend .sec { padding: 0 14px 12px; }
.cm-legend h4 { margin: 6px 0 6px; font: 800 11px Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #9aa0ad; }
.lg-row { display: flex; align-items: center; gap: 8px; padding: 3px 4px; border-radius: 6px; }
.lg-row.btn { cursor: pointer; } .lg-row.btn:hover, .lg-row.btn.on { background: rgba(255,255,255,.08); }
.lg-sw { width: 14px; height: 14px; border-radius: 4px; border: 2px solid var(--ink); flex: none; }
.lg-row .n { flex: 1; } .lg-row .v { font: 800 13px 'Baloo 2', sans-serif; color: #ffd666; }
.lg-row .c { color: #9aa0ad; font-size: 11.5px; }

/* side panel */
.cm-panel { background: #12151c; border-left: 1px solid var(--line); overflow: auto; padding: 18px 18px 40px; color: #dfe2ea; font-size: 13.5px; }
<% if (!pub) { %>.cm-panel .back { display: inline-block; color: #9aa0ad; font-size: 13px; text-decoration: none; margin-bottom: 12px; }
<% } %>.cm-panel h1 { font: 800 26px/1.1 'Baloo 2', sans-serif; margin: 0 0 4px; color: #fff; }
.cm-panel h3 { font: 800 11px Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #9aa0ad; margin: 18px 0 8px; }
.cm-panel p { margin: 0 0 8px; line-height: 1.55; color: #b9bdc8; }
.cm-badge { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px 4px 6px; border-radius: 999px; background: rgba(255,255,255,.06);
  border: 1px solid var(--line); font: 700 13px 'Baloo 2', sans-serif; color: #fff; margin: 0 6px 6px 0; }
.cm-badge .lg-sw { width: 12px; height: 12px; }
.cm-badge.gold { color: #ffd666; }
.cm .nb { display: flex; align-items: center; gap: 8px; width: 100%; padding: 7px 8px; border-radius: 8px; border: 0; background: none; color: #e8e9ee;
  font: 600 13.5px Inter, sans-serif; cursor: pointer; text-align: left; }
.nb:hover { background: rgba(255,255,255,.06); }
.nb .n { flex: 1; }
.nb .k { font: 700 11px Inter, sans-serif; padding: 2px 7px; border-radius: 999px; background: rgba(255,255,255,.08); color: #c6cad4; white-space: nowrap; }
.nb .k.sea { background: rgba(120,180,255,.18); color: #b9d8ff; } .nb .k.pass { background: rgba(255,201,77,.18); color: #ffd98a; }
.facts { display: grid; grid-template-columns: 110px 1fr; gap: 5px 10px; font-size: 13px; }
.facts dt { color: #9aa0ad; } .facts dd { margin: 0; font-variant-numeric: tabular-nums; color: #fff; }
.copy { cursor: pointer; border-bottom: 1px dashed rgba(255,255,255,.35); } .copy:hover { color: #ffd666; }
.rule { padding: 10px 12px; border-radius: 10px; background: rgba(255,214,102,.08); border: 1px solid rgba(255,214,102,.25); color: #f4e3b5; line-height: 1.5; }
<% if (!pub) { %>.cm-msg { padding: 10px 12px; border-radius: 10px; margin-bottom: 12px; background: rgba(52,211,153,.1); border: 1px solid rgba(52,211,153,.35); color: #bff3dc; line-height: 1.5; overflow-wrap: anywhere; }
.cm-msg.bad { background: rgba(248,113,113,.1); border-color: rgba(248,113,113,.4); color: #fecaca; }
.cm-up { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; margin-bottom: 16px; background: rgba(255,255,255,.03); }
.cm-up summary { cursor: pointer; font: 800 14px 'Baloo 2', sans-serif; color: #fff; }
.cm-up .src { display: block; font: 500 12px Inter, sans-serif; color: #9aa0ad; margin-top: 2px; }
.cm-up form { margin-top: 10px; display: grid; gap: 8px; }
.cm-up input[type=file] { color: #c6cad4; font-size: 12.5px; max-width: 100%; }
.cm .cm-upbtn { justify-self: start; padding: 8px 14px; border-radius: 8px; background: #ffd666; color: #16181d; border: 2px solid var(--ink); font: 800 13px 'Baloo 2', sans-serif; }
.cm-up a { color: #ffd666; }
.cm-up p { font-size: 12.5px; margin: 8px 0; }
.cm-share { width: 100%; box-sizing: border-box; background: rgba(0,0,0,.3); border: 1px solid var(--line); border-radius: 8px; color: #e8e9ee; padding: 8px 10px; font: 12px ui-monospace, Menlo, monospace; }
.cm-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 8px; } .cm-row form { margin: 0; display: block; }
.cm .cm-plain { padding: 7px 12px; border-radius: 8px; border: 1px solid var(--line); color: #c6cad4; font: 700 12.5px Inter, sans-serif; }
.cm .cm-plain:hover { border-color: #f87171; color: #fecaca; }
<% } %>.cm-err { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font: 700 15px Inter, sans-serif; padding: 20px; text-align: center; }

@media (max-width: 860px) {
  .cm { grid-template-columns: 1fr; grid-template-rows: 1fr auto; height: calc(100vh - 64px); }
  .cm-panel { border-left: 0; border-top: 1px solid var(--line); max-height: 42vh; padding: 14px 16px 24px; }
  .cm-legend { width: 230px; bottom: 54px; max-height: 45%; }
  .cm-legend:not([open]) { width: auto; }
  /* the public map on a phone: more map, smaller controls */
  .cm.pub .cm-panel { max-height: 34vh; }
  .cm.pub .cm-chip { padding: 4px 9px; font-size: 12px; }
  .cm.pub .cm-btn { width: 34px; height: 34px; font-size: 17px; }
  .cm.pub .cm-btn.small { font-size: 10.5px; }
  .cm.pub .cm-legend summary { padding: 7px 11px; font-size: 13.5px; }
  .cm.pub .cm-legend { left: 10px; bottom: 10px; }
}
</style>

<main class="cm<%= pub ? ' pub' : '' %>">
  <div class="cm-stage" id="cm-stage">
    <svg id="cm-board" aria-label="Campaign map">
      <defs>
        <pattern id="cm-waves" width="90" height="46" patternUnits="userSpaceOnUse">
          <path d="M0 23 q22.5 -9 45 0 t45 0" fill="none" stroke="rgba(255,255,255,.05)" stroke-width="4"/>
          <path d="M-45 0 q22.5 -9 45 0 t45 0 t45 0" fill="none" stroke="rgba(0,0,0,.08)" stroke-width="4"/>
        </pattern>
        <linearGradient id="cm-sheen" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".22"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/>
          <stop offset="1" stop-color="#000" stop-opacity=".22"/>
        </linearGradient>
        <pattern id="cm-hatch" width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="40" stroke="rgba(0,0,0,.28)" stroke-width="10"/></pattern>
        <pattern id="cm-ice" width="60" height="60" patternUnits="userSpaceOnUse">
          <path d="M10 30 h40 M30 10 v40" stroke="rgba(120,150,175,.35)" stroke-width="5"/></pattern>
        <pattern id="cm-dunes" width="120" height="50" patternUnits="userSpaceOnUse">
          <path d="M0 35 q30 -18 60 0 t60 0" fill="none" stroke="rgba(110,85,40,.35)" stroke-width="6"/></pattern>
        <pattern id="cm-peaks" width="90" height="70" patternUnits="userSpaceOnUse">
          <path d="M8 58 L30 22 L52 58 M42 58 L62 30 L82 58" fill="none" stroke="rgba(30,30,30,.45)" stroke-width="7" stroke-linejoin="round"/></pattern>
        <pattern id="cm-rough" width="70" height="70" patternUnits="userSpaceOnUse">
          <path d="M10 50 L25 25 L40 50" fill="none" stroke="rgba(0,0,0,.42)" stroke-width="6" stroke-linejoin="round"/></pattern>
        <pattern id="cm-marsh" width="80" height="40" patternUnits="userSpaceOnUse">
          <path d="M10 28 h24 M46 14 h24" stroke="rgba(10,40,30,.5)" stroke-width="6" stroke-linecap="round"/></pattern>
      </defs>
      <rect id="cm-sea" fill="url(#cm-waves)"></rect>
      <g id="cm-world">
        <g id="L-coast"></g>
        <g id="L-surround"></g>
        <g id="L-land"></g>
        <g id="L-glow"></g>
        <g id="L-shadow"></g>
        <g id="L-terr"></g>
        <g id="L-rim"></g>
        <g id="L-sheen"></g>
        <g id="L-terrain"></g>
        <g id="L-relief"></g>
        <g id="L-rivers"></g>
        <g id="L-edge"></g>
        <g id="L-veil"></g>
        <g id="L-grid"></g>
        <g id="L-sel"></g>
      </g>
      <g class="cm-hud cm-font" id="cm-hud">
        <g id="H-grid"></g><g id="H-routes"></g><g id="H-marks"></g><g id="H-labels"></g><g id="H-tokens"></g><g id="H-cross"></g>
      </g>
    </svg>

    <div class="cm-ctl cm-layers" id="cm-layers">
      <button class="cm-chip" data-layer="tokens" aria-pressed="true">Tokens</button>
      <button class="cm-chip" data-layer="routes" aria-pressed="true">Sea lines</button>
      <button class="cm-chip" data-layer="terrain" aria-pressed="true">Terrain</button>
      <button class="cm-chip" data-layer="names" aria-pressed="false">Names</button>
      <% if (pub) { %><button class="cm-chip" id="cm-colour" data-mode="nation" aria-label="Colour by nation or by theatre">Colour: nation</button>
      <% } else { %><button class="cm-chip" data-layer="grid" aria-pressed="false">500 grid</button><% } %>
    </div>
    <div class="cm-ctl cm-zoom">
      <button class="cm-btn" id="cm-in" title="Zoom in" aria-label="Zoom in">+</button>
      <button class="cm-btn" id="cm-out" title="Zoom out" aria-label="Zoom out">&minus;</button>
      <button class="cm-btn small" id="cm-reset" title="Reset view" aria-label="Reset view">FIT</button>
    </div>

    <details class="cm-legend" id="cm-legend">
      <summary>Legend</summary>
      <div class="sec" id="cm-legend-body"></div>
    </details>
    <% if (!pub) { %><div class="cm-coord" id="cm-coord">x <b>&ndash;</b> &middot; z <b>&ndash;</b></div><% } %>
    <div class="cm-tip" id="cm-tip"></div>
  </div>

  <aside class="cm-panel" id="cm-panel">
    <% if (!viewer) { %>
    <a class="back" href="/admin">&larr; Control Centre</a>
    <% if (msg) { %><div class="cm-msg <%= bad ? 'bad' : '' %>"><%= msg %></div><% } %>
    <details class="cm-up" <%= bad ? 'open' : '' %>>
      <summary>Map file
        <span class="src"><% if (current.source === 'database') { %>uploaded <time data-ts="<%= Math.floor(new Date(current.updatedAt).getTime() / 1000) %>"></time><% } else if (current.source === 'local file') { %>local file (not uploaded)<% } else if (current.source === 'error') { %>can't read: <%= current.error %><% } else { %>none uploaded<% } %></span>
      </summary>
      <form method="POST" action="/admin/campaign-map/upload" enctype="multipart/form-data">
        <p>Swap in a new map JSON. It's checked before it replaces the current one, and kept in the database, never in the repo.</p>
        <input type="file" name="map" accept=".json,application/json" required>
        <button class="cm-upbtn" type="submit">Upload and replace</button>
      </form>
      <% if (current.source === 'database') { %><p class="src"><%= (current.size / 1024).toFixed(0) %> KB<%= current.uploadedBy ? ', by ' + current.uploadedBy : '' %>. <a href="/admin/campaign-map/data.json" download="greatwar_map.json">Download the current one</a></p><% } %>
    </details>
    <details class="cm-up">
      <summary>Share link <span class="src"><%= shareUrl ? 'on: anyone with the link can view' : 'off' %></span></summary>
      <% if (shareUrl) { %>
      <p>Anyone with this link sees the board read-only (no upload, nothing else of the control centre), even while the site is in maintenance.</p>
      <input class="cm-share" type="text" readonly value="<%= shareUrl %>" onclick="this.select()">
      <div class="cm-row">
        <button class="cm-upbtn" type="button" onclick="navigator.clipboard && navigator.clipboard.writeText('<%= shareUrl %>').then(() => { this.textContent = 'Copied'; setTimeout(() => this.textContent = 'Copy link', 1200); })">Copy link</button>
        <form method="POST" action="/admin/campaign-map/share" onsubmit="return confirm('Make a new link? The current one will stop working.')"><input type="hidden" name="action" value="new"><button class="cm-plain" type="submit">New link</button></form>
        <form method="POST" action="/admin/campaign-map/share" onsubmit="return confirm('Switch the link off? Anyone using it loses access.')"><input type="hidden" name="action" value="off"><button class="cm-plain" type="submit">Switch off</button></form>
      </div>
      <% } else { %>
      <p>Make a private link that lets anyone who has it view the board, without signing in.</p>
      <form method="POST" action="/admin/campaign-map/share"><input type="hidden" name="action" value="new"><button class="cm-upbtn" type="submit">Make a share link</button></form>
      <% } %>
    </details>
    <% } %>
    <div id="cm-info"><h1><%= pub ? 'The Great War' : 'Campaign map' %></h1><p>Loading the <%= pub ? 'map' : 'board' %>&hellip;</p></div>
  </aside>
</main>

<script>
'use strict';
(function () {
  const NS = 'http://www.w3.org/2000/svg';
  const PUB = <%= pub ? 'true' : 'false' %>;
  const W_T = PUB ? 'node' : 'territory', W_TS = PUB ? 'nodes' : 'territories', W_C = PUB ? 'theatre' : 'continent', W_CS = PUB ? 'theatres' : 'continents';
  const cap = s => s.charAt(0).toUpperCase() + s.slice(1);
  const $ = id => document.getElementById(id);
  const stage = $('cm-stage'), svg = $('cm-board'), world = $('cm-world');
  const el = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.appendChild(e); return e; };
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const ringsPath = poly => poly.map(r => 'M' + r.map(p => p[0] + ' ' + p[1]).join('L') + 'Z').join('');
  const fmt = n => (n < 0 ? '−' : '') + Math.abs(Math.round(n)).toLocaleString('en-GB');
  // light fills get dark numbers on their tokens, dark fills white
  const shade = (hex, f) => '#' + [0, 2, 4].map(i => Math.round(parseInt(hex.replace('#', '').substr(i, 2), 16) * (1 - f)).toString(16).padStart(2, '0')).join('');
  const lifts = [];
  const lum = hex => { const h = hex.replace('#', ''); const v = [0, 2, 4].map(i => parseInt(h.substr(i, 2), 16) / 255); return .2126 * v[0] + .7152 * v[1] + .0722 * v[2]; };

  const KIND = { land: 'Land border', sea: 'Sea route', pass: 'Mountain pass', road: 'Desert road', desert_road: 'Desert road' };
  const kindName = t => KIND[t] || (t.charAt(0).toUpperCase() + t.slice(1).replace(/_/g, ' '));
  const TERRAIN_FILL = { arctic: ['#e4ecf1', 'cm-ice'], desert: ['#cdbf98', 'cm-dunes'], mountain: ['#8a8c86', 'cm-peaks'],
    neutral: ['#a3a49e', 'cm-hatch'], rough: [null, 'cm-rough'], marsh: [null, 'cm-marsh'] };
  const overlayTerrain = t => !TERRAIN_FILL[t] || TERRAIN_FILL[t][0] === null;   // drawn over territories, not in place of them

  let M, T = {}, NAT = {}, CON = {}, ADJ = {}, terrains = [], selected = null, focusContinent = null;
<% if (!pub) { %>  // each token's live value (players present, capture progress...): empty until something feeds it, through
  // window.campaignBoard.setValues({ territoryId: value }); a value in the map file (territory.value) is the start
<% } %>  const VAL = {};
  // the code on a nation's tokens: its own code if the map gives one, else its id in capitals; unclaimed is blank
  const natCode = id => id === 'none' || !NAT[id] ? '' : String(NAT[id].code || id).toUpperCase();
  const layers = { tokens: true, routes: true, terrain: true, names: false, grid: false };
  const view = { s: 1, tx: 0, ty: 0 }, home = { s: 1, tx: 0, ty: 0 };
  let W = 0, H = 0;

  /* ------------------------------------------------------------------ geometry helpers */
  function bboxOf(polys) {
    let x0 = Infinity, z0 = Infinity, x1 = -Infinity, z1 = -Infinity;
    for (const p of polys) for (const q of p[0]) { x0 = Math.min(x0, q[0]); z0 = Math.min(z0, q[1]); x1 = Math.max(x1, q[0]); z1 = Math.max(z1, q[1]); }
    return [x0, z0, x1, z1];
  }
  function inRing(x, z, r) {
    let inside = false;
    for (let i = 0, j = r.length - 1; i < r.length; j = i++) {
      const [xi, zi] = r[i], [xj, zj] = r[j];
      if ((zi > z) !== (zj > z) && x < (xj - xi) * (z - zi) / (zj - zi) + xi) inside = !inside;
    }
    return inside;
  }
  const inPolys = (x, z, polys, box) => (!box || (x >= box[0] && x <= box[2] && z >= box[1] && z <= box[3])) &&
    polys.some(p => inRing(x, z, p[0]) && !p.slice(1).some(h => inRing(x, z, h)));
  const ringArea = r => { let a = 0; for (let i = 0, j = r.length - 1; i < r.length; j = i++) a += (r[j][0] + r[i][0]) * (r[j][1] - r[i][1]); return Math.abs(a / 2); };
  const area = polys => polys.reduce((s, p) => s + ringArea(p[0]) - p.slice(1).reduce((h, r) => h + ringArea(r), 0), 0);

  /* ------------------------------------------------------------------ build the board */
  function build() {
    M.nations.forEach(n => NAT[n.id] = n);
    M.continents.forEach(c => CON[c.id] = c);
    M.territories.forEach(t => { <% if (!pub) { %>if (t.value != null) VAL[t.id] = t.value; <% } %>T[t.id] = Object.assign({}, t, { box: bboxOf(t.polygons), d: t.polygons.map(ringsPath).join('') }); ADJ[t.id] = []; });
    const passBy = {};
    (M.passes || []).forEach(p => { if (p.connects) passBy[[...p.connects].sort().join('|')] = p; });
    const seen = new Set();
    [...(M.connections || []), ...(M.borders || [])].forEach(c => {
      const key = [c.a, c.b].sort().join('|');
      if (seen.has(key) || !T[c.a] || !T[c.b]) return;
      seen.add(key);
      const link = { type: c.type || 'land', pass: passBy[key] || null };
      ADJ[c.a].push(Object.assign({ id: c.b }, link)); ADJ[c.b].push(Object.assign({ id: c.a }, link));
    });
    terrains = (M.terrain || []).map(t => Object.assign({}, t, { box: bboxOf(t.polygons) }));

    // the board stands up off the sea: every piece of land has a side wall and a shadow under it, and these
    // are shifted by a fixed number of screen pixels in paint(), so the relief reads the same at every zoom
    const landD = (M.land || []).map(ringsPath).join(''), surD = (M.surround || []).map(ringsPath).join('');
    const coast = $('L-coast');
    const U = (M.meta.bounds[2] - M.meta.bounds[0]) / 11500;          // world units a block (the public map is scaled)
    [[110, 'rgba(150,205,240,.07)'], [55, 'rgba(150,205,240,.10)'], [22, 'rgba(170,215,245,.16)']].forEach(([w, c]) =>
      el('path', { d: landD + surD, class: 'coast-halo', stroke: c, 'stroke-width': w * U }, coast));
    if (surD) el('path', { d: surD, class: 'surround', 'fill-rule': 'evenodd' }, $('L-surround'));
    const land = $('L-land'), shadow = $('L-shadow');
    const lift = (g, d, fill) => { const p = el('path', { d, fill, 'fill-rule': 'evenodd', class: 'lift' }, g); lifts.push(p); return p; };
    lift(land, landD, 'rgba(0,0,0,.45)').dataset.k = '2';
    lift(land, landD, '#5c5e5a').dataset.k = '1';
    el('path', { d: landD, class: 'land', 'fill-rule': 'evenodd' }, land);

    const terr = $('L-terr'), rim = $('L-rim'), sheen = $('L-sheen'), edge = $('L-edge'), defs = svg.querySelector('defs');
    Object.values(T).forEach(t => {
      const col = (NAT[t.owner] || {}).color || '#ccc';
      lift(shadow, t.d, 'rgba(0,0,0,.4)').dataset.k = '2';
      t.wall = lift(shadow, t.d, shade(col, .42)); t.wall.dataset.k = '1';
      t.shape = el('path', { d: t.d, class: 't-shape', 'fill-rule': 'evenodd', fill: col, 'data-id': t.id }, terr);
      const cp = el('clipPath', { id: 'cp-' + t.id }, defs); el('path', { d: t.d, 'fill-rule': 'evenodd' }, cp);
      el('path', { d: t.d, class: 't-rim', 'clip-path': 'url(#cp-' + t.id + ')' }, rim);
      el('path', { d: t.d, class: 't-sheen', 'fill-rule': 'evenodd' }, sheen);
      if (!M.edges) el('path', { d: t.d, class: 't-edge' }, edge);
    });
    // borders: thin between a nation's own nodes, heavy where nations meet, firm along the coast
    if (M.edges) {
      const kind = e => !e.b || !T[e.b] ? 'e-coast' : T[e.a].owner === T[e.b].owner ? 'e-inner' : 'e-nation';
      const by = { 'e-inner': [], 'e-coast': [], 'e-nation': [] };
      M.edges.forEach(e => { if (T[e.a] && e.line.length > 1) by[kind(e)].push('M' + e.line.map(p => p[0] + ' ' + p[1]).join('L')); });
      Object.keys(by).forEach(k => el('path', { d: by[k].join(''), class: k }, edge));
    }
    if (M.relief && M.relief.image) {
      const [a, b, c, d] = M.relief.bounds;
      el('image', { href: M.relief.image, x: a, y: b, width: c - a, height: d - b, preserveAspectRatio: 'none', class: 'relief', opacity: .9 }, $('L-relief'));
    }
    // rivers: big ones always, smaller ones as you zoom in
    const rg = { 1: el('g', {}, $('L-rivers')), 2: el('g', { 'data-zoom': '1.8' }, $('L-rivers')), 3: el('g', { 'data-zoom': '3.2' }, $('L-rivers')) };
    (M.rivers || []).forEach(r => {
      const tier = r.r <= 5 ? 1 : r.r <= 7 ? 2 : 3;
      el('path', { d: 'M' + r.line.map(p => p[0] + ' ' + p[1]).join('L'), class: 'river', 'stroke-width': [0, 1.9, 1.3, .9][tier] }, rg[tier]);
    });
    // beyond the playable square: the land carries on, under a veil
    if (surD) {
      const [b0, b1, b2, b3] = M.meta.bounds, E = 1e5;
      el('path', { d: `M${-E} ${-E}H${E}V${E}H${-E}Z M${b0} ${b1}V${b3}H${b2}V${b1}Z`, class: 'veil', 'fill-rule': 'evenodd' }, $('L-veil'));
      el('rect', { x: b0, y: b1, width: b2 - b0, height: b3 - b1, class: 'frame-line' }, $('L-veil'));
    }

    const tg = $('L-terrain');
    terrains.forEach(t => {
      const [fill, pat] = TERRAIN_FILL[t.type] || ['#9a9b96', 'cm-hatch'];
      const d = t.polygons.map(ringsPath).join('');
      if (fill) el('path', { d, class: 'ter', fill, 'fill-rule': 'evenodd' }, tg);
      el('path', { d, fill: 'url(#' + pat + ')', 'fill-rule': 'evenodd', stroke: fill ? 'none' : 'rgba(0,0,0,.35)', 'stroke-width': '1.2px', 'vector-effect': 'non-scaling-stroke', 'stroke-dasharray': fill ? '' : '4 4' }, tg);
    });

<% if (!pub) { %>    // 500-block grid (lines in the world, numbers along the screen edges)
    const gg = $('L-grid'), [b0, b1, b2, b3] = M.meta.bounds;
    if (!PUB) for (let v = Math.ceil(b0 / 500) * 500; v <= b2; v += 500) el('line', { x1: v, y1: b1, x2: v, y2: b3, class: v === 0 ? 'grid-axis' : 'grid-line' }, gg);
    if (!PUB) for (let v = Math.ceil(b1 / 500) * 500; v <= b3; v += 500) el('line', { x1: b0, y1: v, x2: b2, y2: v, class: v === 0 ? 'grid-axis' : 'grid-line' }, gg);
<% } %>
    drawGlow();
    legend();
    resize(true);
    info();
  }

  // a continent held whole by one nation glows in the continent's colour
  function heldBy(c) {
    const owners = new Set(c.territories.filter(id => T[id]).map(id => T[id].owner));
    return owners.size === 1 ? [...owners][0] : null;
  }
  function drawGlow() {
    const g = $('L-glow'); g.textContent = '';
    if (PUB) return;
    M.continents.forEach(c => {
      const o = heldBy(c);
      if (!o || o === 'none') return;
      c.territories.forEach(id => {
        if (!T[id]) return;
        el('path', { d: T[id].d, class: 'glow-wide', stroke: c.color }, g);
        el('path', { d: T[id].d, class: 'glow-thin', stroke: c.color }, g);
      });
    });
  }

  /* ------------------------------------------------------------------ view (pan and zoom) */
  const toScreen = (x, z) => [x * view.s + view.tx, z * view.s + view.ty];
  const toWorld = (X, Y) => [(X - view.tx) / view.s, (Y - view.ty) / view.s];
  function resize(fit) {
    const r = stage.getBoundingClientRect(); W = r.width; H = r.height;
    const sea = $('cm-sea'); sea.setAttribute('width', W); sea.setAttribute('height', H);
    // fit the playable board (territories and land), not the whole 7000-block square
    const all = [...M.territories.flatMap(t => t.polygons), ...(M.land || [])];
    const [x0, z0, x1, z1] = bboxOf(all), pad = 40;
    home.s = Math.min((W - pad * 2) / (x1 - x0), (H - pad * 2) / (z1 - z0));
    home.tx = W / 2 - (x0 + x1) / 2 * home.s; home.ty = H / 2 - (z0 + z1) / 2 * home.s;
    if (fit) Object.assign(view, home);
    draw();
  }
  function zoomAt(f, X, Y) {
    const s = Math.max(home.s * .6, Math.min(home.s * 16, view.s * f));
    const [x, z] = toWorld(X, Y);
    view.s = s; view.tx = X - x * s; view.ty = Y - z * s;
    draw();
  }
  let raf = 0;
  function draw() { if (!raf) raf = requestAnimationFrame(() => { raf = 0; paint(); }); }
  function paint() {
    world.setAttribute('transform', `matrix(${view.s} 0 0 ${view.s} ${view.tx} ${view.ty})`);
    const zoom = view.s / home.s;
    const wall = (4 + 2.2 * Math.log2(Math.max(1, zoom))) / view.s;
    lifts.forEach(p => p.setAttribute('transform', `translate(0 ${p.dataset.k === '2' ? wall * 2.1 : wall})`));
    $('L-rivers').querySelectorAll('g[data-zoom]').forEach(g => { g.style.display = zoom >= +g.dataset.zoom ? '' : 'none'; });
    $('L-terrain').style.display = layers.terrain ? '' : 'none';
    $('L-grid').style.display = layers.grid ? '' : 'none';
    hudGrid(); hudRoutes(); hudMarks(zoom); hudLabels(zoom); hudTokens(zoom);
  }

  /* ------------------------------------------------------------------ screen-space layers */
  function hudGrid() {
<% if (!pub) { %>    const g = $('H-grid'); g.textContent = '';
    if (!layers.grid) return;
    const [b0, b1, b2, b3] = M.meta.bounds, step = view.s * 500 < 46 ? 1000 : 500;
    let [x0, z0] = toWorld(0, 0), [x1, z1] = toWorld(W, H);
    x0 = Math.max(x0, b0); z0 = Math.max(z0, b1); x1 = Math.min(x1, b2); z1 = Math.min(z1, b3);
    for (let v = Math.ceil(x0 / step) * step; v <= x1; v += step) { const [X] = toScreen(v, 0); el('text', { x: X + 3, y: 62, class: 'grid-lbl' }, g).textContent = 'x ' + fmt(v); }
    for (let v = Math.ceil(z0 / step) * step; v <= z1; v += step) { const [, Y] = toScreen(0, v); el('text', { x: 4, y: Y - 3, class: 'grid-lbl' }, g).textContent = 'z ' + fmt(v); }
<% } %>  }
  function hudRoutes() {
    const g = $('H-routes'); g.textContent = '';
    if (!layers.routes) return;
    const done = new Set();
    Object.keys(ADJ).forEach(a => ADJ[a].forEach(n => {
      if (n.type === 'land') return;
      const key = [a, n.id].sort().join('|'); if (done.has(key)) return; done.add(key);
      const lit = selected && (a === selected || n.id === selected);
      const cls = (n.type === 'sea' ? 'route-sea' : 'route-other') + (lit ? ' route-lit' : '');
      const A = toScreen(...T[a].label), B = toScreen(...T[n.id].label);
      if (n.pass && n.pass.pos) {           // a pass route bends through the pass itself
        const P = toScreen(...n.pass.pos);
        el('polyline', { points: [A, P, B].map(p => p.join(',')).join(' '), class: cls }, g);
      } else el('line', { x1: A[0], y1: A[1], x2: B[0], y2: B[1], class: cls }, g);
      [A, B].forEach(p => el('circle', { cx: p[0], cy: p[1], r: lit ? 5 : 4, class: 'route-end' + (n.type === 'sea' ? '' : ' other') }, g));
    }));
  }
  function star(cx, cy, r) {
    const pts = []; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * .45 : r; pts.push((cx + Math.cos(a) * rr).toFixed(1) + ',' + (cy + Math.sin(a) * rr).toFixed(1)); }
    return pts.join(' ');
  }
  function hudMarks(zoom) {
    const g = $('H-marks'); g.textContent = '';
    const named = zoom >= 2.2 || layers.names;
    (M.capitals || []).forEach(c => {
      const [X, Y] = toScreen(...c.pos);
      el('polygon', { points: star(X, Y, 9), fill: '#ffd666', stroke: '#0c0e11', 'stroke-width': 1.6 }, g);
      if (named) el('text', { x: X + 11, y: Y + 4, class: 'lbl-mark' }, g).textContent = c.name;
    });
<% if (!pub) { %>    (M.chokepoints || []).forEach(c => {
      const [X, Y] = toScreen(...c.pos);
      el('rect', { x: X - 5, y: Y - 5, width: 10, height: 10, transform: `rotate(45 ${X} ${Y})`, fill: '#ff7a59', stroke: '#0c0e11', 'stroke-width': 1.6 }, g);
      if (named) el('text', { x: X + 9, y: Y + 4, class: 'lbl-mark' }, g).textContent = c.name;
    });
<% } %>    (M.passes || []).forEach(c => {
      const [X, Y] = toScreen(...c.pos);
      el('path', { d: `M${X - 7} ${Y + 4} L${X} ${Y - 5} L${X + 7} ${Y + 4}`, fill: 'none', stroke: '#0c0e11', 'stroke-width': 5, 'stroke-linejoin': 'round' }, g);
      el('path', { d: `M${X - 7} ${Y + 4} L${X} ${Y - 5} L${X + 7} ${Y + 4}`, fill: 'none', stroke: '#ffc94d', 'stroke-width': 2.4, 'stroke-linejoin': 'round' }, g);
      if (named) el('text', { x: X + 10, y: Y + 4, class: 'lbl-mark' }, g).textContent = c.name;
    });
  }
  // on a narrow public screen tokens start as small dots and grow into lettered markers as you zoom in
  const compact = () => PUB && W < 600;
  const tokenR = zoom => compact() ? Math.max(5.5, Math.min(17, 4 + zoom * 2.2)) : Math.max(11, Math.min(19, 11 + (zoom - 1) * 2.4));
  function hudLabels(zoom) {
    const g = $('H-labels'); g.textContent = '';
    const all = zoom >= 2.2 || layers.names, size = Math.max(11, Math.min(16, 10 + zoom * 1.3)), off = layers.tokens ? tokenR(zoom) + size * .9 : 0;
    const lit = selected ? new Set([selected, ...ADJ[selected].map(n => n.id)]) : null;
    Object.values(T).forEach(t => {
      if (!all && !(lit && lit.has(t.id))) return;
      const [X, Y] = toScreen(...t.label);
      if (X < -100 || X > W + 100 || Y < -40 || Y > H + 40) return;
      el('text', { x: X, y: Y + off, class: 'lbl', 'font-size': size }, g).textContent = t.name;
    });
  }
  function hudTokens(zoom) {
    const g = $('H-tokens'); g.textContent = '';
    if (!layers.tokens) return;
    const r = tokenR(zoom);
    Object.values(T).forEach(t => {
      const [X, Y] = toScreen(...t.label);
      if (X < -30 || X > W + 30 || Y < -30 || Y > H + 30) return;
      const col = (NAT[t.owner] || {}).color || '#ccc', dark = lum(col) > .6;
      const tok = el('g', { class: 'tok', 'data-territory': t.id<% if (!pub) { %>, 'data-value': VAL[t.id] == null ? '' : VAL[t.id]<% } %> }, g);
      el('ellipse', { cx: X, cy: Y + 2.5, rx: r, ry: r, fill: 'rgba(0,0,0,.55)' }, tok);
      el('circle', { cx: X, cy: Y, r, fill: col, class: 'tok-ring' }, tok);
      if (r >= 14) el('circle', { cx: X, cy: Y, r: r - 3, class: 'tok-inner', stroke: dark ? 'rgba(0,0,0,.35)' : 'rgba(255,255,255,.75)' }, tok);
      const code = natCode(t.owner);
      if (code && r >= 9.5) el('text', { x: X, y: Y + 1, class: 'tok-num', 'font-size': r * (code.length > 2 ? .72 : .95), fill: dark ? '#14161b' : '#fff' }, tok).textContent = code;
<% if (!pub) { %>      // the value badge, top right of the token, hidden while there's no value
      const v = VAL[t.id] == null ? '' : String(VAL[t.id]), bw = Math.max(r * 1.1, v.length * r * .62 + 8), bh = r * .95;
      const badge = el('g', { class: 'tok-val', display: v ? '' : 'none' }, tok);
      el('rect', { x: X + r * .55, y: Y - r * 1.25, width: bw, height: bh, rx: bh / 2 }, badge);
      el('text', { x: X + r * .55 + bw / 2, y: Y - r * 1.25 + bh / 2 + .5, 'font-size': bh * .78 }, badge).textContent = v;
<% } %>    });
  }

  /* ------------------------------------------------------------------ selection and the side panel */
  function territoryAt(x, z) { return Object.values(T).find(t => inPolys(x, z, t.polygons, t.box)) || null; }
  function terrainsAt(x, z) { return terrains.filter(t => inPolys(x, z, t.polygons, t.box)); }
  const onLand = (x, z) => (M.land || []).some(p => inPolys(x, z, [p]));

  function select(id) {
    selected = id; focusContinent = null;
    const sel = $('L-sel'); sel.textContent = '';
    document.querySelectorAll('.lg-row.on').forEach(r => r.classList.remove('on'));
    Object.values(T).forEach(t => t.shape.classList.remove('lit'));
    world.classList.toggle('dim', !!id);
    if (id) {
      T[id].shape.classList.add('lit');
      ADJ[id].forEach(n => { T[n.id].shape.classList.add('lit'); el('path', { d: T[n.id].d, class: 'nb-outline' }, sel); });
      el('path', { d: T[id].d, class: 'sel-outline' }, sel);
    }
    draw();
  }
  function showContinent(cid) {
    select(null);
    focusContinent = cid;
    const c = CON[cid], sel = $('L-sel');
    world.classList.add('dim');
    c.territories.forEach(id => { if (!T[id]) return; T[id].shape.classList.add('lit'); el('path', { d: T[id].d, class: 'nb-outline' }, sel); });
    document.querySelectorAll('.lg-row[data-c]').forEach(r => r.classList.toggle('on', r.dataset.c === cid));
    const o = heldBy(c);
    info(<% if (pub) { %>`<h1>${esc(c.name)}</h1>
      <span class="cm-badge"><span class="lg-sw" style="background:${esc(c.color)}"></span>Theatre of ${c.territories.length} nodes</span>
      ${o && o !== 'none' ? `<p>Held whole by <b>${esc(NAT[o].name)}</b>.</p>` : ''}
      <h3>Nodes</h3>${c.territories.filter(id => T[id]).map(id => nbRow(id, (NAT[T[id].owner] || {}).name || '')).join('')}`<% } else { %>`<h1>${esc(c.name)}</h1>
      <span class="cm-badge gold"><span class="lg-sw" style="background:${esc(c.color)}"></span>+${c.bonus} bonus for holding all ${c.territories.length}</span>
      ${o && o !== 'none' ? `<p>Held whole by <b>${esc(NAT[o].name)}</b>: it collects the bonus.</p>` : '<p>Not held whole by anyone.</p>'}
      <h3>Territories</h3>${c.territories.filter(id => T[id]).map(id => nbRow(id, (NAT[T[id].owner] || {}).name || '')).join('')}`<% } %>);
  }
  const nbRow = (id, kind, cls) => `<button class="nb" data-go="${esc(id)}"><span class="lg-sw" style="background:${esc((NAT[T[id].owner] || {}).color || '#ccc')}"></span><span class="n">${esc(T[id].name)}</span><span class="k ${cls || ''}">${esc(kind)}</span></button>`;

  function territoryInfo(t, at) {
    const c = CON[t.continent] || { name: t.continent, territories: [] }, n = NAT[t.owner] || { name: t.owner, color: '#ccc' };
    const held = c.territories.length && heldBy(c);
    const caps = (M.capitals || []).filter(x => x.territory === t.id);
    const here = at ? terrainsAt(...at).filter(x => overlayTerrain(x.type)) : [];
    const order = { land: 0, pass: 1, road: 2, desert_road: 2, sea: 3 };
    const nbs = [...ADJ[t.id]].sort((a, b) => (order[a.type] ?? 2) - (order[b.type] ?? 2) || T[a.id].name.localeCompare(T[b.id].name));
    const [x0, z0, x1, z1] = t.box;
    return `<h1>${esc(t.name)}</h1>
      <span class="cm-badge"><span class="lg-sw" style="background:${esc(c.color || '#888')}"></span>${esc(c.name)}</span>
<% if (!pub) { %><span class="cm-badge gold">+${c.bonus} continent bonus</span><% } %>
      ${held && held !== 'none' ? `<p>${esc(c.name)} is held whole by ${esc((NAT[held] || {}).name || held)}.</p>` : ''}
      <h3>Owner</h3>
      <span class="cm-badge"><span class="lg-sw" style="background:${esc(n.color)}"></span>${esc(n.name)}</span>
      ${caps.map(x => `<span class="cm-badge gold">&#9733; ${esc(x.name)}, capital</span>`).join('')}
      ${here.map(x => `<h3>${esc(x.label)}</h3><div class="rule">${esc(x.rule)}</div>`).join('')}
      <h3>Neighbours (${nbs.length})</h3>
      ${nbs.map(x => nbRow(x.id, x.pass ? x.pass.name : kindName(x.type), x.type === 'sea' ? 'sea' : x.type === 'land' ? '' : 'pass')).join('') || `<p>None: this ${W_T} can’t be reached.</p>`}
      <% if (!pub) { %><h3>Block coordinates</h3>
      <dl class="facts">
        <dt>Token</dt><dd><span class="copy" data-copy="${t.label[0]} ${t.label[1]}">x ${fmt(t.label[0])}, z ${fmt(t.label[1])}</span></dd>
        ${at ? `<dt>Tapped</dt><dd><span class="copy" data-copy="${Math.round(at[0])} ${Math.round(at[1])}">x ${fmt(at[0])}, z ${fmt(at[1])}</span></dd>` : ''}
        <dt>West to east</dt><dd>x ${fmt(x0)} to ${fmt(x1)}</dd>
        <dt>North to south</dt><dd>z ${fmt(z0)} to ${fmt(z1)}</dd>
        <dt>Area</dt><dd>${fmt(area(t.polygons))} blocks&sup2;</dd>
      </dl><% } %>`;
  }
  function info(html) {
    if (!html && PUB) {
      $('cm-info').innerHTML = `<h1>The Great War</h1>
        <p>Europe in August 1914: ${M.territories.length} nodes across ${M.continents.length} theatres, held by ${M.nations.filter(n => n.id !== 'none').length} nations. Every node gives its owner income and resources; take more and your nation grows stronger.</p>
        <p>Tap a node to see who holds it and what borders it. Drag to move, scroll or pinch to zoom.</p>
        <h3>Nations</h3>${M.nations.filter(n => n.id !== 'none').map(n => `<span class="cm-badge"><span class="lg-sw" style="background:${esc(n.color)}"></span>${esc(n.name)}</span>`).join('')}`;
      return;
    }
<% if (!pub) { %>    $('cm-info').innerHTML = html || `<h1>${esc(M.meta.name)}</h1>
      <p>${M.territories.length} territories in ${M.continents.length} continents, ${M.nations.filter(n => n.id !== 'none').length} nations.
      Tap a territory to see its neighbours; tap grey land for its rule.</p>
      <p>Drag to pan, scroll or pinch to zoom. Hover (or press and hold) to read block coordinates.</p>
      <h3>Map</h3><dl class="facts"><dt>Coordinates</dt><dd>Minecraft blocks, x east, z south</dd><dt>Size</dt><dd>${fmt(M.meta.size)} &times; ${fmt(M.meta.size)}</dd></dl>`;
<% } else { %>    $('cm-info').innerHTML = html;
<% } %>  }
  $('cm-info').addEventListener('click', e => {
    const go = e.target.closest('[data-go]');
    if (go) { select(go.dataset.go); info(territoryInfo(T[go.dataset.go])); return; }
    const cp = e.target.closest('[data-copy]');
    if (cp && navigator.clipboard) navigator.clipboard.writeText(cp.dataset.copy).then(() => { const o = cp.textContent; cp.textContent = 'Copied'; setTimeout(() => cp.textContent = o, 900); }).catch(() => {});
  });

  function tapAt(X, Y) {
    const [x, z] = toWorld(X, Y), t = territoryAt(x, z);
    const blocking = terrainsAt(x, z).filter(r => !overlayTerrain(r.type));
    if (blocking.length && !t) {
      select(null);
      info(blocking.map(r => `<h1>${esc(r.label)}</h1><span class="cm-badge">Not playable</span><div class="rule">${esc(r.rule)}</div>`).join('') +
        (''<% if (!pub) { %> + `<h3>Block coordinates</h3><dl class="facts"><dt>Tapped</dt><dd><span class="copy" data-copy="${Math.round(x)} ${Math.round(z)}">x ${fmt(x)}, z ${fmt(z)}</span></dd></dl>`<% } %>));
    } else if (t) { select(t.id); info(territoryInfo(t, [x, z])); }
    else if (onLand(x, z)) {
      select(null);
      info(`<h1>Unplayable land</h1><span class="cm-badge">Not playable</span><div class="rule">Not part of the ${PUB ? 'map' : 'board'}: no ${W_T} here, so it can't be entered, held or crossed.</div>` +
        (''<% if (!pub) { %> + `<h3>Block coordinates</h3><dl class="facts"><dt>Tapped</dt><dd><span class="copy" data-copy="${Math.round(x)} ${Math.round(z)}">x ${fmt(x)}, z ${fmt(z)}</span></dd></dl>`<% } %>));
    } else { select(null); info(); }
  }

  /* ------------------------------------------------------------------ legend */
  function legend() {
    const count = {}; M.territories.forEach(t => count[t.owner] = (count[t.owner] || 0) + 1);
    const terrTypes = []; terrains.forEach(t => { if (!terrTypes.some(x => x.label === t.label)) terrTypes.push(t); });
    const sw = t => { const [f] = TERRAIN_FILL[t.type] || ['#9a9b96']; return f ? `background:${f}` : 'background:repeating-linear-gradient(45deg,#6b6d68 0 3px,#3a3c3a 3px 6px)'; };
    $('cm-legend-body').innerHTML = `
      <h4><% if (pub) { %>Theatres<% } else { %>Continents &middot; bonus<% } %></h4>
      ${M.continents.map(c => { const o = heldBy(c); return `<div class="lg-row btn" data-c="${esc(c.id)}"><span class="lg-sw" style="background:${esc(c.color)}"></span><span class="n">${esc(c.name)}${o && o !== 'none' ? ' <span class="c">(' + esc((NAT[o] || {}).name || o) + ')</span>' : ''}</span><% if (pub) { %><span class="c">${c.territories.length}</span><% } else { %><span class="v">+${c.bonus}</span><% } %></div>`; }).join('')}
      <h4>${PUB ? 'Nations' : 'Owners'}</h4>
      ${M.nations.filter(n => count[n.id]).map(n => `<div class="lg-row"><span class="lg-sw" style="background:${esc(n.color)}"></span><span class="n">${esc(n.name)}</span><span class="c">${count[n.id]}</span></div>`).join('')}
      <h4>Terrain</h4>
      ${terrTypes.map(t => `<div class="lg-row" title="${esc(t.rule)}"><span class="lg-sw" style="${sw(t)}"></span><span class="n">${esc(t.label)}</span><span class="c">${esc(t.rule.split('.')[0])}</span></div>`).join('')}
      <div class="lg-row"><span class="lg-sw" style="background:#8f918c"></span><span class="n">Other land</span><span class="c">Not playable</span></div>
      <h4>Markers</h4>
      <div class="lg-row"><svg width="28" height="14"><line x1="4" y1="7" x2="24" y2="7" class="route-sea"/><circle cx="4" cy="7" r="3" class="route-end"/><circle cx="24" cy="7" r="3" class="route-end"/></svg><span class="n">Sea route</span></div>
      <div class="lg-row"><svg width="28" height="14"><line x1="4" y1="7" x2="24" y2="7" class="route-other"/><circle cx="4" cy="7" r="3" class="route-end other"/><circle cx="24" cy="7" r="3" class="route-end other"/></svg><span class="n">Pass or road route</span></div>
      <div class="lg-row"><svg width="28" height="16"><polygon points="${star(14, 8, 7)}" fill="#ffd666" stroke="#0c0e11" stroke-width="1.4"/></svg><span class="n">Capital</span></div>
<% if (!pub) { %><div class="lg-row"><svg width="28" height="16"><rect x="10" y="4" width="8" height="8" transform="rotate(45 14 8)" fill="#ff7a59" stroke="#0c0e11" stroke-width="1.4"/></svg><span class="n">Chokepoint</span></div><% } %>
      <div class="lg-row"><svg width="28" height="16"><path d="M8 12 L14 4 L20 12" fill="none" stroke="#ffc94d" stroke-width="2.4"/></svg><span class="n">Pass</span></div>`;
    $('cm-legend-body').addEventListener('click', e => { const r = e.target.closest('[data-c]'); if (r) focusContinent === r.dataset.c ? (select(null), info()) : showContinent(r.dataset.c); });
  }
  try { if (localStorage.getItem('cm-legend') === '1') $('cm-legend').open = true; } catch (e) {}
  $('cm-legend').addEventListener('toggle', () => { try { localStorage.setItem('cm-legend', $('cm-legend').open ? '1' : '0'); } catch (e) {} });

  /* ------------------------------------------------------------------ input: drag, wheel, pinch, tap, hover, long-press */
  const ptrs = new Map();
  let drag = null, pinch = null, press = null;
  const local = e => { const r = stage.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
  const tip = $('cm-tip');
  function readout(X, Y, pin) {
    const [x, z] = toWorld(X, Y);
<% if (!pub) { %>    if (!PUB) $('cm-coord').innerHTML = `x <b>${fmt(x)}</b> &middot; z <b>${fmt(z)}</b>`;
<% } %>    const t = territoryAt(x, z);
    if (t) { tip.textContent = t.name; tip.style.left = X + 'px'; tip.style.top = Y + 'px'; tip.style.display = 'block'; } else tip.style.display = 'none';
    const g = $('H-cross'); g.textContent = '';
    if (pin) { el('line', { x1: X - 12, y1: Y, x2: X + 12, y2: Y, class: 'cross' }, g); el('line', { x1: X, y1: Y - 12, x2: X, y2: Y + 12, class: 'cross' }, g); }
  }
  stage.addEventListener('pointerdown', e => {
    if (e.target.closest('.cm-ctl, .cm-legend')) return;
    stage.setPointerCapture(e.pointerId);
    ptrs.set(e.pointerId, local(e));
    if (ptrs.size === 1) {
      const [X, Y] = local(e);
      drag = { X, Y, tx: view.tx, ty: view.ty, moved: false };
      if (e.pointerType !== 'mouse') press = setTimeout(() => { if (drag && !drag.moved) { drag.held = true; readout(X, Y, true); } }, 480);
    } else if (ptrs.size === 2) {
      clearTimeout(press); drag = null;
      const [a, b] = [...ptrs.values()];
      pinch = { d: Math.hypot(a[0] - b[0], a[1] - b[1]), s: view.s, mid: [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2], tx: view.tx, ty: view.ty };
    }
  });
  stage.addEventListener('pointermove', e => {
    const p = local(e);
    if (!ptrs.has(e.pointerId)) { if (e.pointerType === 'mouse') readout(...p); return; }
    ptrs.set(e.pointerId, p);
    if (pinch && ptrs.size === 2) {
      const [a, b] = [...ptrs.values()], mid = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
      const s = Math.max(home.s * .6, Math.min(home.s * 16, pinch.s * Math.hypot(a[0] - b[0], a[1] - b[1]) / pinch.d));
      const wx = (pinch.mid[0] - pinch.tx) / pinch.s, wz = (pinch.mid[1] - pinch.ty) / pinch.s;
      view.s = s; view.tx = mid[0] - wx * s; view.ty = mid[1] - wz * s; draw();
    } else if (drag) {
      if (drag.held) { readout(...p, true); return; }
      if (!drag.moved && Math.hypot(p[0] - drag.X, p[1] - drag.Y) > 6) { drag.moved = true; clearTimeout(press); stage.classList.add('dragging'); tip.style.display = 'none'; }
      if (drag.moved) { view.tx = drag.tx + p[0] - drag.X; view.ty = drag.ty + p[1] - drag.Y; draw(); }
    }
  });
  function end(e) {
    if (!ptrs.has(e.pointerId)) return;
    ptrs.delete(e.pointerId); clearTimeout(press);
    if (drag && !drag.moved && !drag.held && e.type === 'pointerup') tapAt(drag.X, drag.Y);
    if (drag && drag.held) { tip.style.display = 'none'; $('H-cross').textContent = ''; }
    if (ptrs.size < 2) pinch = null;
    if (!ptrs.size) drag = null;
    stage.classList.remove('dragging');
  }
  stage.addEventListener('pointerup', end); stage.addEventListener('pointercancel', end);
  stage.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse' && !ptrs.size) tip.style.display = 'none'; });
  stage.addEventListener('wheel', e => { if (e.target.closest('.cm-legend')) return; e.preventDefault(); zoomAt(Math.exp(-e.deltaY * (e.ctrlKey ? .01 : .0015)), ...local(e)); }, { passive: false });
  stage.addEventListener('contextmenu', e => e.preventDefault());
  $('cm-in').onclick = () => zoomAt(1.5, W / 2, H / 2);
  $('cm-out').onclick = () => zoomAt(1 / 1.5, W / 2, H / 2);
  $('cm-reset').onclick = () => { Object.assign(view, home); draw(); };
  $('cm-layers').addEventListener('click', e => {
    const b = e.target.closest('[data-layer]'); if (!b) return;
    layers[b.dataset.layer] = !layers[b.dataset.layer]; b.setAttribute('aria-pressed', layers[b.dataset.layer]); draw();
  });
  addEventListener('resize', () => { if (M) resize(false); });
  // colour the pieces by nation (owner) or by theatre; tokens keep the nation either way
  if ($('cm-colour')) $('cm-colour').onclick = e => {
    const b = e.currentTarget, mode = b.dataset.mode === 'nation' ? 'theatre' : 'nation';
    b.dataset.mode = mode; b.textContent = 'Colour: ' + mode;
    Object.values(T).forEach(t => {
      const col = mode === 'theatre' ? (CON[t.continent] || {}).color || '#ccc' : (NAT[t.owner] || {}).color || '#ccc';
      t.shape.setAttribute('fill', col); if (t.wall) t.wall.setAttribute('fill', shade(col, .42));
    });
    if (mode === 'theatre' && !compact()) $('cm-legend').open = true;
  };
<% if (!pub) { %>  if (!PUB) window.campaignBoard = {
    setValues(values) { for (const id in values) { if (values[id] == null || values[id] === '') delete VAL[id]; else VAL[id] = values[id]; } draw(); },
    clearValues() { for (const id in VAL) delete VAL[id]; draw(); },
    values: () => Object.assign({}, VAL),
  };
<% } %>  document.querySelectorAll('time[data-ts]').forEach(t => { t.textContent = new Intl.DateTimeFormat(undefined, { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(+t.dataset.ts * 1000); });

  fetch(<%- JSON.stringify(locals.dataUrl || '/admin/campaign-map/data.json') %>, { credentials: 'same-origin' })
    .then(r => r.ok ? r.json() : r.json().then(j => Promise.reject(new Error(j.error || r.status))))
    .then(m => { M = m; build(); })
    .catch(e => { stage.insertAdjacentHTML('beforeend', `<div class="cm-err">Couldn't load the map: ${esc(e.message)}</div>`); });
})();
</script>
<%- include('partials/foot') %>
