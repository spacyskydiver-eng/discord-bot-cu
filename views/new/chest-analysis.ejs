<%- include('partials/head', { pageTitle: 'Chest Analysis' }) %>
<%- include('partials/header') %>

<style>
.ca-tab {
  font-family: 'Baloo 2'; font-weight: 800; font-size: 13px;
  padding: 9px 18px; border-radius: 10px 10px 0 0; border: 1px solid transparent;
  border-bottom: none; cursor: pointer; transition: background .15s, color .15s;
  color: var(--muted); background: none; position: relative; bottom: -2px;
}
.ca-tab:hover { background: var(--panel-2); color: var(--text); }
.ca-tab.active { background: var(--panel); border-color: var(--line); color: var(--text); }

.ca-panel { display: none; }
.ca-panel.active { display: block; }

.ca-search {
  background: var(--panel-2); border: 1px solid var(--line);
  border-radius: 10px; padding: 10px 14px; font-family: 'Baloo 2'; font-weight: 600;
  font-size: 14px; color: var(--text); outline: none; transition: border-color .15s;
  box-sizing: border-box;
}
.ca-search:focus { border-color: rgba(255,255,255,.25); }
.ca-search::placeholder { color: var(--muted); }

.ca-stat {
  background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
  padding: 16px 18px;
}
.ca-stat-label { font-family: 'Baloo 2'; font-weight: 700; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; }
.ca-stat-val { font-family: 'Baloo 2'; font-weight: 800; font-size: 22px; line-height: 1; }
.ca-stat-sub { font-size: 12px; color: var(--muted); margin-top: 4px; font-family: 'Baloo 2'; }

.ca-chart-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
.ca-chart-title { font-family: 'Baloo 2'; font-weight: 800; font-size: 14px; color: var(--text); margin: 0 0 14px; }

.ca-item-row {
  display: flex; align-items: center; gap: 10px; padding: 9px 14px;
  border-bottom: 1px solid var(--line); cursor: pointer; transition: background .12s;
}
.ca-item-row:last-child { border-bottom: none; }
.ca-item-row:hover { background: var(--panel-2); }
.ca-item-row.selected { background: var(--panel-2); }
.ca-item-rank { font-family: 'Baloo 2'; font-weight: 700; font-size: 11px; color: var(--muted); min-width: 26px; text-align: right; }
.ca-item-name { font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; flex: 1; }
.ca-item-qty { font-family: 'Baloo 2'; font-weight: 800; font-size: 13px; color: var(--muted); }

.ca-chest-row {
  display: flex; align-items: center; gap: 10px; padding: 8px 0;
  border-bottom: 1px solid var(--line);
}
.ca-chest-row:last-child { border-bottom: none; }
.ca-chest-coords { font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; flex: 1; color: var(--text); }
.ca-chest-qty { font-family: 'Baloo 2'; font-weight: 800; font-size: 12px; color: var(--muted); }
.ca-copy-btn {
  font-family: 'Baloo 2'; font-weight: 700; font-size: 11px; padding: 4px 10px;
  border-radius: 6px; background: var(--panel-2); border: 1px solid var(--line);
  color: var(--muted); cursor: pointer; transition: all .15s; white-space: nowrap;
}
.ca-copy-btn:hover { background: rgba(255,255,255,.08); color: var(--text); }

.ca-no-select { text-align: center; padding: 32px 16px; color: var(--muted); font-family: 'Baloo 2'; font-weight: 600; font-size: 13px; }

.ca-island-badge {
  display: inline-block; font-family: 'Baloo 2'; font-weight: 800; font-size: 11px;
  padding: 2px 8px; border-radius: 6px; margin-right: 4px;
}

.ca-legend-item { display: flex; align-items: center; gap: 6px; font-family: 'Baloo 2'; font-weight: 700; font-size: 12px; color: var(--text); }
.ca-legend-dot { width: 10px; height: 10px; border-radius: 3px; flex-shrink: 0; }

.ca-sr-group { margin-bottom: 16px; }
.ca-sr-title { font-family: 'Baloo 2'; font-weight: 800; font-size: 13px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; margin-bottom: 8px; }
.ca-sr-row { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; margin-bottom: 4px; font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; }
.ca-sr-row:last-child { margin-bottom: 0; }
</style>

<main class="wrap" style="max-width:1400px">

  <div class="page-head" style="margin-bottom:0">
    <a href="/admin" class="back">← Admin</a>
    <div>
      <h1 class="page-title">Chest Analysis</h1>
      <p class="page-sub" style="margin:4px 0 0;color:var(--muted);font-size:13px">Staff only — loot distribution across all islands</p>
    </div>
  </div>

  <div style="border-bottom: 2px solid var(--line); margin: 20px 0 0; display:flex; gap:4px; padding-top:4px">
    <button class="ca-tab active" data-panel="overall">Overall</button>
    <button class="ca-tab" data-panel="Jungle">Jungle</button>
    <button class="ca-tab" data-panel="Plains">Plains</button>
    <button class="ca-tab" data-panel="Desert">Desert</button>
    <button class="ca-tab" data-panel="Snow">Snow</button>
  </div>

  <!-- ====== OVERALL PANEL ====== -->
  <div id="panel-overall" class="ca-panel active" style="padding-top:20px">

    <input id="global-search" type="text" class="ca-search" placeholder="Search items across all islands..." style="width:100%;margin-bottom:20px">

    <div id="global-results" style="display:none;margin-bottom:20px">
      <!-- populated by JS -->
    </div>

    <div id="overall-stats-row" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px">
      <!-- populated by JS -->
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div class="ca-chart-card">
        <div class="ca-chart-title">Top 25 Items — All Islands</div>
        <div style="position:relative;height:580px">
          <canvas id="chart-top25"></canvas>
        </div>
      </div>
      <div class="ca-chart-card">
        <div class="ca-chart-title">Top 15 Items by Island</div>
        <div id="chart-legend" style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px"></div>
        <div style="position:relative;height:580px">
          <canvas id="chart-stacked"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- ====== ISLAND PANELS ====== -->
  <% for (const islName of ['Jungle', 'Plains', 'Desert', 'Snow']) { %>
  <div id="panel-<%= islName %>" class="ca-panel" style="padding-top:20px">
    <div id="stats-<%= islName %>" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:start">
      <div>
        <input type="text" id="search-<%= islName %>" class="ca-search" placeholder="Search items..." style="width:100%;margin-bottom:10px">
        <div id="list-<%= islName %>" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;max-height:600px;overflow-y:auto">
          <div style="padding:24px;color:var(--muted);text-align:center;font-family:'Baloo 2';font-size:13px">Loading...</div>
        </div>
      </div>
      <div id="chests-<%= islName %>" style="background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:16px;position:sticky;top:80px;max-height:640px;overflow-y:auto">
        <div class="ca-no-select">Select an item to see chest locations</div>
      </div>
    </div>
  </div>
  <% } %>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
(function () {
  const DATA = <%- JSON.stringify(chestData) %>;
  const ISLANDS = ['Jungle', 'Plains', 'Desert', 'Snow'];
  const ICOLOR = { Jungle: '#16a34a', Plains: '#8b5cf6', Desert: '#ea580c', Snow: '#3b82f6' };
  const IBGALPHA = { Jungle: 'rgba(22,163,74,.15)', Plains: 'rgba(139,92,246,.15)', Desert: 'rgba(234,88,12,.15)', Snow: 'rgba(59,130,246,.15)' };

  // ---- compute overall item totals ----
  const allItems = {};
  for (const isl of ISLANDS) {
    for (const [item, d] of Object.entries(DATA[isl].items)) {
      allItems[item] = (allItems[item] || 0) + d.total;
    }
  }
  const sortedAll = Object.entries(allItems).sort((a, b) => b[1] - a[1]);

  // ---- tab switching ----
  document.querySelectorAll('.ca-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ca-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.ca-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('panel-' + btn.dataset.panel).classList.add('active');
    });
  });

  // ---- overall stat tiles ----
  const statsRow = document.getElementById('overall-stats-row');
  for (const isl of ISLANDS) {
    const d = DATA[isl];
    const totalQty = Object.values(d.items).reduce((s, v) => s + v.total, 0);
    const fillPct = d.total_chests ? Math.round((d.non_empty / d.total_chests) * 100) : 0;
    const tile = document.createElement('div');
    tile.className = 'ca-stat';
    tile.style.borderTopColor = ICOLOR[isl];
    tile.style.borderTopWidth = '3px';
    tile.innerHTML = `
      <div class="ca-stat-label">${isl}</div>
      <div class="ca-stat-val" style="color:${ICOLOR[isl]}">${d.total_chests}</div>
      <div class="ca-stat-sub">chests &nbsp;·&nbsp; ${fillPct}% filled</div>
      <div class="ca-stat-sub" style="margin-top:4px">${Object.keys(d.items).length} items &nbsp;·&nbsp; ${totalQty.toLocaleString()} total loot</div>
    `;
    statsRow.appendChild(tile);
  }

  // ---- global search ----
  const globalSearch = document.getElementById('global-search');
  const globalResults = document.getElementById('global-results');
  const overallStatsRow = document.getElementById('overall-stats-row');
  const chartSection = document.querySelector('#panel-overall > div:last-child');

  globalSearch.addEventListener('input', () => {
    const q = globalSearch.value.trim().toLowerCase();
    if (!q) {
      globalResults.style.display = 'none';
      globalResults.innerHTML = '';
      overallStatsRow.style.display = '';
      chartSection.style.display = '';
      return;
    }
    overallStatsRow.style.display = 'none';
    chartSection.style.display = 'none';
    globalResults.style.display = 'block';

    let html = '';
    let anyResults = false;
    for (const isl of ISLANDS) {
      const matches = Object.entries(DATA[isl].items)
        .filter(([name]) => name.toLowerCase().includes(q))
        .sort((a, b) => b[1].total - a[1].total);
      if (!matches.length) continue;
      anyResults = true;
      html += `<div class="ca-sr-group">
        <div class="ca-sr-title" style="color:${ICOLOR[isl]}">${isl} — ${matches.length} result${matches.length !== 1 ? 's' : ''}</div>`;
      for (const [name, d] of matches) {
        const chestCount = groupChests(d.chests).length;
        html += `<div class="ca-sr-row">
          <span>${name}</span>
          <span style="color:var(--muted)">${d.total.toLocaleString()} qty &nbsp; ${chestCount} chest${chestCount !== 1 ? 's' : ''}</span>
        </div>`;
      }
      html += '</div>';
    }
    if (!anyResults) {
      html = `<div style="color:var(--muted);font-family:'Baloo 2';font-size:14px;padding:20px 0">No items found for "<strong>${esc(q)}</strong>"</div>`;
    }
    globalResults.innerHTML = html;
  });

  // ---- Chart.js charts ----
  Chart.defaults.font.family = 'Baloo 2';
  Chart.defaults.color = '#8b8f99';

  const gridColor = 'rgba(255,255,255,0.05)';

  // Chart 1: top 25 single series horizontal bar
  const top25 = sortedAll.slice(0, 25);
  new Chart(document.getElementById('chart-top25').getContext('2d'), {
    type: 'bar',
    data: {
      labels: top25.map(([k]) => k),
      datasets: [{
        data: top25.map(([, v]) => v),
        backgroundColor: '#4dabf7',
        borderRadius: 4,
        borderSkipped: false
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `  ${ctx.parsed.x.toLocaleString()} total`
          }
        }
      },
      scales: {
        x: {
          grid: { color: gridColor },
          border: { display: false },
          ticks: { color: '#8b8f99', font: { size: 11 } }
        },
        y: {
          grid: { display: false },
          border: { display: false },
          ticks: { color: '#e9eaee', font: { size: 12 } }
        }
      }
    }
  });

  // Chart 2: top 15 stacked by island
  const top15names = sortedAll.slice(0, 15).map(([k]) => k);
  const legendEl = document.getElementById('chart-legend');
  const chart2Datasets = ISLANDS.map(isl => {
    const dot = document.createElement('div');
    dot.className = 'ca-legend-item';
    dot.innerHTML = `<div class="ca-legend-dot" style="background:${ICOLOR[isl]}"></div>${isl}`;
    legendEl.appendChild(dot);
    return {
      label: isl,
      data: top15names.map(item => DATA[isl].items[item]?.total || 0),
      backgroundColor: ICOLOR[isl],
      borderRadius: 3,
      borderSkipped: false
    };
  });

  new Chart(document.getElementById('chart-stacked').getContext('2d'), {
    type: 'bar',
    data: { labels: top15names, datasets: chart2Datasets },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => `  ${ctx.dataset.label}: ${ctx.parsed.x.toLocaleString()}`
          }
        }
      },
      scales: {
        x: {
          stacked: true,
          grid: { color: gridColor },
          border: { display: false },
          ticks: { color: '#8b8f99', font: { size: 11 } }
        },
        y: {
          stacked: true,
          grid: { display: false },
          border: { display: false },
          ticks: { color: '#e9eaee', font: { size: 12 } }
        }
      }
    }
  });

  // ---- island tabs ----
  function groupChests(chestArr) {
    const byIdx = {};
    for (const c of chestArr) {
      if (!byIdx[c.chest_idx]) byIdx[c.chest_idx] = { x: c.x, y: c.y, z: c.z, qty: 0 };
      byIdx[c.chest_idx].qty += c.qty;
    }
    return Object.values(byIdx).sort((a, b) => b.qty - a.qty);
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function copyCoords(x, y, z, btn) {
    const text = `/tp @s ${x} ${y} ${z}`;
    try {
      await navigator.clipboard.writeText(text);
    } catch (e) {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    const orig = btn.textContent;
    btn.textContent = 'Copied';
    btn.style.cssText += ';background:rgba(47,217,107,.12);border-color:rgba(47,217,107,.3);color:#5be38f';
    setTimeout(() => {
      btn.textContent = orig;
      btn.style.background = '';
      btn.style.borderColor = '';
      btn.style.color = '';
    }, 1800);
  }

  function renderChestPanel(islName, itemName, itemData) {
    const panel = document.getElementById('chests-' + islName);
    const locs = groupChests(itemData.chests);
    let html = `
      <div style="font-family:'Baloo 2';font-weight:800;font-size:14px;margin-bottom:4px">${esc(itemName)}</div>
      <div style="font-size:12px;color:var(--muted);font-family:'Baloo 2';margin-bottom:14px">${locs.length} chest location${locs.length !== 1 ? 's' : ''} &nbsp;·&nbsp; ${itemData.total.toLocaleString()} total</div>
    `;
    locs.forEach((loc, i) => {
      html += `<div class="ca-chest-row">
        <div>
          <div class="ca-chest-coords">X: ${loc.x} &nbsp; Y: ${loc.y} &nbsp; Z: ${loc.z}</div>
          <div class="ca-chest-qty">${loc.qty} in this chest</div>
        </div>
        <button class="ca-copy-btn" data-x="${loc.x}" data-y="${loc.y}" data-z="${loc.z}">Copy TP</button>
      </div>`;
    });
    panel.innerHTML = html;
    panel.querySelectorAll('.ca-copy-btn').forEach(btn => {
      btn.addEventListener('click', () => copyCoords(+btn.dataset.x, +btn.dataset.y, +btn.dataset.z, btn));
    });
  }

  function renderItemList(islName, items, filter) {
    const container = document.getElementById('list-' + islName);
    const color = ICOLOR[islName];
    const q = filter.toLowerCase();
    const filtered = items.filter(([name]) => !q || name.toLowerCase().includes(q));

    if (!filtered.length) {
      container.innerHTML = `<div style="padding:24px;color:var(--muted);text-align:center;font-family:'Baloo 2';font-size:13px">No items match "${esc(filter)}"</div>`;
      return;
    }

    let html = '';
    filtered.forEach(([name, d], i) => {
      const rank = q ? '' : `<span class="ca-item-rank">${i + 1}</span>`;
      html += `<div class="ca-item-row" data-isl="${esc(islName)}" data-item="${esc(name)}" style="--icolor:${color}">
        ${rank}
        <span class="ca-item-name">${esc(name)}</span>
        <span class="ca-item-qty">${d.total.toLocaleString()}</span>
      </div>`;
    });
    container.innerHTML = html;

    container.querySelectorAll('.ca-item-row').forEach(row => {
      row.addEventListener('click', () => {
        container.querySelectorAll('.ca-item-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        row.style.borderLeft = `3px solid ${color}`;
        renderChestPanel(islName, row.dataset.item, DATA[islName].items[row.dataset.item]);
      });
    });
  }

  function initIsland(islName) {
    const isl = DATA[islName];
    const color = ICOLOR[islName];
    const sortedItems = Object.entries(isl.items).sort((a, b) => b[1].total - a[1].total);
    const totalQty = sortedItems.reduce((s, [, v]) => s + v.total, 0);
    const fillPct = isl.total_chests ? Math.round((isl.non_empty / isl.total_chests) * 100) : 0;

    // stat row
    const statsEl = document.getElementById('stats-' + islName);
    const stats = [
      { label: 'Total Chests', val: isl.total_chests.toLocaleString(), sub: `${isl.non_empty} non-empty · ${isl.empty} empty` },
      { label: 'Fill Rate', val: fillPct + '%', sub: `${isl.non_empty} chests had loot` },
      { label: 'Unique Items', val: sortedItems.length.toLocaleString(), sub: '' },
      { label: 'Total Loot', val: totalQty.toLocaleString(), sub: 'items across all chests' }
    ];
    statsEl.style.gridTemplateColumns = 'repeat(4,1fr)';
    statsEl.innerHTML = stats.map(s => `
      <div class="ca-stat" style="border-top:3px solid ${color}">
        <div class="ca-stat-label">${s.label}</div>
        <div class="ca-stat-val" style="color:${color}">${s.val}</div>
        ${s.sub ? `<div class="ca-stat-sub">${s.sub}</div>` : ''}
      </div>
    `).join('');

    // item list
    renderItemList(islName, sortedItems, '');

    // search
    const searchEl = document.getElementById('search-' + islName);
    searchEl.addEventListener('input', () => {
      renderItemList(islName, sortedItems, searchEl.value.trim());
    });
  }

  ISLANDS.forEach(initIsland);

})();
</script>

<%- include('partials/foot') %>
