<%- include('partials/head', { pageTitle: 'Nation Leader Application — 150 Player Event' }) %>
<%- include('partials/header') %>

<style>
.nl-wrap{max-width:640px;margin:0 auto;padding-bottom:60px}
.nl-card{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:28px;margin-bottom:16px}
.nl-section-title{font-family:'Baloo 2';font-weight:800;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin:0 0 14px}
.nl-step{display:flex;gap:14px;margin-bottom:18px}
.nl-step-num{width:28px;height:28px;border-radius:50%;background:rgba(91,227,143,.12);border:1px solid rgba(91,227,143,.25);color:#5be38f;font-family:'Baloo 2';font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.nl-step-body{flex:1}
.nl-step-title{font-family:'Baloo 2';font-weight:800;font-size:14px;color:#e0e2ed;margin:0 0 4px}
.nl-step-desc{font-size:13px;color:var(--muted);line-height:1.6;margin:0}
.nl-step-desc code{background:rgba(255,255,255,.08);padding:1px 6px;border-radius:4px;font-size:12px;color:#c9ccdb}
.nl-input{width:100%;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;padding:12px 15px;font-family:'Baloo 2';font-weight:700;font-size:15px;color:#fff;outline:none;transition:border-color .15s;box-sizing:border-box}
.nl-input:focus{border-color:rgba(91,227,143,.5)}
.nl-btn{width:100%;font-family:'Baloo 2';font-weight:800;font-size:15px;padding:14px;border-radius:10px;border:none;cursor:pointer;transition:opacity .15s}
.nl-btn:hover:not(:disabled){opacity:.85}
.nl-btn:disabled{opacity:.5;cursor:not-allowed}
.nl-btn-primary{background:linear-gradient(135deg,#22863a,#16a34a);color:#fff}
.nl-warn{background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.25);border-radius:10px;padding:14px 16px;font-size:13px;color:#fbbf24;line-height:1.6}
.nl-rule{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);font-size:13px;color:var(--muted);line-height:1.5}
.nl-rule:last-child{border-bottom:none;padding-bottom:0}
.nl-pill{display:inline-block;font-family:'Baloo 2';font-weight:800;font-size:12px;padding:3px 10px;border-radius:99px}
.nl-pill-green{background:rgba(91,227,143,.12);color:#5be38f;border:1px solid rgba(91,227,143,.25)}
.nl-invite-link{display:inline-flex;align-items:center;gap:7px;font-family:'Baloo 2';font-weight:700;font-size:13px;color:#74c0fc;background:rgba(116,192,252,.08);border:1px solid rgba(116,192,252,.25);border-radius:8px;padding:7px 13px;text-decoration:none;margin-top:8px}
.nl-invite-link:hover{background:rgba(116,192,252,.14)}
/* Loading bar */
.nl-loader{display:none;margin:16px 0 0}
.nl-loader-bar{height:4px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden;margin-bottom:8px}
.nl-loader-fill{height:100%;width:0;background:linear-gradient(90deg,#22863a,#5be38f);border-radius:4px;animation:nlload 2.4s ease-in-out forwards}
@keyframes nlload{0%{width:0}60%{width:75%}90%{width:88%}100%{width:88%}}
.nl-loader-text{font-family:'Baloo 2';font-weight:700;font-size:13px;color:var(--muted)}
/* Result states */
.nl-result{display:none;margin-top:16px;padding:16px;border-radius:10px;font-family:'Baloo 2';font-weight:700;font-size:14px;line-height:1.6}
.nl-result.ok{background:rgba(91,227,143,.08);border:1px solid rgba(91,227,143,.25);color:#5be38f}
.nl-result.err{background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.25);color:#f87171}
/* Approved state */
.nl-approved{background:rgba(91,227,143,.06);border:2px solid rgba(91,227,143,.3);border-radius:var(--radius);padding:28px;text-align:center}
</style>

<main class="wrap">
  <div class="nl-wrap">

    <div class="page-head" style="margin-bottom:20px">
      <a href="<%= lp %>/applications" class="back">← Applications</a>
      <div>
        <h1 class="page-title">Nation Leader Application</h1>
        <p class="page-sub" style="margin:4px 0 0;color:var(--muted);font-size:13px">150 Player Event · Separate from the general application</p>
      </div>
    </div>

    <% if (existing && existing.accepted) { %>
    <!-- Accepted as nation leader -->
    <div class="nl-approved">
      <div style="font-family:'Baloo 2';font-weight:800;font-size:20px;color:#5be38f;margin-bottom:6px">Accepted as Nation Leader</div>
      <div style="font-size:14px;color:var(--muted);margin-bottom:4px">Nation Server: <strong style="color:#e0e2ed"><%= existing.server_name %></strong></div>
      <div style="font-size:13px;color:var(--muted);margin-bottom:20px">Accepted <%= existing.accepted_at ? new Date(existing.accepted_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '' %></div>
      <div style="background:rgba(91,227,143,.06);border:1px solid rgba(91,227,143,.2);border-radius:10px;padding:14px 18px;font-size:14px;color:#c9ccdb;text-align:left">
        Your nation has been officially recognised. The bot is now monitoring your server throughout the event. Keep it there and its permissions intact — removing or revoking the bot will result in disqualification.
      </div>
    </div>

    <% } else if (existing) { %>
    <!-- Server verified, pending ticket review -->
    <div class="nl-approved">
      <div style="font-family:'Baloo 2';font-weight:800;font-size:20px;color:#5be38f;margin-bottom:6px">Server Authorised</div>
      <div style="font-size:14px;color:var(--muted);margin-bottom:4px">Server: <strong style="color:#e0e2ed"><%= existing.server_name %></strong></div>
      <div style="font-size:13px;color:var(--muted);margin-bottom:20px">Verified <%= existing.submitted_at ? new Date(existing.submitted_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'}) : '' %></div>
      <div style="font-family:'Baloo 2';font-weight:700;font-size:14px;color:#e0e2ed;margin-bottom:8px">Your next step:</div>
      <div style="background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;padding:14px 18px;font-size:14px;color:#c9ccdb;text-align:left">
        Go to the <strong style="color:#fff">Collective Union Discord server</strong> and run the command<br>
        <code style="font-family:monospace;font-size:15px;color:#5be38f;background:rgba(91,227,143,.08);padding:4px 10px;border-radius:6px;display:inline-block;margin-top:6px">/leader application</code><br>
        <span style="font-size:12px;color:var(--muted);margin-top:6px;display:block">This will open a private application ticket with our team.</span>
      </div>
    </div>

    <% } else { %>
    <!-- What is a Nation Leader -->
    <div class="nl-card">
      <div class="nl-section-title">What is a Nation Leader?</div>
      <p style="font-size:14px;color:#c9ccdb;line-height:1.7;margin:0 0 14px">In the 150 Player Event, players are free to form alliances, nations, and factions — entirely on their own terms. A <strong style="color:#fff">nation leader</strong> is someone who takes a formal role in organising one of these groups before the event starts.</p>
      <p style="font-size:14px;color:#c9ccdb;line-height:1.7;margin:0">As a nation leader, you will have a private Discord server for coordinating your members and planning strategy. Our bot will have access to your server so we can monitor for fair play — any form of outside coordination, scripted alliances, or pre-arranged team sizes that exceed what is allowed will result in disqualification.</p>
    </div>

    <!-- Why fresh server -->
    <div class="nl-card">
      <div class="nl-section-title">The Fresh Server Rule</div>
      <div class="nl-warn" style="margin-bottom:16px">
        <strong>Why does my server need to be empty?</strong><br>
        We require nation leaders to use a brand new Discord server — one with no existing members — to prevent <em>metagaming</em>: the practice of secretly organising a large team of players ahead of the event to gain an unfair advantage. If your server already has dozens of members in it, we have no way to verify that it was genuinely built from scratch on the island.
      </div>
      <div>
        <div class="nl-rule"><span>Your Discord server must be <strong style="color:#fff">freshly created</strong>. Do not use an existing server with members already in it.</span></div>
        <div class="nl-rule"><span>At the time of authorisation, your server must have <strong style="color:#fff">fewer than 3 members</strong> (yourself + our bot counts as 2, so one additional member is allowed).</span></div>
        <div class="nl-rule"><span>You must invite our bot with admin permissions so it can monitor your server throughout the event.</span></div>
        <div class="nl-rule"><span>Removing the bot or revoking its permissions before or during the event will result in disqualification.</span></div>
      </div>
    </div>

    <!-- Steps -->
    <div class="nl-card">
      <div class="nl-section-title">How to Apply</div>

      <div class="nl-step">
        <div class="nl-step-num">1</div>
        <div class="nl-step-body">
          <p class="nl-step-title">Create a new Discord server</p>
          <p class="nl-step-desc">Open Discord and create a brand new server — not an existing one. Give it the name of your intended nation. Do not invite any friends yet.</p>
        </div>
      </div>

      <div class="nl-step">
        <div class="nl-step-num">2</div>
        <div class="nl-step-body">
          <p class="nl-step-title">Invite our bot with admin permissions</p>
          <p class="nl-step-desc">The Collective Union bot must be in your server with administrator access so it can read all channels and members. Click the link below to invite it — make sure to select your new server and grant the permissions requested.</p>
          <a href="https://discord.com/oauth2/authorize?client_id=<%= process.env.CLIENT_ID %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="nl-invite-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            Invite CU Bot (Admin Permissions)
          </a>
        </div>
      </div>

      <div class="nl-step">
        <div class="nl-step-num">3</div>
        <div class="nl-step-body">
          <p class="nl-step-title">Get your server's ID</p>
          <p class="nl-step-desc">Here's how to copy your server ID:</p>
          <div style="margin-top:8px;font-size:13px;color:var(--muted);line-height:1.7">
            <div style="margin-bottom:4px">① In Discord, go to <strong style="color:#c9ccdb">User Settings → Advanced</strong> and enable <strong style="color:#c9ccdb">Developer Mode</strong>.</div>
            <div style="margin-bottom:4px">② Right-click your server's <strong style="color:#c9ccdb">name or icon</strong> in the left sidebar.</div>
            <div>③ Click <code>Copy Server ID</code>. Paste that number below.</div>
          </div>
        </div>
      </div>

      <div class="nl-step" style="margin-bottom:0">
        <div class="nl-step-num">4</div>
        <div class="nl-step-body">
          <p class="nl-step-title">Enter the server ID and authorise</p>
          <p class="nl-step-desc" style="margin-bottom:12px">Once you enter the server ID, our bot will check your server. This takes a few seconds.</p>

          <div style="margin-bottom:8px">
            <input type="text" id="channelIdInput" class="nl-input" placeholder="e.g. 1234567890123456789" inputmode="numeric" pattern="[0-9]+" maxlength="25">
          </div>
          <button class="nl-btn nl-btn-primary" id="authoriseBtn" onclick="authoriseServer()">
            Authorise Server
          </button>

          <div class="nl-loader" id="nlLoader">
            <div class="nl-loader-bar"><div class="nl-loader-fill" id="nlLoaderFill"></div></div>
            <div class="nl-loader-text">Checking your server — please wait...</div>
          </div>

          <div class="nl-result" id="nlResult"></div>
        </div>
      </div>

    </div>
    <% } %>

  </div>
</main>

<script>
function authoriseServer() {
  var input = document.getElementById('channelIdInput');
  var btn = document.getElementById('authoriseBtn');
  var loader = document.getElementById('nlLoader');
  var result = document.getElementById('nlResult');
  var loaderFill = document.getElementById('nlLoaderFill');

  var channelId = (input.value || '').trim();
  if (!channelId || !/^\d+$/.test(channelId)) {
    result.className = 'nl-result err';
    result.style.display = 'block';
    result.textContent = 'Please enter a valid channel ID (numbers only).';
    return;
  }

  btn.disabled = true;
  input.disabled = true;
  result.style.display = 'none';
  loaderFill.style.animation = 'none';
  loaderFill.style.width = '0';
  loader.style.display = 'block';
  // restart animation
  void loaderFill.offsetWidth;
  loaderFill.style.animation = 'nlload 2.4s ease-in-out forwards';

  fetch('<%= lp %>/apply-nation-leader/check', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ guild_id: channelId })
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    loader.style.display = 'none';
    result.style.display = 'block';
    if (data.ok) {
      loaderFill.style.width = '100%';
      result.className = 'nl-result ok';
      result.innerHTML =
        '<div style="font-size:20px;margin-bottom:6px">✅ Server authorised!</div>' +
        '<div style="font-family:\'Baloo 2\';font-weight:600;font-size:14px;color:#c9ccdb;margin-bottom:12px">Server <strong style="color:#5be38f">' + data.server_name + '</strong> has been verified (' + data.member_count + ' member' + (data.member_count !== 1 ? 's' : '') + ').</div>' +
        '<div style="background:rgba(91,227,143,.06);border:1px solid rgba(91,227,143,.2);border-radius:8px;padding:12px 14px;font-size:13px;color:#c9ccdb">' +
        'Your next step: go to the <strong style="color:#fff">Collective Union Discord server</strong> and run<br>' +
        '<code style="font-family:monospace;font-size:15px;color:#5be38f;background:rgba(91,227,143,.08);padding:3px 8px;border-radius:5px">/leader application</code><br>' +
        '<span style="font-size:12px;color:var(--muted);margin-top:4px;display:block">This will open a private ticket with our team. The page will reload shortly.</span>' +
        '</div>';
      setTimeout(function() { window.location.reload(); }, 5000);
    } else {
      result.className = 'nl-result err';
      result.textContent = data.error || 'Something went wrong. Please try again.';
      btn.disabled = false;
      input.disabled = false;
    }
  })
  .catch(function() {
    loader.style.display = 'none';
    result.className = 'nl-result err';
    result.style.display = 'block';
    result.textContent = 'Network error — please try again.';
    btn.disabled = false;
    input.disabled = false;
  });
}

document.getElementById('channelIdInput') && document.getElementById('channelIdInput').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') authoriseServer();
});
</script>

<%- include('partials/foot') %>
