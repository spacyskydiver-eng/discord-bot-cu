<%- include('partials/head', { pageTitle: 'Your Application — 150 Player Event' }) %>
<%- include('partials/header') %>

<%
function parseJsonField(v) {
  if (!v) return [];
  if (Array.isArray(v)) return v;
  try { return JSON.parse(v) || []; } catch(_) { return []; }
}
const sessAvail = parseJsonField(app.session_availability);
const SESSION_TIMES = [1787932800,1788019200,1788105600,1788192000,1788278400,1788364800];
%>

<style>
.mya-wrap{max-width:820px;margin:0 auto;padding-bottom:60px}
.mya-section{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);padding:24px;margin-bottom:16px}
.mya-section-title{font-family:'Baloo 2';font-weight:800;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:0 0 16px}
.mya-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.mya-label{font-size:11px;font-family:'Baloo 2';font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.mya-value{font-size:14px;color:#e0e2ed;font-family:'Baloo 2';font-weight:600;line-height:1.5}
.mya-value.long{white-space:pre-wrap;line-height:1.6;font-weight:400;font-size:14px;color:#c9ccdb}
.mya-sess-chip{font-family:'Baloo 2';font-weight:700;font-size:12px;padding:4px 10px;border-radius:99px;background:rgba(91,227,143,.1);color:#5be38f;border:1px solid rgba(91,227,143,.2)}
.mya-sess-chip.missing{background:rgba(255,255,255,.04);color:var(--muted);border-color:var(--line)}
.mya-edit-banner{display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:var(--radius);margin-bottom:16px;font-family:'Baloo 2';font-weight:700;font-size:14px}
.mya-status-badge{display:inline-flex;align-items:center;gap:6px;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:5px 12px;border-radius:99px}
</style>

<main class="wrap">
  <div class="mya-wrap">

    <div class="page-head" style="margin-bottom:20px">
      <a href="<%= lp %>/applications" class="back">← Applications</a>
      <div>
        <h1 class="page-title">Your Application</h1>
        <p class="page-sub" style="margin:4px 0 0;color:var(--muted);font-size:13px">150 Player Event</p>
      </div>
    </div>

    <% if (updated) { %>
    <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;background:rgba(91,227,143,.08);border:1px solid rgba(91,227,143,.25);border-radius:var(--radius);margin-bottom:16px;font-family:'Baloo 2';font-weight:700;font-size:14px;color:#5be38f">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
      Your application has been updated.
    </div>
    <% } %>

    <!-- Edit banners -->
    <% if (app.edit_approved) { %>
    <div class="mya-edit-banner" style="background:rgba(116,192,252,.08);border:1px solid rgba(116,192,252,.25);color:#74c0fc">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span style="flex:1">Staff have approved your edit request. You can now make changes.</span>
      <a href="<%= lp %>/my-application-hundred/edit" style="background:rgba(116,192,252,.2);border:1px solid rgba(116,192,252,.3);color:#74c0fc;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:7px 16px;border-radius:8px;text-decoration:none">Edit now →</a>
    </div>
    <% } else if (app.edit_requested) { %>
    <div class="mya-edit-banner" style="background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.2);color:#fbbf24">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Your edit request is pending staff approval.</span>
    </div>
    <% } else if (app.status !== 'declined' && app.status !== 'withdrawn') { %>
    <div class="mya-edit-banner" style="background:rgba(255,255,255,.04);border:1px solid var(--line);color:#c9ccdb">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span style="flex:1">Need to change something? Request an edit and staff will review it.</span>
      <form method="POST" action="<%= lp %>/my-application-hundred/request-edit" style="display:inline">
        <button type="submit" style="background:rgba(255,255,255,.08);border:1px solid var(--line);color:#e0e2ed;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:7px 16px;border-radius:8px;cursor:pointer">Request Edit</button>
      </form>
    </div>
    <% } %>

    <!-- Status -->
    <div class="mya-section">
      <div class="mya-section-title">Application Status</div>
      <div style="display:flex;align-items:center;gap:10px">
        <% if (app.status === 'accepted') { %>
          <span class="mya-status-badge" style="background:rgba(91,227,143,.12);color:#5be38f;border:1px solid rgba(91,227,143,.25)">✓ Accepted</span>
        <% } else if (app.status === 'declined') { %>
          <span class="mya-status-badge" style="background:rgba(248,113,113,.1);color:#f87171;border:1px solid rgba(248,113,113,.25)">✕ Declined</span>
        <% } else if (app.status === 'withdrawn') { %>
          <span class="mya-status-badge" style="background:rgba(139,143,153,.1);color:var(--muted);border:1px solid var(--line)">Withdrawn</span>
        <% } else { %>
          <span class="mya-status-badge" style="background:rgba(251,191,36,.1);color:#fbbf24;border:1px solid rgba(251,191,36,.25)">◎ Under Review</span>
        <% } %>
        <span style="font-size:13px;color:var(--muted)">Submitted <%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric'}) : '—' %></span>
      </div>
    </div>

    <!-- Sessions -->
    <div class="mya-section">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px">
        <div class="mya-section-title" style="margin:0">Session Availability</div>
        <% if (app.status !== 'declined' && app.status !== 'withdrawn') { %>
        <a href="<%= lp %>/my-application-hundred/edit-sessions" style="font-family:'Baloo 2';font-weight:800;font-size:12px;padding:5px 12px;border-radius:8px;background:rgba(116,192,252,.1);border:1px solid rgba(116,192,252,.25);color:#74c0fc;text-decoration:none">Update Sessions</a>
        <% } %>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:6px">
        <% for (let i = 1; i <= 6; i++) { %>
          <% const ts = SESSION_TIMES[i-1]; %>
          <% const d = new Date(ts * 1000); %>
          <% const label = d.toLocaleDateString(undefined, {weekday:'short', day:'numeric', month:'short'}); %>
          <span class="mya-sess-chip <%= sessAvail.includes(i) ? '' : 'missing' %>">
            S<%= i %> — <%= label %> <%= sessAvail.includes(i) ? '✓' : '✕' %>
          </span>
        <% } %>
      </div>
    </div>

    <!-- Basic info -->
    <div class="mya-section">
      <div class="mya-section-title">Basic Information</div>
      <div class="mya-row">
        <div><div class="mya-label">Minecraft IGN</div><div class="mya-value"><%= app.ign || '—' %></div></div>
        <div><div class="mya-label">Discord Username</div><div class="mya-value"><%= app.discord_username_input || '—' %></div></div>
        <div><div class="mya-label">Country / Timezone</div><div class="mya-value"><%= app.country || '—' %></div></div>
      </div>
    </div>

    <!-- Questions -->
    <div class="mya-section">
      <div class="mya-section-title">Quick Questions</div>
      <div style="margin-bottom:16px"><div class="mya-label">Previous Minecraft Events</div><div class="mya-value long"><%= app.prev_events || '—' %></div></div>
      <div style="margin-bottom:16px"><div class="mya-label">Playstyle</div><div class="mya-value long"><%= app.playstyle_desc || '—' %></div></div>
      <div><div class="mya-label">Why do you want to join?</div><div class="mya-value long"><%= app.why_join || '—' %></div></div>
    </div>

    <!-- Friends -->
    <% if (app.friend_requests && app.friend_requests.trim()) { %>
    <div class="mya-section">
      <div class="mya-section-title">Friend Requests</div>
      <div class="mya-value long"><%= app.friend_requests %></div>
    </div>
    <% } %>

    <!-- Withdraw / reset -->
    <% if (app.status !== 'declined' && app.status !== 'accepted') { %>
    <div style="margin-top:32px;padding-top:24px;border-top:1px solid var(--line)">
      <div style="font-family:'Baloo 2';font-weight:800;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px">Withdraw &amp; Start Over</div>
      <p style="font-size:13px;color:var(--muted);margin:0 0 14px">This removes your current application so you can start a new one from scratch. Your spot will not be reserved.</p>
      <form method="POST" action="<%= lp %>/my-application-hundred/withdraw" onsubmit="return confirm('This will delete your application so you can start fresh. Continue?')">
        <button type="submit" style="font-family:'Baloo 2';font-weight:800;font-size:13px;padding:8px 16px;border-radius:8px;background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.25);color:#f87171;cursor:pointer">Withdraw &amp; Reapply</button>
      </form>
    </div>
    <% } %>

  </div>
</main>

<%- include('partials/foot') %>
