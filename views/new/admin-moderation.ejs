<%- include('partials/head', { pageTitle: 'Moderation' }) %>
<%- include('partials/header') %>

<style>
/* ── Layout ── */
.mod-wrap { max-width: 1100px; margin: 0 auto; padding: 24px 20px 100px; }
.mod-topbar { display:flex; align-items:center; gap:12px; margin-bottom:24px; flex-wrap:wrap; }
.mod-title { font-family:'Baloo 2'; font-weight:900; font-size:24px; color:#e0e2ed; margin:0; }
.mod-title span { color:#74c0fc; }

/* ── Tabs ── */
.tab-nav { display:flex; gap:4px; border-bottom:2px solid rgba(255,255,255,.07); margin-bottom:24px; }
.tab-btn { font-family:'Baloo 2'; font-weight:800; font-size:13px; padding:10px 18px; border-radius:10px 10px 0 0;
  border:1px solid transparent; border-bottom:none; cursor:pointer; color:rgba(255,255,255,.4);
  background:none; position:relative; bottom:-2px; white-space:nowrap; transition:all .15s; }
.tab-btn:hover { color:rgba(255,255,255,.7); background:rgba(255,255,255,.04); }
.tab-btn.active { color:#e0e2ed; background:rgba(255,255,255,.06); border-color:rgba(255,255,255,.1); border-bottom-color:rgba(18,19,28,1); }
.tab-badge { background:#f87171; color:#fff; font-size:10px; font-weight:800; border-radius:99px;
  padding:1px 6px; margin-left:6px; vertical-align:middle; }
.tab-panel { display:none; }
.tab-panel.active { display:block; }

/* ── Shared buttons ── */
.btn { font-family:'Baloo 2'; font-weight:800; font-size:12px; padding:7px 14px; border-radius:8px;
  border:none; cursor:pointer; display:inline-flex; align-items:center; gap:6px; text-decoration:none; transition:opacity .15s; }
.btn:hover { opacity:.8; }
.btn-sm { padding:4px 10px; font-size:11px; }
.btn-primary { background:rgba(116,192,252,.12); color:#74c0fc; border:1px solid rgba(116,192,252,.25); }
.btn-success { background:rgba(91,227,143,.1); color:#5be38f; border:1px solid rgba(91,227,143,.22); }
.btn-danger { background:rgba(248,113,113,.1); color:#f87171; border:1px solid rgba(248,113,113,.25); }
.btn-ghost { background:rgba(255,255,255,.05); color:rgba(255,255,255,.5); border:1px solid rgba(255,255,255,.1); }
.btn-ai { background:rgba(168,85,247,.12); color:#c084fc; border:1px solid rgba(168,85,247,.28); }
.btn-new { background:linear-gradient(135deg,rgba(116,192,252,.18),rgba(168,85,247,.15)); color:#e0e2ed;
  border:1px solid rgba(116,192,252,.3); padding:9px 18px; font-size:13px; }

/* ── Cards ── */
.card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:12px;
  margin-bottom:10px; overflow:hidden; }
.card-header { display:flex; align-items:center; gap:12px; padding:14px 18px; cursor:pointer; }
.card-header:hover { background:rgba(255,255,255,.02); }
.card-body { padding:16px 18px; border-top:1px solid rgba(255,255,255,.06); display:none; }
.card-body.open { display:block; }
.avatar { width:32px; height:32px; border-radius:50%; object-fit:cover; background:rgba(255,255,255,.08); flex-shrink:0; }
.player-tag { font-family:'Baloo 2'; font-weight:800; font-size:13px; color:#e0e2ed; }
.player-id { font-family:'Baloo 2'; font-size:11px; color:rgba(255,255,255,.35); }
.card-meta { font-family:'Baloo 2'; font-size:11px; color:rgba(255,255,255,.35); margin-left:auto; white-space:nowrap; }
.summary-text { font-size:13px; color:#c9ccdb; line-height:1.65; margin:10px 0; }
.detail-row { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-bottom:8px; }
.detail-label { font-family:'Baloo 2'; font-weight:700; font-size:11px; color:rgba(255,255,255,.35); min-width:80px; }

/* ── Pills ── */
.pill { font-family:'Baloo 2'; font-weight:800; font-size:10px; text-transform:uppercase; letter-spacing:.06em;
  padding:2px 9px; border-radius:99px; }
.pill-type-ticket { background:rgba(116,192,252,.12); color:#74c0fc; border:1px solid rgba(116,192,252,.22); }
.pill-type-general { background:rgba(251,191,36,.1); color:#fbbf24; border:1px solid rgba(251,191,36,.2); }
.pill-type-player { background:rgba(168,85,247,.12); color:#c084fc; border:1px solid rgba(168,85,247,.22); }
.pill-sev-low { background:rgba(251,191,36,.1); color:#fbbf24; border:1px solid rgba(251,191,36,.18); }
.pill-sev-medium { background:rgba(251,146,60,.12); color:#fb923c; border:1px solid rgba(251,146,60,.25); }
.pill-sev-high { background:rgba(248,113,113,.12); color:#f87171; border:1px solid rgba(248,113,113,.25); }
.pill-action { background:rgba(255,255,255,.06); color:rgba(255,255,255,.5); border:1px solid rgba(255,255,255,.1); }
.pill-flag-slur { background:rgba(248,113,113,.14); color:#f87171; border:1px solid rgba(248,113,113,.28); }
.pill-flag-extreme { background:rgba(251,146,60,.14); color:#fb923c; border:1px solid rgba(251,146,60,.28); }
.pill-flag-hate { background:rgba(168,85,247,.14); color:#c084fc; border:1px solid rgba(168,85,247,.28); }

/* ── Filter pills ── */
.filter-pills { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:18px; align-items:center; }
.filter-pill { font-family:'Baloo 2'; font-weight:800; font-size:12px; padding:5px 14px; border-radius:99px;
  cursor:pointer; border:1px solid rgba(255,255,255,.1); color:rgba(255,255,255,.4); background:rgba(255,255,255,.04); transition:all .15s; }
.filter-pill:hover { border-color:rgba(255,255,255,.2); color:rgba(255,255,255,.7); }
.filter-pill.active { background:rgba(116,192,252,.12); border-color:rgba(116,192,252,.3); color:#74c0fc; }
.filter-count { font-family:'Baloo 2'; font-size:12px; color:rgba(255,255,255,.3); margin-left:auto; }

/* ── Flag card ── */
.flag-content { font-size:13px; color:#c9ccdb; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.07);
  border-radius:8px; padding:10px 14px; line-height:1.65; white-space:pre-wrap; word-break:break-word; margin:8px 0; }
.flag-match { font-family:monospace; font-size:12px; background:rgba(248,113,113,.1); color:#f87171; padding:1px 6px; border-radius:4px; }
.disregarded-overlay { opacity:.35; pointer-events:none; }
.card.disregarded .card-header { opacity:.35; }

/* ── Evidence list ── */
.ev-list { display:flex; flex-direction:column; gap:8px; }
.ev-item { display:flex; align-items:center; gap:10px; background:rgba(255,255,255,.03);
  border:1px solid rgba(255,255,255,.07); border-radius:8px; padding:10px 12px; }
.ev-thumb { width:60px; height:42px; object-fit:cover; border-radius:6px; flex-shrink:0; }
.ev-icon { font-size:20px; flex-shrink:0; width:36px; text-align:center; }
.ev-label { font-family:'Baloo 2'; font-weight:700; font-size:12px; color:#e0e2ed; }
.ev-meta { font-family:'Baloo 2'; font-size:11px; color:rgba(255,255,255,.35); }

/* ── AI summary box ── */
.ai-box { background:rgba(168,85,247,.07); border:1px solid rgba(168,85,247,.2); border-radius:10px;
  padding:14px 16px; margin-top:12px; }
.ai-box-label { font-family:'Baloo 2'; font-weight:800; font-size:11px; color:#c084fc; margin-bottom:6px; text-transform:uppercase; letter-spacing:.05em; }
.ai-box-text { font-size:13px; color:#ddd6fe; line-height:1.7; }

/* ── Snippet library ── */
.snip-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:12px; }
.snip-card { background:rgba(255,255,255,.04); border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:16px; }
.snip-card-title { font-family:'Baloo 2'; font-weight:800; font-size:13px; color:#e0e2ed; margin-bottom:4px; }
.snip-card-meta { font-family:'Baloo 2'; font-size:11px; color:rgba(255,255,255,.35); }
.snip-card-actions { display:flex; gap:6px; margin-top:10px; flex-wrap:wrap; }

/* ── Slide-in panel ── */
.panel-overlay { position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:800; opacity:0;
  pointer-events:none; transition:opacity .25s; }
.panel-overlay.open { opacity:1; pointer-events:all; }
.slide-panel { position:fixed; top:0; right:0; height:100vh; width:min(520px,100vw);
  background:#15161f; border-left:1px solid rgba(255,255,255,.1); z-index:900;
  transform:translateX(100%); transition:transform .3s cubic-bezier(.4,0,.2,1);
  display:flex; flex-direction:column; overflow:hidden; }
.slide-panel.open { transform:translateX(0); }
.panel-head { display:flex; align-items:center; gap:12px; padding:20px 24px; border-bottom:1px solid rgba(255,255,255,.08); flex-shrink:0; }
.panel-head-title { font-family:'Baloo 2'; font-weight:900; font-size:17px; color:#e0e2ed; flex:1; }
.panel-body { flex:1; overflow-y:auto; padding:20px 24px; }
.panel-body::-webkit-scrollbar { width:4px; }
.panel-body::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1); border-radius:99px; }

/* ── Panel form ── */
.form-group { margin-bottom:16px; }
.form-label { font-family:'Baloo 2'; font-weight:800; font-size:11px; color:rgba(255,255,255,.4);
  text-transform:uppercase; letter-spacing:.05em; margin-bottom:6px; display:block; }
.form-input { width:100%; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
  border-radius:8px; padding:10px 14px; font-family:'Baloo 2'; font-weight:600; font-size:13px;
  color:#fff; outline:none; box-sizing:border-box; }
.form-input:focus { border-color:rgba(116,192,252,.4); }
.form-select { width:100%; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
  border-radius:8px; padding:10px 14px; font-family:'Baloo 2'; font-weight:600; font-size:13px;
  color:#fff; outline:none; box-sizing:border-box; }
.form-textarea { width:100%; background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.1);
  border-radius:8px; padding:10px 14px; font-family:'Baloo 2'; font-weight:600; font-size:13px;
  color:#fff; outline:none; resize:vertical; min-height:90px; box-sizing:border-box; line-height:1.6; }
.form-textarea:focus, .form-select:focus { border-color:rgba(116,192,252,.4); }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }

/* ── Report type cards ── */
.type-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:4px; }
.type-card { border:1px solid rgba(255,255,255,.1); border-radius:10px; padding:12px 10px; text-align:center;
  cursor:pointer; transition:all .15s; background:rgba(255,255,255,.03); }
.type-card:hover { border-color:rgba(255,255,255,.2); background:rgba(255,255,255,.06); }
.type-card.selected { border-color:#74c0fc; background:rgba(116,192,252,.1); }
.type-card.selected.gen { border-color:#fbbf24; background:rgba(251,191,36,.1); }
.type-card.selected.player { border-color:#c084fc; background:rgba(168,85,247,.1); }
.type-card-icon { font-size:22px; margin-bottom:4px; }
.type-card-name { font-family:'Baloo 2'; font-weight:800; font-size:12px; color:#e0e2ed; }
.type-card-desc { font-family:'Baloo 2'; font-size:10px; color:rgba(255,255,255,.35); margin-top:2px; }

/* ── Multi-snippet chips ── */
.snip-chips { display:flex; flex-wrap:wrap; gap:6px; min-height:32px; margin-bottom:8px; }
.snip-chip { display:inline-flex; align-items:center; gap:6px; background:rgba(116,192,252,.1);
  border:1px solid rgba(116,192,252,.25); border-radius:99px; padding:3px 10px;
  font-family:'Baloo 2'; font-weight:700; font-size:12px; color:#74c0fc; }
.snip-chip-rm { background:none; border:none; cursor:pointer; color:#74c0fc; font-size:13px; padding:0; line-height:1; }
.snip-picker-list { max-height:200px; overflow-y:auto; border:1px solid rgba(255,255,255,.08); border-radius:8px; }
.snip-row { display:flex; align-items:center; gap:10px; padding:9px 12px; cursor:pointer;
  border-bottom:1px solid rgba(255,255,255,.05); transition:background .1s; }
.snip-row:last-child { border-bottom:none; }
.snip-row:hover { background:rgba(255,255,255,.04); }
.snip-row.added { background:rgba(116,192,252,.07); }
.snip-row-name { font-family:'Baloo 2'; font-weight:700; font-size:12px; color:#e0e2ed; }
.snip-row-meta { font-family:'Baloo 2'; font-size:11px; color:rgba(255,255,255,.35); }

/* ── AI result in panel ── */
.ai-result { background:rgba(168,85,247,.07); border:1px solid rgba(168,85,247,.2); border-radius:10px;
  padding:12px 14px; margin-top:10px; display:none; }
.ai-result.show { display:block; }
.ai-result-text { font-size:13px; color:#ddd6fe; line-height:1.7; }

/* ── Empty state ── */
.empty { display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:60px 20px; color:rgba(255,255,255,.25); text-align:center; }
.empty-icon { font-size:40px; margin-bottom:12px; }
.empty-text { font-family:'Baloo 2'; font-weight:700; font-size:14px; }

/* ── Misc ── */
.divider { height:1px; background:rgba(255,255,255,.07); margin:16px 0; }
.section-title { font-family:'Baloo 2'; font-weight:900; font-size:12px; text-transform:uppercase;
  letter-spacing:.07em; color:rgba(255,255,255,.3); margin-bottom:12px; }
.inline-form { display:inline; }
</style>

<div class="mod-wrap">

  <!-- Top bar -->
  <div class="mod-topbar">
    <h1 class="mod-title">Mod<span>eration</span></h1>
    <button class="btn btn-new" onclick="openPanel()">＋ New Report</button>
  </div>

  <!-- Tabs -->
  <div class="tab-nav">
    <button class="tab-btn active" onclick="switchTab('flagged',this)">
      🚩 Flagged
      <% const newFlags = flagged.filter(f=>!f.disregarded).length; %>
      <% if(newFlags>0){%><span class="tab-badge"><%= newFlags %></span><%}%>
    </button>
    <button class="tab-btn" onclick="switchTab('bans',this)">
      🔨 Bans
      <% if(bans.length>0){%><span class="tab-badge" style="background:#fb923c"><%= bans.length %></span><%}%>
    </button>
    <button class="tab-btn" onclick="switchTab('reports',this)">
      📋 Reports
      <% if(allReports.length>0){%><span class="tab-badge" style="background:#74c0fc"><%= allReports.length %></span><%}%>
    </button>
    <button class="tab-btn" onclick="switchTab('evidence',this)">
      💬 Evidence Library
      <% if(snippets.length>0){%><span class="tab-badge" style="background:#c084fc"><%= snippets.length %></span><%}%>
    </button>
  </div>

  <!-- ═══════════════════ FLAGGED TAB ═══════════════════ -->
  <div class="tab-panel active" id="tab-flagged">

    <div class="filter-pills">
      <button class="filter-pill active" onclick="filterFlags('all',this)">All</button>
      <button class="filter-pill" onclick="filterFlags('active',this)">Active</button>
      <button class="filter-pill" onclick="filterFlags('disregarded',this)">Disregarded</button>
      <span class="filter-count"><%= flagged.length %> total</span>
    </div>

    <% if(!flagged.length){ %>
    <div class="empty"><div class="empty-icon">✅</div><div class="empty-text">No flagged messages</div></div>
    <% } %>

    <% flagged.forEach(function(f){ %>
    <%
      const flagDate = new Date(f.flagged_at);
      const isToday = flagDate.toDateString() === new Date().toDateString();
      const typeClass = f.flag_type==='slur'?'pill-flag-slur': f.flag_type==='extremist'?'pill-flag-extreme':'pill-flag-hate';
    %>
    <div class="card <%= f.disregarded?'disregarded':'' %>" data-flag-state="<%= f.disregarded?'disregarded':'active' %>">
      <div class="card-header" onclick="toggleCard(this)">
        <span class="pill <%= typeClass %>"><%= f.flag_type||'flagged' %></span>
        <div style="flex:1;min-width:0">
          <div style="font-family:'Baloo 2';font-weight:800;font-size:13px;color:#e0e2ed;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            <%= (f.content||'').substring(0,120) %>
          </div>
          <div style="font-family:'Baloo 2';font-size:11px;color:rgba(255,255,255,.35);">
            <%= f.author_tag||'Unknown' %>
            <% if(f.channel_name){ %> · #<%= f.channel_name %><% } %>
            <% if(f.guild_name){ %> · <%= f.guild_name %><% } %>
          </div>
        </div>
        <div class="card-meta">
          <% if(isToday){ %><span style="color:#f87171;margin-right:6px">● Today</span><% } %>
          <%= flagDate.toLocaleDateString('en-GB') %>
        </div>
        <span style="color:rgba(255,255,255,.3);font-size:12px;margin-left:6px">▼</span>
      </div>
      <div class="card-body">
        <div class="flag-content"><%= f.content %></div>
        <% if(f.matched_word){ %>
        <div style="margin-bottom:10px">Matched: <span class="flag-match"><%= f.matched_word %></span></div>
        <% } %>
        <div class="detail-row">
          <span class="detail-label">Author ID</span>
          <span style="font-family:monospace;font-size:12px;color:rgba(255,255,255,.5)"><%= f.author_id||'—' %></span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Message ID</span>
          <span style="font-family:monospace;font-size:12px;color:rgba(255,255,255,.5)"><%= f.message_id||'—' %></span>
        </div>
        <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
          <% if(!f.disregarded){ %>
          <form method="POST" action="/admin/moderation/flagged/<%= f.id %>/disregard" class="inline-form">
            <button class="btn btn-ghost btn-sm">Disregard</button>
          </form>
          <button class="btn btn-primary btn-sm" onclick="prefillPanel('<%= f.author_id %>','<%= (f.author_tag||'').replace(/'/g,\\'') %>')">+ Create Report</button>
          <% } else { %>
          <form method="POST" action="/admin/moderation/flagged/<%= f.id %>/restore" class="inline-form">
            <button class="btn btn-ghost btn-sm">Restore</button>
          </form>
          <% } %>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <!-- ═══════════════════ BANS TAB ═══════════════════ -->
  <div class="tab-panel" id="tab-bans">

    <!-- Add ban form -->
    <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:12px;padding:18px 20px;margin-bottom:20px">
      <div class="section-title" style="margin-bottom:14px">Add New Ban</div>
      <form method="POST" action="/admin/moderation/bans/add">
        <div class="form-row" style="margin-bottom:12px">
          <div class="form-group" style="margin:0">
            <label class="form-label">Discord ID *</label>
            <input type="text" name="discord_id" class="form-input" placeholder="123456789012345678" required>
          </div>
          <div class="form-group" style="margin:0">
            <label class="form-label">Discord Tag *</label>
            <input type="text" name="discord_tag" class="form-input" placeholder="username#0000" required>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Reason *</label>
          <input type="text" name="reason" class="form-input" placeholder="Brief reason for the ban" required>
        </div>
        <div class="form-group">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-textarea" style="min-height:60px" placeholder="Additional context…"></textarea>
        </div>
        <button type="submit" class="btn btn-danger">Add Ban</button>
      </form>
    </div>

    <% if(!bans.length){ %>
    <div class="empty"><div class="empty-icon">🎉</div><div class="empty-text">No active bans</div></div>
    <% } %>

    <% bans.forEach(function(b){ %>
    <%
      const banDate = new Date(b.banned_at||b.created_at);
    %>
    <div class="card">
      <div class="card-header" onclick="toggleCard(this)">
        <% if(b.player_discord_avatar){ %>
        <img src="<%= b.player_discord_avatar %>" class="avatar" alt="">
        <% } else { %>
        <div class="avatar" style="display:flex;align-items:center;justify-content:center;font-size:14px">🔨</div>
        <% } %>
        <div style="flex:1;min-width:0">
          <div class="player-tag"><%= b.discord_tag||b.player_discord_tag||'Unknown' %></div>
          <div class="player-id"><%= b.discord_id||b.player_discord_id||'' %></div>
        </div>
        <div class="card-meta"><%= banDate.toLocaleDateString('en-GB') %></div>
        <span style="color:rgba(255,255,255,.3);font-size:12px;margin-left:6px">▼</span>
      </div>
      <div class="card-body">
        <div class="detail-row">
          <span class="detail-label">Reason</span>
          <span class="summary-text" style="margin:0"><%= b.reason||'No reason given' %></span>
        </div>
        <% if(b.notes){ %>
        <div class="detail-row">
          <span class="detail-label">Notes</span>
          <span style="font-size:13px;color:rgba(255,255,255,.5)"><%= b.notes %></span>
        </div>
        <% } %>
        <% if(b.evidence && b.evidence.length){ %>
        <div class="divider"></div>
        <div class="section-title">Evidence (<%= b.evidence.length %>)</div>
        <div class="ev-list">
          <% b.evidence.forEach(function(ev){ %>
          <div class="ev-item">
            <span class="ev-icon">📎</span>
            <div><div class="ev-label"><%= ev.label||ev.url||ev.filename||'File' %></div></div>
          </div>
          <% }); %>
        </div>
        <% } %>
        <div style="display:flex;gap:8px;margin-top:14px">
          <form method="POST" action="/admin/moderation/bans/<%= b.id %>/delete" class="inline-form"
                onsubmit="return confirm('Remove this ban?')">
            <button class="btn btn-danger btn-sm">Remove Ban</button>
          </form>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <!-- ═══════════════════ REPORTS TAB ═══════════════════ -->
  <div class="tab-panel" id="tab-reports">

    <div class="filter-pills">
      <button class="filter-pill active" onclick="filterReports('all',this)">All <span style="opacity:.5;font-weight:600">(<%= allReports.length %>)</span></button>
      <button class="filter-pill" onclick="filterReports('ticket',this)">Tickets <span style="opacity:.5;font-weight:600">(<%= allReports.filter(r=>r._type==='ticket').length %>)</span></button>
      <button class="filter-pill" onclick="filterReports('player',this)">In-Game <span style="opacity:.5;font-weight:600">(<%= allReports.filter(r=>r._type==='player').length %>)</span></button>
      <button class="filter-pill" onclick="filterReports('general',this)">General <span style="opacity:.5;font-weight:600">(<%= allReports.filter(r=>r._type==='general').length %>)</span></button>
      <span class="filter-count"><%= allReports.length %> total</span>
    </div>

    <% if(!allReports.length){ %>
    <div class="empty"><div class="empty-icon">📋</div><div class="empty-text">No reports yet — use "New Report" to add one</div></div>
    <% } %>

    <% allReports.forEach(function(r){ %>
    <%
      const rDate = new Date(r.created_at);
      const sevClass = r.severity==='high'?'pill-sev-high':r.severity==='medium'?'pill-sev-medium':'pill-sev-low';
      const typeLabel = r._type==='ticket'?'Ticket':r._type==='player'?'In-Game':'General';
      const typeClass = r._type==='ticket'?'pill-type-ticket':r._type==='player'?'pill-type-player':'pill-type-general';
      const evList = Array.isArray(r._evidence)?r._evidence:[];
    %>
    <div class="card" data-rtype="<%= r._type %>">
      <div class="card-header" onclick="toggleCard(this)">
        <% if(r.player_discord_avatar){ %>
        <img src="<%= r.player_discord_avatar %>" class="avatar" alt="">
        <% } else { %>
        <div class="avatar" style="display:flex;align-items:center;justify-content:center;font-size:15px">👤</div>
        <% } %>
        <div style="flex:1;min-width:0">
          <div class="player-tag"><%= r.player_discord_tag||'Unknown' %></div>
          <div style="font-family:'Baloo 2';font-size:11px;color:rgba(255,255,255,.35)"><%= r.player_discord_id||'' %></div>
        </div>
        <div style="display:flex;gap:6px;align-items:center;flex-shrink:0">
          <span class="pill <%= typeClass %>"><%= typeLabel %></span>
          <span class="pill <%= sevClass %>"><%= r.severity||'low' %></span>
          <% if(r.action_taken){ %><span class="pill pill-action"><%= r.action_taken %></span><% } %>
        </div>
        <div class="card-meta" style="margin-left:10px"><%= rDate.toLocaleDateString('en-GB') %></div>
        <span style="color:rgba(255,255,255,.3);font-size:12px;margin-left:6px">▼</span>
      </div>
      <div class="card-body">
        <div class="summary-text"><%= r.summary %></div>

        <div class="form-row" style="margin-bottom:8px">
          <% if(r.staff_involved){ %>
          <div class="detail-row"><span class="detail-label">Staff</span><span style="font-size:13px;color:rgba(255,255,255,.5)"><%= r.staff_involved %></span></div>
          <% } %>
          <% if(r._type==='player' && r.incident_type){ %>
          <div class="detail-row"><span class="detail-label">Incident</span><span style="font-size:13px;color:rgba(255,255,255,.5)"><%= r.incident_type %></span></div>
          <% } %>
          <% if(r._type==='player' && r.location){ %>
          <div class="detail-row"><span class="detail-label">Location</span><span style="font-size:13px;color:rgba(255,255,255,.5)"><%= r.location %></span></div>
          <% } %>
        </div>

        <% if(r.notes){ %>
        <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:10px 14px;font-size:13px;color:rgba(255,255,255,.5);margin-bottom:12px"><%= r.notes %></div>
        <% } %>
        <% if(r.created_by){ %>
        <div class="detail-row"><span class="detail-label">Filed by</span><span style="font-size:13px;color:rgba(255,255,255,.35)"><%= r.created_by %></span></div>
        <% } %>

        <!-- Evidence -->
        <% if(evList.length){ %>
        <div class="divider"></div>
        <div class="section-title">Evidence (<%= evList.length %>)</div>
        <div class="ev-list">
          <% evList.forEach(function(ev){ %>
          <div class="ev-item">
            <% if(ev.evidence_type==='file'){ %>
              <% const isVid=['.mp4','.webm','.mov','.avi'].some(x=>(ev.filename||'').toLowerCase().endsWith(x)); %>
              <% if(isVid){ %>
                <video src="/img/uploads/evidence/<%= ev.filename %>" class="ev-thumb" muted preload="metadata"></video>
              <% } else { %>
                <a href="/img/uploads/evidence/<%= ev.filename %>" target="_blank">
                  <img src="/img/uploads/evidence/<%= ev.filename %>" class="ev-thumb" alt="">
                </a>
              <% } %>
            <% } else if(ev.evidence_type==='url'){ %>
              <span class="ev-icon">🔗</span>
            <% } else { %>
              <span class="ev-icon">💬</span>
            <% } %>
            <div style="flex:1;min-width:0">
              <div class="ev-label"><%= ev.label||(ev.evidence_type==='snippet'?'Snippet #'+ev.snippet_id:ev.filename||ev.url||'Evidence') %></div>
              <div class="ev-meta">
                <% if(ev.evidence_type==='url'){ %><a href="<%= ev.url %>" target="_blank" style="color:#74c0fc"><%= ev.url %></a>
                <% } else if(ev.evidence_type==='snippet'){ %>Chat snippet
                  <% if(ev.snippet_id){ %> · <button class="btn btn-success btn-sm" type="button" onclick="viewSnippet(<%= ev.snippet_id %>)">View</button><% } %>
                <% } else { %>File<% } %>
              </div>
            </div>
            <form method="POST" action="/admin/moderation/reports/evidence/<%= ev.id %>/delete" class="inline-form"
                  onsubmit="return confirm('Remove evidence?')">
              <button class="btn btn-danger btn-sm">✕</button>
            </form>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- Add more evidence inline -->
        <div class="divider"></div>
        <div class="section-title">Add Evidence</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
          <div>
            <div class="form-label" style="margin-bottom:4px">📸 Upload file</div>
            <form method="POST" action="/admin/moderation/reports/<%= r._type %>/<%= r.id %>/evidence/file"
                  enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:6px">
              <input type="file" name="files" accept="image/*,video/*" multiple style="font-size:11px;color:rgba(255,255,255,.4)">
              <button type="submit" class="btn btn-ghost btn-sm" style="width:fit-content">Upload</button>
            </form>
          </div>
          <div>
            <div class="form-label" style="margin-bottom:4px">🔗 Add URL</div>
            <form method="POST" action="/admin/moderation/reports/<%= r._type %>/<%= r.id %>/evidence/url"
                  style="display:flex;flex-direction:column;gap:6px">
              <input type="url" name="url" class="form-input" placeholder="https://…" style="padding:6px 10px;font-size:12px">
              <input type="text" name="label" class="form-input" placeholder="Label (optional)" style="padding:6px 10px;font-size:12px">
              <button type="submit" class="btn btn-ghost btn-sm" style="width:fit-content">Add</button>
            </form>
          </div>
        </div>
        <div style="margin-top:10px">
          <div class="form-label" style="margin-bottom:4px">💬 Attach snippet</div>
          <form method="POST" action="/admin/moderation/reports/<%= r._type %>/<%= r.id %>/evidence/snippet"
                style="display:flex;gap:8px;flex-wrap:wrap;align-items:flex-end">
            <select name="snippet_id" class="form-select" style="flex:1;min-width:150px;padding:7px 10px;font-size:12px">
              <option value="">— select snippet —</option>
              <% (snippets||[]).forEach(function(s){ %>
              <option value="<%= s.id %>">#<%= s.id %> <%= s.label||'(untitled)' %> · <%= s.msg_count %> msgs</option>
              <% }); %>
            </select>
            <button type="submit" class="btn btn-success btn-sm">Attach</button>
          </form>
        </div>

        <div class="divider"></div>
        <div style="display:flex;gap:8px;flex-wrap:wrap">
          <form method="POST" action="/admin/moderation/reports/<%= r._type %>/<%= r.id %>/delete" class="inline-form"
                onsubmit="return confirm('Delete this report permanently?')">
            <button class="btn btn-danger btn-sm">Delete Report</button>
          </form>
        </div>
      </div>
    </div>
    <% }); %>
  </div>

  <!-- ═══════════════════ EVIDENCE LIBRARY TAB ═══════════════════ -->
  <div class="tab-panel" id="tab-evidence">

    <% if(!snippets.length){ %>
    <div class="empty">
      <div class="empty-icon">💬</div>
      <div class="empty-text">No evidence snippets saved yet.</div>
      <div style="font-family:'Baloo 2';font-size:12px;color:rgba(255,255,255,.25);margin-top:6px">Use the Chat Logs tab in your bot dashboard to save message snippets.</div>
    </div>
    <% } %>

    <div class="snip-grid">
      <% snippets.forEach(function(s){ %>
      <div class="snip-card">
        <div class="snip-card-title">#<%= s.id %> — <%= s.label||'(untitled)' %></div>
        <div class="snip-card-meta">
          <%= s.msg_count %> messages
          <% if(s.channel_name){ %> · #<%= s.channel_name %><% } %>
          <% if(s.guild_name){ %> · <%= s.guild_name %><% } %>
        </div>
        <div class="snip-card-meta"><%= new Date(s.created_at).toLocaleDateString('en-GB') %></div>
        <div class="snip-card-actions">
          <button class="btn btn-primary btn-sm" onclick="viewSnippet(<%= s.id %>)">View</button>
          <form method="POST" action="/admin/moderation/snippets/<%= s.id %>/delete" class="inline-form"
                onsubmit="return confirm('Delete this snippet?')">
            <button class="btn btn-danger btn-sm">Delete</button>
          </form>
        </div>
      </div>
      <% }); %>
    </div>
  </div>

</div><!-- /mod-wrap -->


<!-- ═══════════════════ SLIDE-IN PANEL ═══════════════════ -->
<div class="panel-overlay" id="panelOverlay" onclick="closePanel()"></div>
<div class="slide-panel" id="slidePanel">
  <div class="panel-head">
    <div class="panel-head-title">New Report</div>
    <button class="btn btn-ghost btn-sm" onclick="closePanel()">✕ Close</button>
  </div>
  <div class="panel-body">
    <form method="POST" action="/admin/moderation/reports/add" id="reportForm" enctype="multipart/form-data">

      <!-- Report type -->
      <div class="form-group">
        <label class="form-label">Report Type</label>
        <div class="type-cards">
          <div class="type-card selected" onclick="selectType('ticket',this)">
            <div class="type-card-icon">🎟️</div>
            <div class="type-card-name">Ticket</div>
            <div class="type-card-desc">Discord ticket</div>
          </div>
          <div class="type-card" onclick="selectType('player',this)">
            <div class="type-card-icon">🎮</div>
            <div class="type-card-name">In-Game</div>
            <div class="type-card-desc">Server incident</div>
          </div>
          <div class="type-card gen" onclick="selectType('general',this)">
            <div class="type-card-icon">📝</div>
            <div class="type-card-name">General</div>
            <div class="type-card-desc">Other report</div>
          </div>
        </div>
        <input type="hidden" name="type" id="reportType" value="ticket">
      </div>

      <!-- Player -->
      <div class="form-group">
        <label class="form-label">Player</label>
        <div class="form-row">
          <input type="text" name="player_discord_id" id="panelDiscordId" class="form-input" placeholder="Discord ID" required>
          <input type="text" name="player_discord_tag" id="panelDiscordTag" class="form-input" placeholder="username or tag" required>
        </div>
        <!-- In-game only -->
        <div id="playerIgnRow" style="display:none;margin-top:8px">
          <input type="text" name="player_ign" class="form-input" placeholder="In-game username (optional)">
        </div>
      </div>

      <!-- In-game fields -->
      <div id="ingameFields" style="display:none">
        <div class="form-row form-group">
          <div>
            <label class="form-label">Incident Type</label>
            <select name="incident_type" class="form-select">
              <option value="cheating">Cheating</option>
              <option value="griefing">Griefing</option>
              <option value="harassment">Harassment</option>
              <option value="exploit">Exploit</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div>
            <label class="form-label">Location</label>
            <input type="text" name="location" class="form-input" placeholder="Server / coords (optional)">
          </div>
        </div>
      </div>

      <!-- Summary -->
      <div class="form-group">
        <label class="form-label">Summary *</label>
        <textarea name="summary" id="panelSummary" class="form-textarea" placeholder="Describe what happened…" required></textarea>
      </div>

      <!-- Action + Severity -->
      <div class="form-row form-group">
        <div>
          <label class="form-label">Action Taken</label>
          <select name="action_taken" class="form-select">
            <option value="warning">Warning</option>
            <option value="mute">Mute</option>
            <option value="kick">Kick</option>
            <option value="ban">Ban</option>
            <option value="watchlist">Watchlist</option>
            <option value="none">None</option>
          </select>
        </div>
        <div>
          <label class="form-label">Severity</label>
          <select name="severity" class="form-select">
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        </div>
      </div>

      <!-- Staff -->
      <div class="form-group">
        <label class="form-label">Staff Involved</label>
        <input type="text" name="staff_involved" class="form-input" placeholder="Names of staff involved (optional)">
      </div>

      <!-- Notes -->
      <div class="form-group">
        <label class="form-label">Additional Notes</label>
        <textarea name="notes" class="form-textarea" style="min-height:60px" placeholder="Optional internal notes…"></textarea>
      </div>

      <!-- Multi-snippet picker -->
      <div class="form-group">
        <label class="form-label">Chat Evidence (Snippets)</label>
        <div class="snip-chips" id="selectedChips">
          <!-- chips added here -->
        </div>
        <input type="text" id="snipSearch" class="form-input" placeholder="Search snippets…" oninput="filterSnipRows()" style="margin-bottom:8px">
        <div class="snip-picker-list" id="snipPickerList">
          <% if(!snippets.length){ %>
          <div style="padding:16px;text-align:center;font-family:'Baloo 2';font-size:12px;color:rgba(255,255,255,.3)">No snippets in library yet</div>
          <% } %>
          <% snippets.forEach(function(s){ %>
          <div class="snip-row" data-sid="<%= s.id %>"
               data-label="<%= (s.label||'').toLowerCase() %>"
               data-meta="<%= (s.channel_name||'').toLowerCase() %> <%= (s.guild_name||'').toLowerCase() %>"
               onclick="toggleSnip(<%= s.id %>,'<%= (s.label||'Snippet #'+s.id).replace(/'/g,\\'') %>')">
            <span style="font-size:16px">💬</span>
            <div style="flex:1;min-width:0">
              <div class="snip-row-name">#<%= s.id %> — <%= s.label||'(untitled)' %></div>
              <div class="snip-row-meta"><%= s.msg_count %> msgs<% if(s.channel_name){ %> · #<%= s.channel_name %><% } %><% if(s.guild_name){ %> · <%= s.guild_name %><% } %></div>
            </div>
            <span class="snip-row-check" style="font-size:16px;color:#74c0fc;display:none">✓</span>
          </div>
          <% }); %>
        </div>
        <!-- hidden inputs injected by JS -->
        <div id="snipHiddenInputs"></div>
      </div>

      <!-- AI summarize -->
      <div class="form-group" id="aiSumGroup" style="display:none">
        <button type="button" class="btn btn-ai" onclick="aiSummarize()" id="aiSumBtn">✦ AI Summarize Selected Snippets</button>
        <div class="ai-result" id="aiResult">
          <div class="ai-box-label" style="color:#c084fc;font-family:'Baloo 2';font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px">AI Summary</div>
          <div class="ai-result-text" id="aiResultText"></div>
          <button type="button" class="btn btn-ghost btn-sm" style="margin-top:8px" onclick="useAiSummary()">Use as Summary</button>
        </div>
      </div>

      <!-- File evidence -->
      <div class="form-group">
        <label class="form-label">Attach Files (optional)</label>
        <input type="file" name="files" accept="image/*,video/*" multiple style="font-size:12px;color:rgba(255,255,255,.4)">
      </div>

      <!-- URL evidence -->
      <div class="form-group">
        <label class="form-label">Link Evidence (optional)</label>
        <div class="form-row">
          <input type="url" name="url" class="form-input" placeholder="https://…">
          <input type="text" name="url_label" class="form-input" placeholder="Label (optional)">
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px">Submit Report</button>
    </form>
  </div>
</div>

<!-- ═══════════════════ SNIPPET VIEWER MODAL ═══════════════════ -->
<div id="snippetModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:1000;align-items:center;justify-content:center">
  <div style="background:#15161f;border:1px solid rgba(255,255,255,.1);border-radius:14px;width:min(660px,95vw);max-height:80vh;display:flex;flex-direction:column;overflow:hidden">
    <div style="display:flex;align-items:center;gap:12px;padding:18px 22px;border-bottom:1px solid rgba(255,255,255,.08)">
      <span style="font-family:'Baloo 2';font-weight:900;font-size:16px;color:#e0e2ed;flex:1" id="snipModalTitle">Snippet</span>
      <button class="btn btn-ghost btn-sm" onclick="document.getElementById('snippetModal').style.display='none'">✕ Close</button>
    </div>
    <div id="snipModalBody" style="overflow-y:auto;padding:16px 22px;flex:1"></div>
  </div>
</div>

<script>
// ── Tab switching ──
function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  btn.classList.add('active');
  location.hash = name;
}

// ── Card expand/collapse ──
function toggleCard(header) {
  const body = header.nextElementSibling;
  body.classList.toggle('open');
  const arrow = header.querySelector('span:last-child');
  if (arrow) arrow.textContent = body.classList.contains('open') ? '▲' : '▼';
}

// ── Filter flags ──
function filterFlags(state, btn) {
  document.querySelectorAll('#tab-flagged .filter-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#tab-flagged .card').forEach(c => {
    const s = c.dataset.flagState;
    c.style.display = (state === 'all' || s === state) ? '' : 'none';
  });
}

// ── Filter reports ──
function filterReports(type, btn) {
  document.querySelectorAll('#tab-reports .filter-pill').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('#tab-reports .card[data-rtype]').forEach(c => {
    c.style.display = (type === 'all' || c.dataset.rtype === type) ? '' : 'none';
  });
}

// ── Slide-in panel ──
function openPanel() {
  document.getElementById('panelOverlay').classList.add('open');
  document.getElementById('slidePanel').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closePanel() {
  document.getElementById('panelOverlay').classList.remove('open');
  document.getElementById('slidePanel').classList.remove('open');
  document.body.style.overflow = '';
}
function prefillPanel(discordId, discordTag) {
  openPanel();
  document.getElementById('panelDiscordId').value = discordId || '';
  document.getElementById('panelDiscordTag').value = discordTag || '';
}

// ── Report type selection ──
function selectType(type, card) {
  document.querySelectorAll('.type-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  document.getElementById('reportType').value = type;
  const ingame = type === 'player';
  document.getElementById('ingameFields').style.display = ingame ? '' : 'none';
  document.getElementById('playerIgnRow').style.display = ingame ? '' : 'none';
}

// ── Multi-snippet picker ──
const selectedSnips = {};
function toggleSnip(id, label) {
  const row = document.querySelector(`.snip-row[data-sid="${id}"]`);
  if (selectedSnips[id]) {
    delete selectedSnips[id];
    row && row.classList.remove('added');
    const check = row && row.querySelector('.snip-row-check');
    if (check) check.style.display = 'none';
    const chip = document.getElementById('chip-' + id);
    if (chip) chip.remove();
    const inp = document.getElementById('snipInp-' + id);
    if (inp) inp.remove();
  } else {
    selectedSnips[id] = label;
    row && row.classList.add('added');
    const check = row && row.querySelector('.snip-row-check');
    if (check) check.style.display = '';

    const chip = document.createElement('span');
    chip.className = 'snip-chip'; chip.id = 'chip-' + id;
    chip.innerHTML = `💬 ${label} <button type="button" class="snip-chip-rm" onclick="toggleSnip(${id},'')">✕</button>`;
    document.getElementById('selectedChips').appendChild(chip);

    const inp = document.createElement('input');
    inp.type = 'hidden'; inp.name = 'snippet_ids[]'; inp.value = id; inp.id = 'snipInp-' + id;
    document.getElementById('snipHiddenInputs').appendChild(inp);
  }
  const count = Object.keys(selectedSnips).length;
  document.getElementById('aiSumGroup').style.display = count > 0 ? '' : 'none';
}
function filterSnipRows() {
  const q = document.getElementById('snipSearch').value.toLowerCase();
  document.querySelectorAll('.snip-row').forEach(r => {
    const match = (r.dataset.label + ' ' + r.dataset.meta + ' ' + r.dataset.sid).includes(q);
    r.style.display = match ? '' : 'none';
  });
}

// ── AI Summarize ──
async function aiSummarize() {
  const btn = document.getElementById('aiSumBtn');
  const ids = Object.keys(selectedSnips);
  if (!ids.length) return;
  btn.textContent = '⏳ Summarizing…'; btn.disabled = true;
  try {
    const r = await fetch('/admin/moderation/summarize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ snippet_ids: ids.map(Number) })
    });
    const data = await r.json();
    if (data.error) throw new Error(data.error);
    document.getElementById('aiResultText').textContent = data.summary || '';
    document.getElementById('aiResult').classList.add('show');
  } catch(e) {
    document.getElementById('aiResultText').textContent = 'Error: ' + e.message;
    document.getElementById('aiResult').classList.add('show');
  }
  btn.textContent = '✦ AI Summarize Selected Snippets'; btn.disabled = false;
}
function useAiSummary() {
  const text = document.getElementById('aiResultText').textContent;
  document.getElementById('panelSummary').value = text;
}

// ── Snippet viewer modal ──
async function viewSnippet(id) {
  document.getElementById('snippetModal').style.display = 'flex';
  document.getElementById('snipModalTitle').textContent = 'Loading…';
  document.getElementById('snipModalBody').innerHTML = '<div style="padding:20px;text-align:center;color:rgba(255,255,255,.3)">Loading…</div>';
  try {
    const r = await fetch('/admin/moderation/snippets/' + id);
    const data = await r.json();
    document.getElementById('snipModalTitle').textContent = data.label || ('Snippet #' + id);
    const msgs = data.messages || [];
    if (!msgs.length) {
      document.getElementById('snipModalBody').innerHTML = '<div style="padding:20px;text-align:center;color:rgba(255,255,255,.3)">No messages</div>';
      return;
    }
    document.getElementById('snipModalBody').innerHTML = msgs.map(m => `
      <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid rgba(255,255,255,.05)">
        <img src="${m.avatar_url||''}" style="width:28px;height:28px;border-radius:50%;flex-shrink:0;background:rgba(255,255,255,.08)" onerror="this.style.visibility='hidden'">
        <div>
          <div style="font-family:'Baloo 2';font-weight:800;font-size:12px;color:#e0e2ed">${escHtml(m.username||'Unknown')}
            <span style="font-size:10px;color:rgba(255,255,255,.3);margin-left:6px">${m.timestamp ? new Date(m.timestamp).toLocaleString('en-GB') : ''}</span>
          </div>
          <div style="font-size:13px;color:#c9ccdb;line-height:1.6;white-space:pre-wrap;word-break:break-word">${escHtml(m.content||'')}</div>
        </div>
      </div>`).join('');
  } catch(e) {
    document.getElementById('snipModalBody').innerHTML = `<div style="padding:20px;text-align:center;color:#f87171">Error: ${e.message}</div>`;
  }
}
function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Init: restore tab from hash ──
(function() {
  const hash = location.hash.replace('#','');
  const valid = ['flagged','bans','reports','evidence'];
  if (valid.includes(hash)) {
    const btn = document.querySelector(`.tab-btn[onclick*="switchTab('${hash}'"]`);
    if (btn) switchTab(hash, btn);
  }
})();
</script>

