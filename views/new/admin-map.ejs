<%- include('partials/head', { pageTitle: 'Map Viewer' }) %>
<%- include('partials/header') %>

<style>
#mv-root{position:fixed;top:64px;left:0;right:0;bottom:0;background:#0c0d10;display:flex;flex-direction:column;overflow:hidden}
/* Load panel */
#mv-load{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:20px;padding:40px}
#mv-load h2{font-family:'Baloo 2';font-weight:800;font-size:22px;color:#e0e2ed;margin:0}
#mv-load p{font-size:13px;color:var(--muted);margin:0;max-width:480px;text-align:center;line-height:1.7}
.mv-drop{border:2px dashed rgba(255,255,255,.15);border-radius:16px;padding:40px 60px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
.mv-drop:hover,.mv-drop.dragover{border-color:rgba(91,227,143,.5);background:rgba(91,227,143,.04)}
.mv-drop input{display:none}
.mv-drop-icon{font-size:40px;margin-bottom:12px;opacity:.5}
.mv-drop-label{font-family:'Baloo 2';font-weight:700;font-size:14px;color:#c9ccdb}
.mv-drop-sub{font-size:12px;color:var(--muted);margin-top:4px}
.mv-files-hint{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;padding:14px 18px;font-size:12px;color:var(--muted);font-family:monospace;text-align:left;line-height:1.8}
/* Viewer layout */
#mv-viewer{display:none;flex:1;position:relative;overflow:hidden;flex-direction:column}
#mv-canvas{display:block;width:100%!important;height:100%!important;flex:1}
/* Progress overlay */
#mv-progress{display:none;position:absolute;inset:0;background:rgba(12,13,16,.92);z-index:200;flex-direction:column;align-items:center;justify-content:center;gap:14px}
#mv-progress p{font-family:'Baloo 2';font-weight:700;font-size:14px;color:#e0e2ed;margin:0}
.mv-prog-bar{width:260px;height:4px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden}
.mv-prog-fill{height:100%;width:60%;background:linear-gradient(90deg,#22863a,#5be38f);border-radius:4px;animation:mvprog 1.2s ease-in-out infinite alternate}
@keyframes mvprog{from{width:20%}to{width:80%}}
/* Toolbar */
#mv-toolbar{position:absolute;top:14px;left:14px;z-index:10;display:flex;flex-direction:column;gap:6px}
.mv-tool{background:rgba(17,18,22,.9);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-family:'Baloo 2';font-weight:700;font-size:12px;color:var(--muted);cursor:pointer;white-space:nowrap;transition:border-color .15s,color .15s}
.mv-tool:hover{border-color:rgba(91,227,143,.4);color:#c9ccdb}
.mv-tool.active{border-color:rgba(91,227,143,.6);color:#5be38f;background:rgba(91,227,143,.06)}
/* Coords */
#mv-coords{position:absolute;bottom:14px;left:14px;z-index:10;background:rgba(17,18,22,.85);border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-family:monospace;font-size:12px;color:#c9ccdb}
/* Info panel */
#mv-panel{position:absolute;top:14px;right:14px;z-index:10;width:220px;background:rgba(17,18,22,.92);border:1px solid var(--line);border-radius:12px;overflow:hidden}
#mv-panel-header{padding:10px 14px;font-family:'Baloo 2';font-weight:800;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
#mv-plan-list{max-height:320px;overflow-y:auto;padding:6px}
.mv-plan-item{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:6px;font-family:'Baloo 2';font-weight:700;font-size:12px;color:#c9ccdb}
.mv-plan-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.mv-plan-del{margin-left:auto;cursor:pointer;color:var(--muted);font-size:10px;opacity:.6}
.mv-plan-del:hover{opacity:1;color:#f87171}
#mv-panel-actions{padding:8px;border-top:1px solid var(--line);display:flex;gap:6px}
.mv-act{flex:1;background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:6px;padding:5px 0;font-family:'Baloo 2';font-weight:700;font-size:11px;color:var(--muted);cursor:pointer;text-align:center}
.mv-act:hover{background:rgba(255,255,255,.09);color:#e0e2ed}
/* Poly finish button */
#mv-poly-finish{display:none;position:absolute;bottom:50px;left:50%;transform:translateX(-50%);z-index:20;background:#22863a;color:#fff;border:none;border-radius:8px;padding:8px 22px;font-family:'Baloo 2';font-weight:800;font-size:13px;cursor:pointer}
/* Label input */
#mv-label-input{display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:30;background:rgba(17,18,22,.96);border:1px solid var(--line);border-radius:12px;padding:20px;min-width:260px}
#mv-label-input input{width:100%;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-family:'Baloo 2';font-weight:700;font-size:14px;color:#fff;outline:none;box-sizing:border-box}
#mv-label-input .mv-li-btns{display:flex;gap:8px;margin-top:10px}
#mv-label-input button{flex:1;padding:7px;border-radius:7px;font-family:'Baloo 2';font-weight:800;font-size:12px;cursor:pointer;border:none}
</style>

<div id="mv-root">
  <!-- Progress overlay (covers whole root) -->
  <div id="mv-progress">
    <p id="mv-prog-text">Loading…</p>
    <div class="mv-prog-bar"><div class="mv-prog-fill"></div></div>
    <p id="mv-prog-err" style="color:#f87171;font-size:12px;max-width:400px;text-align:center;display:none"></p>
  </div>

  <!-- ── File load panel ── -->
  <div id="mv-load">
    <h2>Map Viewer</h2>
    <p>Load your scanner output to view the world in 3D. Optionally include the block textures folder for textured rendering.</p>
    <div class="mv-drop" id="mv-drop">
      <input type="file" id="mv-file-input" multiple accept=".json,.png,.bin" style="display:none">
      <input type="file" id="mv-folder-input" webkitdirectory style="display:none">
      <div class="mv-drop-icon">📂</div>
      <div class="mv-drop-label">Drop the scan3d-output folder here</div>
      <div class="mv-drop-sub" style="margin-bottom:14px">Or use one of the buttons below</div>
      <div style="display:flex;gap:10px;justify-content:center">
        <button onclick="event.stopPropagation();document.getElementById('mv-folder-input').click()" style="background:rgba(91,227,143,.12);border:1px solid rgba(91,227,143,.3);color:#5be38f;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:8px 18px;border-radius:8px;cursor:pointer">Select Folder</button>
        <button onclick="event.stopPropagation();document.getElementById('mv-file-input').click()" style="background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--muted);font-family:'Baloo 2';font-weight:700;font-size:13px;padding:8px 18px;border-radius:8px;cursor:pointer">Select Files</button>
      </div>
    </div>
    <div class="mv-files-hint">
      Required: meta.json &nbsp;·&nbsp; palette.json &nbsp;·&nbsp; biome_palette.json<br>
      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; heightmap.png &nbsp;·&nbsp; blocks.bin &nbsp;·&nbsp; biomes.bin<br>
      Optional: block texture PNGs (e.g. stone.png, grass_block_top.png …)
    </div>
  </div>

  <!-- ── 3D viewer ── -->
  <div id="mv-viewer">
    <canvas id="mv-canvas"></canvas>

    <div id="mv-toolbar">
      <div class="mv-tool" id="tool-nav" onclick="setTool('nav')">✦ Navigate</div>
      <div style="height:6px"></div>
      <div class="mv-tool" onclick="setTool('spawn')">⊕ Spawn Zone</div>
      <div class="mv-tool" onclick="setTool('mining')">⊕ Mining Zone</div>
      <div class="mv-tool" onclick="setTool('contested')">⊕ Contested Zone</div>
      <div class="mv-tool" onclick="setTool('polygon')">⬡ Draw Border</div>
      <div class="mv-tool" onclick="setTool('label')">T Label</div>
      <div style="height:6px"></div>
      <div class="mv-tool" onclick="exportPNG()">↓ Export PNG</div>
    </div>

    <div id="mv-coords">X: — &nbsp;Y: — &nbsp;Z: —</div>
    <div id="mv-stats" style="position:absolute;bottom:14px;right:14px;z-index:10;background:rgba(17,18,22,.85);border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-family:monospace;font-size:11px;color:var(--muted);line-height:1.6"></div>

    <div id="mv-panel">
      <div id="mv-panel-header">
        Plan
        <span id="mv-plan-count" style="font-weight:600;color:var(--muted)">0 items</span>
      </div>
      <div id="mv-plan-list"></div>
      <div id="mv-panel-actions">
        <div class="mv-act" onclick="savePlan()">Save JSON</div>
        <div class="mv-act" onclick="document.getElementById('mv-plan-file').click()">Load JSON</div>
        <input type="file" id="mv-plan-file" accept=".json" style="display:none" onchange="loadPlanFile(this)">
      </div>
    </div>

    <button id="mv-poly-finish" onclick="finishPolygon()">Finish Border</button>

    <div id="mv-label-input">
      <input id="mv-label-text" type="text" placeholder="Enter label text…" onkeydown="if(event.key==='Enter')confirmLabel()">
      <div class="mv-li-btns">
        <button onclick="confirmLabel()" style="background:#22863a;color:#fff">Add</button>
        <button onclick="cancelLabel()" style="background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--muted)">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/upng-js@2.1.0/UPNG.js"></script>
<script>
(function () {
'use strict';

// ── Constants ─────────────────────────────────────────────────────────────────
const CHUNK = 32;
const RENDER_DIST = 12; // chunks
const ATLAS = 512;      // atlas texture side (pixels)
const TEX = 16;         // block texture size

// ── World state ───────────────────────────────────────────────────────────────
let meta, paletteArr, biomePal;
let heights, surface, skirtArr, waterArr, biomes;
let W = 0, H = 0, minY = 0, skirtDepth = 4;

// ── Three.js ──────────────────────────────────────────────────────────────────
let scene, camera, renderer;
let solidMat, waterMat, planeMat;
let solidGroup, waterGroup, planGroup;
let chunks = new Map();
let chunkQueue = [];
let animId = null;

// ── Textures ──────────────────────────────────────────────────────────────────
let atlasTex = null;
let uvCache = {};    // texName -> [u0,v0,u1,v1]
let blockUV = {};    // blockId -> {top,side,bottom} each [u0,v0,u1,v1]
let blockCol = {};   // blockId -> THREE.Color (fallback)

// ── Camera ────────────────────────────────────────────────────────────────────
const cam = { theta: 0.6, phi: 1.0, r: 400, tx: 0, ty: 0, tz: 0 };
const keys = {};
let dragging = false, dragBtn = -1, lx = 0, ly = 0;
let pendingLabelPos = null;

// ── Planning ──────────────────────────────────────────────────────────────────
let planMode = 'nav';
let polyPts = [], polyLine = null;
let plan = { markers: [], polygons: [], labels: [] };
const raycaster = new THREE.Raycaster();
const planColors = { spawn: '#5be38f', mining: '#fbbf24', contested: '#f87171', polygon: '#74c0fc', label: '#e0e2ed' };

// ══════════════════════════════════════════════════════════════════════════════
// FILE UI
// ══════════════════════════════════════════════════════════════════════════════

const drop = document.getElementById('mv-drop');
const fileInput = document.getElementById('mv-file-input');
const folderInput = document.getElementById('mv-folder-input');

drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('dragover'); });
drop.addEventListener('dragleave', () => drop.classList.remove('dragover'));
drop.addEventListener('drop', async e => {
  e.preventDefault(); drop.classList.remove('dragover');
  const map = new Map();
  const items = [...(e.dataTransfer.items || [])];
  await Promise.all(items.map(item => {
    if (item.kind !== 'file') return;
    const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
    if (entry && entry.isDirectory) return readDir(entry, map);
    const f = item.getAsFile();
    if (f) map.set(f.name, f);
  }));
  startLoad(map);
});

fileInput.addEventListener('change', () => {
  const map = new Map();
  for (const f of fileInput.files) map.set(f.name, f);
  startLoad(map);
});
folderInput.addEventListener('change', () => {
  const map = new Map();
  for (const f of folderInput.files) map.set(f.name, f);
  startLoad(map);
});

function readDir(dirEntry, map) {
  return new Promise(res => {
    const reader = dirEntry.createReader();
    const readAll = () => reader.readEntries(async entries => {
      if (!entries.length) return res();
      await Promise.all(entries.map(e => e.isDirectory ? readDir(e, map) : new Promise(r => e.file(f => { map.set(f.name, f); r(); }))));
      readAll();
    });
    readAll();
  });
}

function startLoad(map) {
  const required = ['meta.json','palette.json','biome_palette.json','heightmap.png','blocks.bin','biomes.bin'];
  const missing = required.filter(r => !map.has(r));
  if (missing.length) { alert('Missing required files:\n' + missing.join('\n')); return; }
  loadWorld(map);
}

// ══════════════════════════════════════════════════════════════════════════════
// DATA LOADING
// ══════════════════════════════════════════════════════════════════════════════

async function loadWorld(files) {
  try {
    showProgress(true, 'Parsing JSON…');
    meta = JSON.parse(await files.get('meta.json').text());
    const rawPalette = JSON.parse(await files.get('palette.json').text());
    const rawBiome   = JSON.parse(await files.get('biome_palette.json').text());

    // Normalise palette to array of {id, name, textures}
    paletteArr = Array.isArray(rawPalette)
      ? rawPalette
      : Object.entries(rawPalette).map(([k, v]) =>
          typeof v === 'object' ? { id: isNaN(k) ? v.id ?? k : +k, name: v.name ?? k, textures: v.textures, ...v }
                                : { id: +k, name: String(v) });
    // Normalise biome palette to array of {id, ...}
    biomePal = Array.isArray(rawBiome)
      ? rawBiome
      : Object.entries(rawBiome).map(([k, v]) =>
          typeof v === 'object' ? { id: isNaN(k) ? v.id ?? k : +k, ...v }
                                : { id: +k, name: String(v) });

    console.log('meta:', JSON.stringify(meta));

    W = meta.width ?? meta.worldWidth ?? meta.sizeX ?? meta.size ?? 0;
    H = meta.height ?? meta.worldHeight ?? meta.worldDepth ?? meta.depth ?? meta.length ?? meta.sizeZ ?? meta.worldLength ?? W;
    minY = meta.minHeight ?? meta.minY ?? meta.minY ?? -64;
    skirtDepth = meta.skirtDepth ?? meta.skirtSize ?? 4;

    if (!W || !H) throw new Error(`Could not read world dimensions. meta.json keys: ${Object.keys(meta).join(', ')}`);

    showProgress(true, 'Loading heightmap…');
    heights = await parseHeightmap(files.get('heightmap.png'));

    showProgress(true, 'Parsing blocks.bin…');
    const bl = parseBlocksBin(await files.get('blocks.bin').arrayBuffer());
    surface = bl.surface; skirtArr = bl.skirt; waterArr = bl.water;

    showProgress(true, 'Parsing biomes.bin…');
    biomes = parseBiomesBin(await files.get('biomes.bin').arrayBuffer());

    buildBlockColors();

    // Compute center terrain height for camera positioning
    const ci = Math.floor(H / 2) * W + Math.floor(W / 2);
    const centerH = isFinite(heights[ci]) ? heights[ci] : 64;
    const nonZeroBlocks = [surface[ci], surface[ci+1], surface[ci+2], surface[ci-1], surface[ci-2]].filter(Boolean);

    // Debug dump — visible in F12 console
    console.log('[MapViewer] World:', W, 'x', H, '| minY:', minY, '| skirtDepth:', skirtDepth);
    console.log('[MapViewer] Center height:', centerH, '| Center block IDs:', surface[ci], surface[ci+1], surface[ci+2]);
    console.log('[MapViewer] Height range:', Math.min(...Array.from(heights).slice(0,1000)), '-', Math.max(...Array.from(heights).slice(0,1000)));
    console.log('[MapViewer] Palette entries 0-5:', paletteArr.slice(0,6).map(b=>`${b.id}:${b.name}`).join(', '));
    console.log('[MapViewer] Surface sample (first 10):', Array.from(surface.slice(0, 10)).join(','));
    console.log('[MapViewer] heights sample (first 10):', Array.from(heights.slice(0, 10)).join(','));

    // Optional textures
    const texFiles = [...files].filter(([k]) => k.endsWith('.png') && k !== 'heightmap.png');
    if (texFiles.length) {
      showProgress(true, `Building texture atlas (${texFiles.length} textures)…`);
      await buildAtlas(texFiles.map(([,f]) => f));
    }

    showProgress(true, 'Initialising scene…');
    // Show viewer first so the canvas has real dimensions before Three.js inits
    document.getElementById('mv-load').style.display = 'none';
    document.getElementById('mv-viewer').style.display = 'flex';
    await new Promise(r => requestAnimationFrame(r));
    initScene(centerH);
    showProgress(false);
    setTool('nav');
    animate();
  } catch (err) {
    console.error('Map load error:', err);
    showProgress(true, 'Failed to load — check the browser console (F12) for details', String(err));
  }
}

async function parseHeightmap(file) {
  const ab = await file.arrayBuffer();
  try {
    // Try 16-bit via UPNG
    const png = UPNG.decode(ab);
    if (png.depth === 16 && (png.ctype === 0 || png.ctype === 4)) {
      const dv = new DataView(png.data.buffer ?? png.data);
      const ch = png.ctype === 4 ? 2 : 1; // gray-alpha or gray
      const out = new Float32Array(png.width * png.height);
      for (let i = 0; i < out.length; i++) out[i] = dv.getUint16(i * ch * 2, false) + minY;
      return out;
    }
  } catch (_) {}
  // Fallback: canvas 8-bit
  return new Promise(res => {
    const img = new Image();
    img.onload = () => {
      const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
      const ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0);
      const d = ctx.getImageData(0, 0, img.width, img.height).data;
      const out = new Float32Array(img.width * img.height);
      for (let i = 0; i < out.length; i++) {
        out[i] = ((d[i*4] << 8) | d[i*4+1]) + minY;
      }
      URL.revokeObjectURL(img.src); res(out);
    };
    img.src = URL.createObjectURL(file);
  });
}

function parseBlocksBin(ab) {
  const dv = new DataView(ab);
  let off = 4; // skip big-endian int32 header
  const cols = W * H;
  const strideBytes = 2 + skirtDepth * 2 + 2; // surfaceId + skirt[] + waterY
  const surf = new Uint16Array(cols);
  const sk   = new Uint16Array(cols * skirtDepth);
  const wat  = new Int16Array(cols);
  for (let i = 0; i < cols; i++, off += strideBytes) {
    surf[i] = dv.getUint16(off, false);
    for (let d = 0; d < skirtDepth; d++) sk[i * skirtDepth + d] = dv.getUint16(off + 2 + d * 2, false);
    wat[i] = dv.getInt16(off + 2 + skirtDepth * 2, false);
  }
  return { surface: surf, skirt: sk, water: wat };
}

function parseBiomesBin(ab) {
  // row-major z outer/x inner, u16 per column, no header
  return new Uint16Array(ab);
}

// ══════════════════════════════════════════════════════════════════════════════
// BLOCK COLORS + TEXTURE ATLAS
// ══════════════════════════════════════════════════════════════════════════════

const DEFAULT_COLORS = {
  air:0,stone:'#9a9a9a',granite:'#9c6a5d',diorite:'#c8c8c8',andesite:'#8a8a8a',
  grass_block:'#7ab648',dirt:'#8b5e3c',coarse_dirt:'#7a5238',gravel:'#9b9b9b',
  sand:'#dbd4a0',sandstone:'#d5c987',cobblestone:'#858585',oak_log:'#6e4f2a',
  oak_leaves:'#5d9c31',birch_log:'#d5cebc',birch_leaves:'#7aaa48',
  spruce_log:'#4a3320',spruce_leaves:'#3b5c2f',jungle_log:'#5a3c1a',
  jungle_leaves:'#4c8c1a',acacia_log:'#684d2e',acacia_leaves:'#6a9c2c',
  water:'#3f76e4',lava:'#e06020',bedrock:'#4a4a4a',coal_ore:'#808080',
  iron_ore:'#9a8070',gold_ore:'#a89040',diamond_ore:'#40a0a0',
  emerald_ore:'#40a060',snow:'#ffffff',ice:'#80b0ff',clay:'#9090a0',
  gravel_path:'#a09060',farmland:'#7a5030',hay_block:'#c0a020',
  pumpkin:'#d08020',melon:'#80a040',cactus:'#4a8030',
};

function buildBlockColors() {
  for (const b of paletteArr) {
    const col = DEFAULT_COLORS[b.name] || '#888888';
    blockCol[b.id] = typeof col === 'number' ? null : new THREE.Color(col);
  }
}

async function buildAtlas(texFiles) {
  const c = document.createElement('canvas');
  c.width = c.height = ATLAS;
  const ctx = c.getContext('2d');
  ctx.imageSmoothingEnabled = false;
  let slot = 0;
  const nameMap = {};
  await Promise.all(texFiles.map(f => new Promise(res => {
    const img = new Image();
    img.onload = () => {
      const col = slot % (ATLAS / TEX), row = Math.floor(slot / (ATLAS / TEX));
      ctx.drawImage(img, col * TEX, row * TEX, TEX, TEX);
      const texName = f.name.replace(/\.png$/i, '');
      nameMap[texName] = slot;
      slot++;
      URL.revokeObjectURL(img.src); res();
    };
    img.onerror = res;
    img.src = URL.createObjectURL(f);
  })));

  atlasTex = new THREE.CanvasTexture(c);
  atlasTex.magFilter = THREE.NearestFilter;
  atlasTex.minFilter = THREE.NearestMipmapLinearFilter;
  atlasTex.generateMipmaps = true;
  uvCache = {};
  for (const [name, s] of Object.entries(nameMap)) {
    const col = s % (ATLAS / TEX), row = Math.floor(s / (ATLAS / TEX));
    uvCache[name] = [col * TEX / ATLAS, row * TEX / ATLAS, (col+1) * TEX / ATLAS, (row+1) * TEX / ATLAS];
  }

  for (const b of paletteArr) {
    const tx = b.textures || {};
    const resolve = k => uvCache[tx[k]] || uvCache[b.name] || null;
    blockUV[b.id] = { top: resolve('top') || resolve('all'), side: resolve('side') || resolve('all'), bottom: resolve('bottom') || resolve('all') };
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SCENE INIT
// ══════════════════════════════════════════════════════════════════════════════

function initScene(centerH) {
  const canvas = document.getElementById('mv-canvas');
  const W2 = canvas.parentElement.clientWidth || window.innerWidth;
  const H2 = canvas.parentElement.clientHeight || (window.innerHeight - 64);

  renderer = new THREE.WebGLRenderer({ canvas, antialias: false, logarithmicDepthBuffer: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(W2, H2);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x87ceeb);
  scene.fog = new THREE.Fog(0x87ceeb, 600, 2000);

  camera = new THREE.PerspectiveCamera(70, canvas.clientWidth / canvas.clientHeight, 0.5, 3000);
  // Position camera at center of world, above actual terrain height
  const terrainY = (centerH !== undefined && isFinite(centerH)) ? centerH : 64;
  cam.tx = W / 2; cam.ty = terrainY + 20; cam.tz = H / 2;
  cam.r = 200;
  updateCamera();

  // Lighting
  const amb = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(amb);
  const sun = new THREE.DirectionalLight(0xfffce0, 1.2);
  sun.position.set(200, 400, 100);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  sun.shadow.camera.near = 1; sun.shadow.camera.far = 1500;
  sun.shadow.camera.left = sun.shadow.camera.bottom = -800;
  sun.shadow.camera.right = sun.shadow.camera.top = 800;
  scene.add(sun);

  // Materials
  solidMat = atlasTex
    ? new THREE.MeshLambertMaterial({ map: atlasTex, vertexColors: true })
    : new THREE.MeshLambertMaterial({ vertexColors: true });
  waterMat = new THREE.MeshLambertMaterial({ color: 0x3f76e4, transparent: true, opacity: 0.65, side: THREE.FrontSide });

  solidGroup = new THREE.Group(); scene.add(solidGroup);
  waterGroup = new THREE.Group(); scene.add(waterGroup);
  planGroup  = new THREE.Group(); scene.add(planGroup);

  // Controls
  setupControls(canvas);
  window.addEventListener('resize', () => {
    const rw = canvas.parentElement.clientWidth || window.innerWidth;
    const rh = canvas.parentElement.clientHeight || (window.innerHeight - 64);
    camera.aspect = rw / rh;
    camera.updateProjectionMatrix();
    renderer.setSize(rw, rh);
  });
}

// ══════════════════════════════════════════════════════════════════════════════
// CHUNK MESHING
// ══════════════════════════════════════════════════════════════════════════════

function getBlockAtDepth(idx, depth) {
  // depth 0 = surface, depth 1 = first skirt block, etc.
  if (depth === 0) return surface[idx];
  const d = depth - 1;
  if (d < skirtDepth) return skirtArr[idx * skirtDepth + d];
  return 1; // stone fallback
}

function getUV(blockId, face) {
  const uv = blockUV[blockId];
  if (uv) {
    const v = uv[face] || uv.side || uv.top;
    if (v) return v;
  }
  return null; // use vertex color
}

function getBiomeTint(biomeId, face, blockId) {
  const blockName = paletteArr.find(b => b.id === blockId)?.name || '';
  const biome = biomePal.find ? biomePal.find(b => b.id === biomeId) : (biomePal[biomeId] || null);
  if (!biome) return [1, 1, 1];
  const col = (name => {
    if (/grass_block|short_grass|grass$|fern/.test(name)) return biome.grass_color || biome.grassColor;
    if (/leaves/.test(name)) return biome.foliage_color || biome.foliageColor;
    return null;
  })(blockName);
  if (!col) return [1, 1, 1];
  const c = new THREE.Color(col);
  return [c.r, c.g, c.b];
}

function buildChunk(cx, cz) {
  const key = cx + '_' + cz;
  if (chunks.has(key)) return;
  try {
    _buildChunkInner(cx, cz, key);
  } catch (err) {
    console.error('[MapViewer] buildChunk error at', cx, cz, err);
    chunks.set(key, { solid: null, water: null }); // mark as attempted to avoid retry spam
  }
}
function _buildChunkInner(cx, cz, key) {

  const sx = cx * CHUNK, sz = cz * CHUNK;
  const ex = Math.min(sx + CHUNK, W), ez = Math.min(sz + CHUNK, H);

  // Solid geometry arrays
  const pos = [], norm = [], uv = [], col = [];
  const wpos = [], wnorm = [], wuv = [];

  function addQuad(p0, p1, p2, p3, nx, ny, nz, u0, v0, u1, v1, r, g, b, toSolid) {
    const P = toSolid ? pos : wpos, N = toSolid ? norm : wnorm, U = toSolid ? uv : wuv;
    // p0-p1-p2 and p0-p2-p3
    const verts = [p0, p1, p2, p0, p2, p3];
    // UVs for quad corners
    const uvs = [[u0,v1],[u1,v1],[u1,v0],[u0,v1],[u1,v0],[u0,v0]];
    for (let i = 0; i < 6; i++) {
      P.push(...verts[i]); N.push(nx, ny, nz); U.push(...uvs[i]);
      if (toSolid) col.push(r, g, b);
    }
  }

  function fallbackUV() { return [0, 0, 1/32, 1/32]; } // tiny atlas corner for solid color

  for (let mz = sz; mz < ez; mz++) {
    for (let mx = sx; mx < ex; mx++) {
      const idx = mz * W + mx;
      const my = heights[idx];
      if (!isFinite(my)) continue; // bad height data
      const bid = surface[idx];
      if (!bid) continue; // air
      const water = waterArr[idx];
      const biomeId = biomes[idx];
      const tc = getBiomeTint(biomeId, 'top', bid);
      const bColor = blockCol[bid] || new THREE.Color(0x888888);
      const br = bColor.r, bg = bColor.g, bb = bColor.b;

      // World coords (centered)
      const wx = mx, wy = my, wz = mz;

      // TOP FACE
      {
        const uvv = getUV(bid, 'top') || fallbackUV();
        const cr = atlasTex ? tc[0] : br * tc[0], cg = atlasTex ? tc[1] : bg * tc[1], cb2 = atlasTex ? tc[2] : bb * tc[2];
        addQuad(
          [wx, wy+1, wz], [wx+1, wy+1, wz], [wx+1, wy+1, wz+1], [wx, wy+1, wz+1],
          0, 1, 0, uvv[0], uvv[1], uvv[2], uvv[3], cr, cg, cb2, true
        );
      }

      // SIDE FACES — check 4 neighbours
      const dirs = [
        { dx: 1, dz: 0, nx: 1, nz: 0 },
        { dx:-1, dz: 0, nx:-1, nz: 0 },
        { dx: 0, dz: 1, nx: 0, nz: 1 },
        { dx: 0, dz:-1, nx: 0, nz:-1 },
      ];
      for (const {dx, dz, nx, nz} of dirs) {
        const nx2 = mx + dx, nz2 = mz + dz;
        if (nx2 < 0 || nx2 >= W || nz2 < 0 || nz2 >= H) continue;
        const nidx = nz2 * W + nx2;
        const nh = heights[nidx];
        if (nh >= my) continue; // neighbor is same height or higher; no exposed face

        // Emit faces from nh+1 to my (run-length merged by block)
        let runStart = nh + 1, runBid = getBlockAtDepth(idx, my - runStart);
        for (let y = nh + 2; y <= my; y++) {
          const depth = my - y;
          const b2 = getBlockAtDepth(idx, depth);
          if (b2 !== runBid) {
            emitSideFace(wx, wz, runStart, y - 1, dx, dz, nx, nz, runBid, pos, norm, uv, col);
            runStart = y; runBid = b2;
          }
        }
        emitSideFace(wx, wz, runStart, my, dx, dz, nx, nz, runBid, pos, norm, uv, col);
      }

      // WATER SURFACE
      if (water > my) {
        const wy2 = water;
        wpos.push(wx,wy2+1,wz, wx+1,wy2+1,wz, wx+1,wy2+1,wz+1, wx,wy2+1,wz, wx+1,wy2+1,wz+1, wx,wy2+1,wz+1);
        for (let i=0;i<6;i++) { wnorm.push(0,1,0); wuv.push(0,0); }
      }
    }
  }

  function makeGeo(p, n, u, c) {
    if (!p.length) return null;
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(p), 3));
    geo.setAttribute('normal',   new THREE.BufferAttribute(new Float32Array(n), 3));
    geo.setAttribute('uv',       new THREE.BufferAttribute(new Float32Array(u), 2));
    if (c) geo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(c), 3));
    return geo;
  }

  const solidGeo = makeGeo(pos, norm, uv, col);
  const waterGeo = makeGeo(wpos, wnorm, wuv, null);

  const solidMesh = solidGeo ? new THREE.Mesh(solidGeo, solidMat) : null;
  const waterMesh = waterGeo ? new THREE.Mesh(waterGeo, waterMat) : null;
  if (solidMesh) { solidMesh.receiveShadow = true; solidGroup.add(solidMesh); }
  if (waterMesh) waterGroup.add(waterMesh);

  chunks.set(key, { solid: solidMesh, water: waterMesh });
}

function emitSideFace(wx, wz, yBot, yTop, dx, dz, nx, nz, bid, pos, norm, uv, col) {
  const uvv = getUV(bid, 'side') || getUV(bid, 'top') || [0, 0, 1/32, 1/32];
  const bColor = blockCol[bid] || new THREE.Color(0x888888);
  const r = bColor.r, g = bColor.g, b = bColor.b;
  // Determine the 4 corners of the side face quad
  let p0, p1, p2, p3;
  const h = yTop - yBot + 1;
  if (dx === 1) {
    p0 = [wx+1, yBot,   wz  ]; p1 = [wx+1, yBot,   wz+1];
    p2 = [wx+1, yTop+1, wz+1]; p3 = [wx+1, yTop+1, wz  ];
  } else if (dx === -1) {
    p0 = [wx,   yBot,   wz+1]; p1 = [wx,   yBot,   wz  ];
    p2 = [wx,   yTop+1, wz  ]; p3 = [wx,   yTop+1, wz+1];
  } else if (dz === 1) {
    p0 = [wx+1, yBot,   wz+1]; p1 = [wx,   yBot,   wz+1];
    p2 = [wx,   yTop+1, wz+1]; p3 = [wx+1, yTop+1, wz+1];
  } else {
    p0 = [wx,   yBot,   wz  ]; p1 = [wx+1, yBot,   wz  ];
    p2 = [wx+1, yTop+1, wz  ]; p3 = [wx,   yTop+1, wz  ];
  }
  // Two tris
  const verts = [p0,p1,p2, p0,p2,p3];
  const uvs = [
    [uvv[0],uvv[1]],[uvv[2],uvv[1]],[uvv[2],uvv[3]],
    [uvv[0],uvv[1]],[uvv[2],uvv[3]],[uvv[0],uvv[3]],
  ];
  for (let i=0;i<6;i++) {
    pos.push(...verts[i]);
    norm.push(nx, 0, nz);
    uv.push(...uvs[i]);
    col.push(r, g, b);
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// CAMERA CONTROLS
// ══════════════════════════════════════════════════════════════════════════════

function updateCamera() {
  const sinPhi = Math.sin(cam.phi), cosPhi = Math.cos(cam.phi);
  const sinTh = Math.sin(cam.theta), cosTh = Math.cos(cam.theta);
  camera.position.set(
    cam.tx + cam.r * sinPhi * sinTh,
    cam.ty + cam.r * cosPhi,
    cam.tz + cam.r * sinPhi * cosTh
  );
  camera.lookAt(cam.tx, cam.ty, cam.tz);
}

function setupControls(canvas) {
  canvas.addEventListener('mousedown', e => {
    if (e.button === 1 || e.button === 2) {
      dragging = true; dragBtn = e.button; lx = e.clientX; ly = e.clientY;
      e.preventDefault();
    }
    if (e.button === 0 && planMode !== 'nav') handlePlanClick(e);
  });
  canvas.addEventListener('contextmenu', e => e.preventDefault());
  window.addEventListener('mouseup', () => { dragging = false; });
  window.addEventListener('mousemove', e => {
    if (dragging) {
      const dx = e.clientX - lx, dy = e.clientY - ly;
      lx = e.clientX; ly = e.clientY;
      if (dragBtn === 2) { // orbit
        cam.theta -= dx * 0.005;
        cam.phi = Math.max(0.1, Math.min(Math.PI * 0.48, cam.phi + dy * 0.005));
        updateCamera();
      } else if (dragBtn === 1) { // pan
        const right = new THREE.Vector3(), up = new THREE.Vector3(), fwd = new THREE.Vector3();
        camera.matrix.extractBasis(right, up, fwd);
        const spd = cam.r * 0.001;
        cam.tx -= right.x * dx * spd; cam.tz -= right.z * dx * spd;
        cam.tx += fwd.x * dy * spd * 0.5; cam.tz += fwd.z * dy * spd * 0.5;
        updateCamera();
      }
    }
    updateCoords(e);
  });
  canvas.addEventListener('wheel', e => {
    cam.r = Math.max(10, Math.min(2000, cam.r * (1 + e.deltaY * 0.001)));
    updateCamera();
    e.preventDefault();
  }, { passive: false });
  window.addEventListener('keydown', e => { keys[e.code] = true; });
  window.addEventListener('keyup',   e => { keys[e.code] = false; });
}

function processKeys() {
  if (!camera) return;
  const spd = cam.r * 0.01;
  const right = new THREE.Vector3(), up = new THREE.Vector3(), fwd = new THREE.Vector3();
  camera.matrix.extractBasis(right, up, fwd);
  fwd.y = 0; fwd.normalize(); right.y = 0; right.normalize();
  if (keys['KeyW'] || keys['ArrowUp'])   { cam.tx -= fwd.x*spd; cam.tz -= fwd.z*spd; }
  if (keys['KeyS'] || keys['ArrowDown']) { cam.tx += fwd.x*spd; cam.tz += fwd.z*spd; }
  if (keys['KeyA'] || keys['ArrowLeft']) { cam.tx -= right.x*spd; cam.tz -= right.z*spd; }
  if (keys['KeyD'] || keys['ArrowRight']){ cam.tx += right.x*spd; cam.tz += right.z*spd; }
  if (keys['Space'])     cam.ty += spd;
  if (keys['ShiftLeft']) cam.ty -= spd;
  if (Object.values(keys).some(Boolean)) updateCamera();
}

// ══════════════════════════════════════════════════════════════════════════════
// CHUNK MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════════

function updateChunks() {
  const camChunkX = Math.floor(camera.position.x / CHUNK);
  const camChunkZ = Math.floor(camera.position.z / CHUNK);
  const maxCX = Math.ceil(W / CHUNK), maxCZ = Math.ceil(H / CHUNK);
  const queued = new Set(chunkQueue.map(c => c.key));

  // Queue chunks sorted closest-first
  for (let dz = -RENDER_DIST; dz <= RENDER_DIST; dz++) {
    for (let dx = -RENDER_DIST; dx <= RENDER_DIST; dx++) {
      const d2 = dx*dx + dz*dz;
      if (d2 > RENDER_DIST * RENDER_DIST) continue;
      const cx = camChunkX + dx, cz = camChunkZ + dz;
      if (cx < 0 || cz < 0 || cx >= maxCX || cz >= maxCZ) continue;
      const key = cx + '_' + cz;
      if (!chunks.has(key) && !queued.has(key)) {
        chunkQueue.push({ cx, cz, key, d2 });
        queued.add(key);
      }
    }
  }
  chunkQueue.sort((a, b) => a.d2 - b.d2);

  // Unload distant chunks
  for (const [key, ch] of chunks) {
    const [cx, cz] = key.split('_').map(Number);
    if (Math.abs(cx - camChunkX) > RENDER_DIST + 3 || Math.abs(cz - camChunkZ) > RENDER_DIST + 3) {
      if (ch.solid) { solidGroup.remove(ch.solid); ch.solid.geometry.dispose(); }
      if (ch.water) { waterGroup.remove(ch.water); ch.water.geometry.dispose(); }
      chunks.delete(key);
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// ANIMATION
// ══════════════════════════════════════════════════════════════════════════════

let lastChunkUpdate = 0;
const CHUNKS_PER_FRAME = 3;
let statsEl = null;
let frameCount = 0;
function animate() {
  animId = requestAnimationFrame(animate);
  processKeys();
  // Build a few queued chunks per frame to avoid freezing the main thread
  for (let i = 0; i < CHUNKS_PER_FRAME && chunkQueue.length > 0; i++) {
    const c = chunkQueue.shift();
    if (!chunks.has(c.key)) buildChunk(c.cx, c.cz);
  }
  const now = performance.now();
  if (now - lastChunkUpdate > 300) { updateChunks(); lastChunkUpdate = now; }
  renderer.render(scene, camera);
  // Stats overlay (every 30 frames)
  frameCount++;
  if (frameCount % 30 === 0) {
    if (!statsEl) statsEl = document.getElementById('mv-stats');
    if (statsEl) {
      const loaded = chunks.size, queued = chunkQueue.length;
      const camP = camera.position;
      statsEl.innerHTML = `World: ${W}×${H} | Chunks: ${loaded} loaded, ${queued} queued<br>Cam: ${Math.round(camP.x)}, ${Math.round(camP.y)}, ${Math.round(camP.z)}`;
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// COORDINATE READOUT
// ══════════════════════════════════════════════════════════════════════════════

const coordsEl = document.getElementById('mv-coords');
function updateCoords(e) {
  if (!camera || !scene) return;
  const canvas = document.getElementById('mv-canvas');
  const rect = canvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  const my = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera({ x: mx, y: my }, camera);
  // Cast against a rough terrain plane at average height
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -(minY + 80));
  const hit = new THREE.Vector3();
  raycaster.ray.intersectPlane(plane, hit);
  if (hit) coordsEl.textContent = `X: ${Math.round(hit.x)}  Y: ${Math.round(-hit.y)}  Z: ${Math.round(hit.z)}`;
}

// ══════════════════════════════════════════════════════════════════════════════
// PLANNING TOOLS
// ══════════════════════════════════════════════════════════════════════════════

function setTool(mode) {
  planMode = mode;
  document.querySelectorAll('.mv-tool').forEach(el => el.classList.remove('active'));
  const toolMap = { nav: 'tool-nav', spawn: null, mining: null, contested: null, polygon: null, label: null };
  const id = 'tool-' + mode;
  const el = document.getElementById(id);
  if (el) el.classList.add('active');
  else document.querySelectorAll('.mv-tool').forEach(el => { if (el.textContent.trim().toLowerCase().includes(mode)) el.classList.add('active'); });
  document.getElementById('mv-poly-finish').style.display = mode === 'polygon' ? '' : 'none';
  if (mode !== 'polygon') { polyPts = []; if (polyLine) { planGroup.remove(polyLine); polyLine = null; } }
}

function getTerrainHit(e) {
  const canvas = document.getElementById('mv-canvas');
  const rect = canvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  const my = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera({ x: mx, y: my }, camera);
  // Cast against elevated plane for approximate hit
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -(minY + 80));
  const hit = new THREE.Vector3();
  return raycaster.ray.intersectPlane(plane, hit) ? hit : null;
}

function handlePlanClick(e) {
  const hit = getTerrainHit(e);
  if (!hit) return;
  if (planMode === 'polygon') {
    polyPts.push(hit.clone());
    updatePolyLine();
    return;
  }
  if (planMode === 'label') {
    pendingLabelPos = hit.clone();
    const li = document.getElementById('mv-label-input');
    li.style.display = '';
    document.getElementById('mv-label-text').focus();
    return;
  }
  if (['spawn','mining','contested'].includes(planMode)) {
    placeMarker(hit, planMode);
  }
}

function placeMarker(pos, type) {
  const color = new THREE.Color(planColors[type]);
  const geo = new THREE.SphereGeometry(3, 8, 6);
  const mat = new THREE.MeshBasicMaterial({ color });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.position.copy(pos).setY(pos.y + 4);
  planGroup.add(mesh);
  const item = { type, pos: { x: Math.round(pos.x), y: Math.round(pos.y), z: Math.round(pos.z) }, mesh };
  plan.markers.push(item);
  refreshPlanUI();
}

function updatePolyLine() {
  if (polyLine) { planGroup.remove(polyLine); polyLine = null; }
  if (polyPts.length < 2) return;
  const geo = new THREE.BufferGeometry().setFromPoints(polyPts.map(p => p.clone().setY(p.y + 2)));
  polyLine = new THREE.Line(geo, new THREE.LineBasicMaterial({ color: 0x74c0fc, linewidth: 2 }));
  planGroup.add(polyLine);
}

function finishPolygon() {
  if (polyPts.length < 3) { alert('Need at least 3 points for a border.'); return; }
  const pts = polyPts.map(p => ({ x: Math.round(p.x), y: Math.round(p.y), z: Math.round(p.z) }));
  plan.polygons.push({ pts, mesh: polyLine });
  polyPts = []; polyLine = null;
  refreshPlanUI();
}

function confirmLabel() {
  const text = document.getElementById('mv-label-text').value.trim();
  if (!text || !pendingLabelPos) return;
  document.getElementById('mv-label-input').style.display = 'none';
  document.getElementById('mv-label-text').value = '';
  const pos = pendingLabelPos;
  pendingLabelPos = null;
  plan.labels.push({ text, pos: { x: Math.round(pos.x), y: Math.round(pos.y), z: Math.round(pos.z) } });
  // Sprite label
  const c = document.createElement('canvas'); c.width = 256; c.height = 64;
  const ctx = c.getContext('2d');
  ctx.fillStyle = 'rgba(17,18,22,0.85)'; ctx.roundRect(4,4,248,56,10); ctx.fill();
  ctx.fillStyle = '#e0e2ed'; ctx.font = 'bold 24px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(text, 128, 32);
  const tex = new THREE.CanvasTexture(c);
  const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, depthTest: false }));
  sprite.position.copy(pos).setY(pos.y + 20);
  sprite.scale.set(40, 10, 1);
  planGroup.add(sprite);
  refreshPlanUI();
}

function cancelLabel() {
  document.getElementById('mv-label-input').style.display = 'none';
  document.getElementById('mv-label-text').value = '';
  pendingLabelPos = null;
}

// ══════════════════════════════════════════════════════════════════════════════
// PLAN UI
// ══════════════════════════════════════════════════════════════════════════════

function refreshPlanUI() {
  const list = document.getElementById('mv-plan-list');
  const total = plan.markers.length + plan.polygons.length + plan.labels.length;
  document.getElementById('mv-plan-count').textContent = total + ' item' + (total !== 1 ? 's' : '');
  list.innerHTML = '';
  plan.markers.forEach((m, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors[m.type]}"></span>${m.type} (${m.pos.x},${m.pos.z})<span class="mv-plan-del" onclick="deleteMarker(${i})">✕</span>`;
    list.appendChild(d);
  });
  plan.polygons.forEach((p, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors.polygon}"></span>Border (${p.pts.length} pts)<span class="mv-plan-del" onclick="deletePolygon(${i})">✕</span>`;
    list.appendChild(d);
  });
  plan.labels.forEach((l, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors.label}"></span>"${l.text}"<span class="mv-plan-del" onclick="deleteLabel(${i})">✕</span>`;
    list.appendChild(d);
  });
}

window.deleteMarker = i => {
  const m = plan.markers.splice(i, 1)[0];
  if (m.mesh) { planGroup.remove(m.mesh); m.mesh.geometry.dispose(); }
  refreshPlanUI();
};
window.deletePolygon = i => {
  const p = plan.polygons.splice(i, 1)[0];
  if (p.mesh) { planGroup.remove(p.mesh); p.mesh.geometry.dispose(); }
  refreshPlanUI();
};
window.deleteLabel = i => { plan.labels.splice(i, 1); refreshPlanUI(); };

// ══════════════════════════════════════════════════════════════════════════════
// EXPORT / SAVE / LOAD
// ══════════════════════════════════════════════════════════════════════════════

function exportPNG() {
  renderer.render(scene, camera);
  const url = renderer.domElement.toDataURL('image/png');
  const a = document.createElement('a'); a.href = url; a.download = 'map-view.png'; a.click();
}

function savePlan() {
  const data = {
    markers: plan.markers.map(m => ({ type: m.type, pos: m.pos })),
    polygons: plan.polygons.map(p => ({ pts: p.pts })),
    labels: plan.labels.map(l => ({ text: l.text, pos: l.pos })),
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'event-plan.json'; a.click();
}

window.loadPlanFile = function(input) {
  const file = input.files[0]; if (!file) return;
  file.text().then(t => {
    const data = JSON.parse(t);
    (data.markers || []).forEach(m => placeMarker(new THREE.Vector3(m.pos.x, m.pos.y, m.pos.z), m.type));
    refreshPlanUI();
  });
  input.value = '';
};

// ══════════════════════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════════════════════

function showProgress(visible, text, err) {
  const el = document.getElementById('mv-progress');
  el.style.display = visible ? 'flex' : 'none';
  if (text) document.getElementById('mv-prog-text').textContent = text;
  const errEl = document.getElementById('mv-prog-err');
  if (err) { errEl.textContent = err; errEl.style.display = ''; }
  else errEl.style.display = 'none';
}

// Expose globals needed by inline onclick handlers
window.setTool = setTool;
window.finishPolygon = finishPolygon;
window.confirmLabel = confirmLabel;
window.cancelLabel = cancelLabel;
window.savePlan = savePlan;
window.exportPNG = exportPNG;

})();
</script>

