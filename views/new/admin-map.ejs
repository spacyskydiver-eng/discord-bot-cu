// Blocks with no static, name-based texture we can source at all - a player
// head's visible texture is that player's live skin (fetched from Mojang at
// render time in-game), not a fixed file, so there's nothing in
// /mc-textures/ to show. Treated like NON_SOLID for ground-height purposes
// (walk past it to find the real block it's sitting on) but never actually
// drawn - showing broken/fallback geometry would look worse than nothing.
const NO_RENDER = new Set(['player_head', 'player_wall_head']);

// Thin near-horizontal blocks - these sit low and flat across most of the
// block's footprint, unlike a flower/grass cross which stands upright. Drawn
// as a single flat quad near the bottom of the block instead of an X
// billboard (which is what NON_SOLID's other members get); without this
// split, a snow layer on the ground rendered as a vertical "X" using the
// snow texture, looking like a strange pale tuft of grass.
const FLAT_LAYER = new Set([
  'snow', 'snow_layer', 'moss_carpet', 'lily_pad', 'turtle_egg', 'sea_pickle',
]);
function isFlatLayer(name) { return FLAT_LAYER.has(name) || name.endsWith('_carpet'); }

// Double-tall plants: Minecraft stores both halves as the SAME block id with
// a half=upper/lower blockstate property, but the scan mod only records the
// bare block Name and drops blockstate properties entirely (see
// BlockStateEditor.getBlockId, which reads only the palette entry's "Name").
// So both halves arrive here as identical strings, even though their
// textures are two separate files (e.g. tall_grass_top.png /
// tall_grass_bottom.png - there's no plain "tall_grass.png"). Which texture
// to use is inferred purely from stack position at render time (see the
// PLANT SPRITE loop): a layer whose immediate neighbour in the stack is the
// same block id is the paired half; isolated occurrences default to _top.
const DOUBLE_TALL = new Set(['tall_grass', 'large_fern', 'sunflower', 'lilac', 'peony', 'rose_bush', 'tall_seagrass']);

// Logs follow a standard pattern
const LOG_TYPES = ['oak','spruce','birch','jungle','acacia','dark_oak','mangrove','cherry','bamboo','crimson','warped'];

function blockTexNames(name) {
  if (BLOCK_TEX_MAP[name]) return BLOCK_TEX_MAP[name];
  // Log / stripped log pattern
  for (const w of LOG_TYPES) {
    if (name === w+'_log' || name === 'stripped_'+w+'_log') return { top:name+'_top', side:name, bottom:name+'_top' };
    if (name === w+'_wood' || name === 'stripped_'+w+'_wood') {
      // The full-bark "wood" block (as opposed to "log") has no ring pattern
      // on any face - it's the same bark texture as its _log counterpart's
      // side, applied to all 6 faces. There's no standalone oak_wood.png
      // etc. file; only oak_log.png (the bark texture) exists.
      const logName = name.replace('_wood', '_log');
      return { top:logName, side:logName, bottom:logName };
    }
  }
  if (name === 'bamboo_block' || name === 'stripped_bamboo_block') return { top:name+'_top', side:name, bottom:name+'_top' };
  // Fences/gates have no texture of their own - vanilla textures them with
  // the matching wood type's plank texture (nether_brick_fence uses the
  // brick texture instead, since it isn't a wood type).
  if (name === 'nether_brick_fence') return { top:'nether_bricks', side:'nether_bricks', bottom:'nether_bricks' };
  if (name.endsWith('_fence') || name.endsWith('_fence_gate')) {
    const base = name.replace(/_fence(_gate)?$/, '') + '_planks';
    return { top:base, side:base, bottom:base };
  }
  return { top:name, side:name, bottom:name };
}

let blockName = {};  // id → bare name (no namespace), built once
let blockProps = {};  // id → blockstate properties object (see palette parsing in loadWorld), built once
let nonSolidIds = new Set(); // block IDs that are plants/non-solid
let noRenderIds = new Set(); // block IDs we deliberately never draw (see NO_RENDER)

function buildBlockColors() {
  for (const b of paletteArr) {
    const name = (b.name || '').replace(/^minecraft:/, '');
    blockName[b.id] = name;
    blockProps[b.id] = b.props || {};
    if (NON_SOLID.has(name)) nonSolidIds.add(b.id);
    if (NO_RENDER.has(name)) noRenderIds.add(b.id);
    const col = DEFAULT_COLORS[name] ?? '#888888';
    blockCol[b.id] = typeof col === 'number' ? null : new THREE.Color(col);
  }
}

// Solid for the purposes of "is there real, drawable terrain here" - true
// non-solid plants AND blocks we refuse to render (see NO_RENDER) both need
// to be walked past to find the actual ground/wall material beneath them.
function isWalkPast(bid) { return nonSolidIds.has(bid) || noRenderIds.has(bid); }

// Derive groundHeight/groundBlock/plantShift for every column (see the field
// comments above). Plants (short_grass, flowers, ferns...) should never be
// treated as solid terrain - real Minecraft renders them as a thin cross
// sitting on top of the block below, not as a solid textured cube, and
// neighbouring solid terrain should line up with the *ground* under a plant,
// not the plant's own recorded height (otherwise every tuft of grass creates
// a spurious 1-block ledge in the terrain mesh).
//
// plantShift counts how many non-solid depth-units sit stacked above the real
// ground (not just 0 or 1): a double-tall plant (its lower half recorded as
// the first run below the surface) or a snow layer sitting on top of grass
// both need to walk past more than one non-solid unit before reaching solid
// ground, and each of those layers gets its own sprite drawn on top of one
// another.
function computeGroundHeights() {
  const n = W * H;
  groundHeight = new Float32Array(n);
  groundBlock = new Uint16Array(n);
  plantShift = new Uint16Array(n);
  for (let i = 0; i < n; i++) {
    const s = surface[i];
    if (s && isWalkPast(s)) {
      const rs = runStart[i], rc = runCount[i];
      let d = 0; // 0-based depth-units walked so far (below the surface)
      let foundDepth = -1, foundBlock = 0;
      for (let r = 0; r < rc; r++) {
        const bid = runBlockIds[rs + r];
        if (bid && !isWalkPast(bid)) { foundDepth = d; foundBlock = bid; break; }
        d += runLengths[rs + r];
      }
      if (foundDepth >= 0) {
        plantShift[i] = foundDepth + 1; // surface + foundDepth run-units are all non-solid
        groundHeight[i] = heights[i] - (foundDepth + 1);
        groundBlock[i] = foundBlock;
        continue;
      }
      // No solid block found anywhere in the recorded runs (rare - the scan's
      // maxDepth ran out before hitting solid ground). Fall back to treating
      // the plant itself as the solid top rather than leaving a hole; its
      // sprite still draws on top. Unless it's a NO_RENDER block (a player
      // head with nothing solid found below it) - there's nothing safe to
      // fall back to drawing, so leave the column with no data rather than
      // showing a broken texture.
      if (noRenderIds.has(s)) {
        groundHeight[i] = heights[i];
        groundBlock[i] = 0;
        continue;
      }
    }
    groundHeight[i] = heights[i];
    groundBlock[i] = s;
  }
}

// Fetch textures from /mc-textures/ and build atlas automatically
async function autoLoadTextures() {
  // Collect unique texture names needed for this palette
  const needed = new Set();
  let needsGrassOverlay = false;
  for (const b of paletteArr) {
    const name = (b.name || '').replace(/^minecraft:/, '');
    // Double-tall plants (large_fern, tall_grass...) have no bare <name>.png
    // of their own - only split _top/_bottom files exist (added below) - so
    // blockTexNames's generic name-as-texture fallback would just request a
    // file that 404s for these.
    if (!DOUBLE_TALL.has(name)) {
      const t = blockTexNames(name);
      needed.add(t.top); needed.add(t.side);
    }
    if (name === 'grass_block') {
      needed.add('grass_block_side_overlay');
      needsGrassOverlay = true;
      // A snowy grass_block (winter biomes, or just below a snow layer)
      // shows the same white top texture as a plain snow block in vanilla
      // (not green grass) and a half snow/half dirt transition strip on its
      // sides - the scan now records this as its own palette entry
      // (grass_block[snowy=true]) rather than folding it into the plain
      // grass_block id, so it's handled per-block below.
      if (b.props?.snowy === 'true') { needed.add('grass_block_snow'); needed.add('snow'); }
    }
    if (DOUBLE_TALL.has(name)) { needed.add(name + '_top'); needed.add(name + '_bottom'); }
  }

  // Fetch all in parallel, silently skip 404s
  const fetched = {}; // texName → blob URL
  await Promise.all([...needed].map(async n => {
    try {
      const r = await fetch(`/mc-textures/${encodeURIComponent(n)}.png`);
      if (r.ok) { fetched[n] = URL.createObjectURL(await r.blob()); }
    } catch (_) {}
  }));

  const texNames = Object.keys(fetched);
  // Show diagnostic on the page so we can see without opening F12
  const dbgEl = document.getElementById('mv-stats');
  if (dbgEl) dbgEl.innerHTML = `Textures fetched: ${texNames.length} / needed: ${needed.size}`;
  if (!texNames.length) { console.warn('[MapViewer] No textures loaded from /mc-textures/'); return; }
  console.log(`[MapViewer] Loaded ${texNames.length} textures`);

  // Pre-assign atlas slots, then draw. One extra synthetic slot is reserved
  // for the grass_block side composite (base + tinted overlay) built below.
  const GRASS_SIDE_SLOT_KEY = 'grass_block_side@composited';
  const slotMap = {};
  texNames.forEach((n, i) => { slotMap[n] = i; });
  const hasGrassOverlay = needsGrassOverlay && fetched['grass_block_side'] && fetched['grass_block_side_overlay'];
  if (hasGrassOverlay) slotMap[GRASS_SIDE_SLOT_KEY] = texNames.length;

  const spr = ATLAS / TEX; // slots per row
  const ac = document.createElement('canvas');
  ac.width = ac.height = ATLAS;
  const actx = ac.getContext('2d');
  actx.imageSmoothingEnabled = false;
  // Pre-fill white (alpha=1) — empty slots must be opaque so alphaTest doesn't cull
  // blocks whose texture file doesn't exist. White × vertex_color = vertex_color.
  actx.fillStyle = '#FFFFFF';
  actx.fillRect(0, 0, ATLAS, ATLAS);

  // Keep references to the loaded grass images (base + overlay) so the
  // compositing step below can reuse them instead of re-fetching.
  let grassBaseImg = null, grassOverlayImg = null;

  await Promise.all(texNames.map(n => new Promise(res => {
    const img = new Image();
    img.onload = () => {
      const s = slotMap[n], col = s % spr, row = Math.floor(s / spr);
      // Clear this cell to fully transparent before drawing. Without this,
      // the default 'source-over' blend would composite every transparent
      // source pixel onto the opaque white pre-fill below and bake it in as
      // solid white/cream - invisible on mostly-opaque block faces, but a
      // glaring blank card on mostly-transparent sprites like flowers, which
      // are >85% transparent pixels. (globalCompositeOperation='copy' would
      // do this in one step, but per spec it clears the *entire* canvas, not
      // just the drawn rect, wiping every texture drawn before it.)
      actx.clearRect(col * TEX, row * TEX, TEX, TEX);
      actx.drawImage(img, col * TEX, row * TEX, TEX, TEX);
      if (n === 'grass_block_side') grassBaseImg = img;
      else if (n === 'grass_block_side_overlay') grassOverlayImg = img;
      else URL.revokeObjectURL(fetched[n]);
      res();
    };
    img.onerror = res;
    img.src = fetched[n];
  })));

  // Real Minecraft draws grass_block's side face as its plain dirt-colored
  // base texture with a separate, biome-tinted "overlay" (just the green
  // fringe near the top) layered on top - the base itself is NOT tinted.
  // Bake that composite once here (using a fixed plains-green tint, since
  // the atlas is shared across the whole scan and can't vary per biome per
  // vertex the way the top face's per-column tint does) into its own slot,
  // so grass sides show a correct green-fringe-over-brown-dirt look instead
  // of the plain untinted base texture.
  if (hasGrassOverlay && grassBaseImg && grassOverlayImg) {
    const tint = BIOME_COLORS['minecraft:plains'].grass;
    const tinted = document.createElement('canvas');
    tinted.width = tinted.height = TEX;
    const tctx = tinted.getContext('2d');
    tctx.imageSmoothingEnabled = false;
    tctx.drawImage(grassOverlayImg, 0, 0, TEX, TEX);
    tctx.globalCompositeOperation = 'source-in'; // recolor the overlay, keep its own alpha shape
    tctx.fillStyle = tint;
    tctx.fillRect(0, 0, TEX, TEX);

    const composite = document.createElement('canvas');
    composite.width = composite.height = TEX;
    const cctx = composite.getContext('2d');
    cctx.imageSmoothingEnabled = false;
    cctx.drawImage(grassBaseImg, 0, 0, TEX, TEX); // untinted dirt-brown base
    cctx.drawImage(tinted, 0, 0); // tinted overlay on top, respecting its alpha

    const s = slotMap[GRASS_SIDE_SLOT_KEY], col = s % spr, row = Math.floor(s / spr);
    actx.drawImage(composite, col * TEX, row * TEX, TEX, TEX);
  }
  if (fetched['grass_block_side']) URL.revokeObjectURL(fetched['grass_block_side']);
  if (fetched['grass_block_side_overlay']) URL.revokeObjectURL(fetched['grass_block_side_overlay']);

  atlasTex = new THREE.CanvasTexture(ac);
  atlasTex.flipY = false; // atlas UV math uses V=0 at canvas top; don't flip
  atlasTex.magFilter = THREE.NearestFilter;
  // No mipmaps: the atlas packs 16x16 textures edge-to-edge with zero padding,
  // so auto-generated mip levels blend pixels across cell boundaries - i.e.
  // any two adjacent textures in the atlas bleed into each other once a block
  // is far enough away to sample a lower mip level (most of a wide view).
  // That's what was producing the flat/muddy look instead of real Minecraft's
  // sharp, unfiltered block textures. NearestFilter with no mipmaps samples
  // exactly one texel from the full-res atlas every time - no bleeding, and
  // it matches vanilla's own blocky look (Minecraft doesn't mip its blocks either).
  atlasTex.minFilter = THREE.NearestFilter;
  atlasTex.generateMipmaps = false;

  uvCache = {};
  for (const [n, s] of Object.entries(slotMap)) {
    const col = s % spr, row = Math.floor(s / spr);
    uvCache[n] = [col*TEX/ATLAS, row*TEX/ATLAS, (col+1)*TEX/ATLAS, (row+1)*TEX/ATLAS];
  }

  blockUV = {};
  for (const b of paletteArr) {
    const name = (b.name || '').replace(/^minecraft:/, '');
    // grass_block_snow.png is the *side* texture (a half snow-cap/half dirt
    // transition strip) - the top face of snowy grass uses the same plain
    // white texture as any other snow-covered block.
    const isSnowyGrass = name === 'grass_block' && b.props?.snowy === 'true';
    const t = isSnowyGrass ? { top:'snow', side:'grass_block_snow', bottom:'dirt' } : blockTexNames(name);
    const sideUV = (name === 'grass_block' && !isSnowyGrass && uvCache[GRASS_SIDE_SLOT_KEY]) || uvCache[t.side] || null;
    blockUV[b.id] = { top: uvCache[t.top]||null, side: sideUV, bottom: uvCache[t.bottom]||null };
  }

  // Load water texture separately (animated spritesheet — use top 16×16 frame only)
  try {
    const wr = await fetch('/mc-textures/water_still.png');
    if (wr.ok) {
      const wblob = await wr.blob();
      await new Promise(res => {
        const wimg = new Image();
        wimg.onload = () => {
          const wc = document.createElement('canvas'); wc.width = wc.height = 16;
          const wctx = wc.getContext('2d');
          wctx.drawImage(wimg, 0, 0, 16, 16, 0, 0, 16, 16); // first frame
          waterTex = new THREE.CanvasTexture(wc);
          waterTex.magFilter = THREE.NearestFilter;
          waterTex.minFilter = THREE.NearestFilter;
          waterTex.wrapS = waterTex.wrapT = THREE.RepeatWrapping;
          URL.revokeObjectURL(wblob); res();
        };
        wimg.onerror = res;
        wimg.src = URL.createObjectURL(wblob);
      });
    }
  } catch (_) {}
}

// ══════════════════════════════════════════════════════════════════════════════
// SCENE INIT
// ══════════════════════════════════════════════════════════════════════════════

function initScene(centerH) {
  const canvas = document.getElementById('mv-canvas');
  const W2 = canvas.parentElement.clientWidth || window.innerWidth;
  const H2 = canvas.parentElement.clientHeight || (window.innerHeight - 64);

  renderer = new THREE.WebGLRenderer({ canvas, antialias: false, logarithmicDepthBuffer: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(W2, H2);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  scene = new THREE.Scene();
  scene.background = new THREE.Color(0x87ceeb);
  scene.fog = new THREE.Fog(0x87ceeb, 600, 2000);

  camera = new THREE.PerspectiveCamera(70, canvas.clientWidth / canvas.clientHeight, 0.5, 3000);
  // Position camera at center of world, above actual terrain height
  const terrainY = (centerH !== undefined && isFinite(centerH)) ? centerH : 64;
  cam.tx = W / 2; cam.ty = terrainY + 20; cam.tz = H / 2;
  cam.r = 300;
  updateCamera();

  // Lighting
  const amb = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(amb);
  const sun = new THREE.DirectionalLight(0xfffce0, 1.2);
  sun.position.set(200, 400, 100);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  sun.shadow.camera.near = 1; sun.shadow.camera.far = 1500;
  sun.shadow.camera.left = sun.shadow.camera.bottom = -800;
  sun.shadow.camera.right = sun.shadow.camera.top = 800;
  scene.add(sun);

  // Materials — alphaTest handles leaf/glass transparency cutouts
  solidMat = atlasTex
    ? new THREE.MeshLambertMaterial({ map: atlasTex, vertexColors: true, alphaTest: 0.1, side: THREE.DoubleSide })
    : new THREE.MeshLambertMaterial({ vertexColors: true });
  waterMat = waterTex
    ? new THREE.MeshLambertMaterial({ map: waterTex, color: 0x5599dd, transparent: true, opacity: 0.82, side: THREE.DoubleSide })
    : new THREE.MeshLambertMaterial({ color: 0x3f76e4, transparent: true, opacity: 0.72, side: THREE.DoubleSide });

  solidGroup = new THREE.Group(); scene.add(solidGroup);
  waterGroup = new THREE.Group(); scene.add(waterGroup);
  planGroup  = new THREE.Group(); scene.add(planGroup);

  // Controls
  setupControls(canvas);
  window.addEventListener('resize', () => {
    const rw = canvas.parentElement.clientWidth || window.innerWidth;
    const rh = canvas.parentElement.clientHeight || (window.innerHeight - 64);
    camera.aspect = rw / rh;
    camera.updateProjectionMatrix();
    renderer.setSize(rw, rh);
  });
}

// ══════════════════════════════════════════════════════════════════════════════
// CHUNK MESHING
// ══════════════════════════════════════════════════════════════════════════════

// Block id at 0-based depth-units `d` below a column's surface, walking its
// run-length-encoded material list directly (no plantShift offset applied -
// this is the raw recorded sequence, used both by getBlockAtDepth below and
// by the plant-layer stacking code which needs the layers plantShift skips
// past, not just what's beneath them).
function blockAtRunDepth(idx, d) {
  const rs = runStart[idx], rc = runCount[idx];
  let acc = 0;
  for (let r = 0; r < rc; r++) {
    const len = runLengths[rs + r];
    if (d < acc + len) return runBlockIds[rs + r];
    acc += len;
  }
  return rc > 0 ? runBlockIds[rs + rc - 1] : 0;
}

function getBlockAtDepth(idx, depth) {
  // depth 0 = the topmost *solid* block (groundBlock), depth 1 = next one
  // down, etc. Columns with a nonzero plantShift have their whole depth
  // sequence shifted, since the first plantShift run-units are the plant
  // itself, not part of the solid depth sequence (it's drawn separately).
  // Deeper than the recorded runs (the scan's maxDepth ran out - e.g. a very
  // tall tree next to a much shorter neighbour, needing more wall than was
  // scanned) falls back to repeating the deepest recorded block rather than
  // guessing: this used to hardcode block id 1 as "stone", but palette ids
  // are assigned per-world in scan order - id 1 is whatever block that world
  // happened to register first (often dirt, not stone), so it rendered as an
  // unrelated, wrong-colored block wherever a wall ran past the recorded
  // depth. blockAtRunDepth already does that clamping.
  if (depth === 0) return groundBlock[idx];
  return blockAtRunDepth(idx, depth - 1 + plantShift[idx]);
}

function getUV(blockId, face) {
  const uv = blockUV[blockId];
  if (uv) {
    const v = uv[face] || uv.side || uv.top;
    if (v) return v;
  }
  return null; // use vertex color
}

function getBiomeTint(biomeId, face, blockId) {
  const name = blockName[blockId] || '';
  // grass_block's side texture is already pre-tinted once, baked into its own
  // atlas slot (see the composite step in autoLoadTextures) - it must NOT
  // also get a per-vertex tint here, or it'd be tinted twice over.
  if (name === 'grass_block' && face === 'side') return [1, 1, 1];
  // A snowy grass_block shows the same plain white texture on every face as
  // a snow block, not tinted grass - tinting it would look like green-stained
  // snow.
  if (name === 'grass_block' && blockProps[blockId]?.snowy === 'true') return [1, 1, 1];
  const biome = biomePal.find ? biomePal.find(b => b.id === biomeId) : (biomePal[biomeId] || null);
  // biome_palette.json only carries {id, name} - the real per-biome colors
  // live in BIOME_COLORS (computed from Minecraft's own data), looked up by
  // biome name. Falls back to plains if the biome name isn't recognized
  // (e.g. a modded biome not in the vanilla table).
  const entry = (biome && BIOME_COLORS[biome.name]) || BIOME_COLORS['minecraft:plains'];
  const col = (n => {
    if (/grass_block|short_grass|grass$|fern/.test(n)) return entry.grass;
    if (/leaves/.test(n)) return entry.foliage;
    return null;
  })(name);
  if (!col) return [1, 1, 1];
  const c = new THREE.Color(col);
  return [c.r, c.g, c.b];
}

function buildChunk(cx, cz) {
  const key = cx + '_' + cz;
  if (chunks.has(key)) return;
  try {
    _buildChunkInner(cx, cz, key);
  } catch (err) {
    console.error('[MapViewer] buildChunk error at', cx, cz, err);
    chunks.set(key, { solid: null, water: null }); // mark as attempted to avoid retry spam
  }
}
function _buildChunkInner(cx, cz, key) {

  const sx = cx * CHUNK, sz = cz * CHUNK;
  const ex = Math.min(sx + CHUNK, W), ez = Math.min(sz + CHUNK, H);

  // Solid geometry arrays
  const pos = [], norm = [], uv = [], col = [];
  const wpos = [], wnorm = [], wuv = [];

  function addQuad(p0, p1, p2, p3, nx, ny, nz, u0, v0, u1, v1, r, g, b, toSolid) {
    const P = toSolid ? pos : wpos, N = toSolid ? norm : wnorm, U = toSolid ? uv : wuv;
    // CCW winding: p0-p2-p1 and p0-p3-p2 (so front face points toward viewer)
    const verts = [p0, p2, p1, p0, p3, p2];
    const uvs = [[u0,v1],[u1,v0],[u1,v1],[u0,v1],[u0,v0],[u1,v0]];
    for (let i = 0; i < 6; i++) {
      P.push(...verts[i]); N.push(nx, ny, nz); U.push(...uvs[i]);
      if (toSolid) col.push(r, g, b);
    }
  }

  // Two crossed diagonal quads spanning the full block, matching how vanilla
  // Minecraft renders plants/flowers/grass/ferns - a thin "X" billboard using
  // the block's own single texture, not a solid textured cube. The material
  // is double-sided (see solidMat), so one quad per diagonal is enough - each
  // is visible from both sides.
  function addCross(wx, wy, wz, uvv, r, g, b) {
    const u0v1 = [uvv[0],uvv[3]], u1v0 = [uvv[2],uvv[1]], u1v1 = [uvv[2],uvv[3]], u0v0 = [uvv[0],uvv[1]];
    const diag1 = [[wx,wy,wz], [wx+1,wy,wz+1], [wx+1,wy+1,wz+1], [wx,wy+1,wz]];
    const diag2 = [[wx+1,wy,wz], [wx,wy,wz+1], [wx,wy+1,wz+1], [wx+1,wy+1,wz]];
    for (const [p0, p1, p2, p3] of [diag1, diag2]) {
      const verts = [p0, p2, p1, p0, p3, p2];
      const uvs = [u0v1, u1v0, u1v1, u0v1, u0v0, u1v0];
      for (let i = 0; i < 6; i++) {
        pos.push(...verts[i]); norm.push(0, 1, 0); uv.push(...uvs[i]); col.push(r, g, b);
      }
    }
  }

  // A thin flat quad near the bottom of the block, for snow layers/carpets/
  // lily pads - things that lie flat across the footprint rather than
  // standing up as a cross. baseY is the Y of the solid surface it rests on.
  // frac (0-1) is how tall to draw it - snow's real "layers" count (1-8)
  // maps directly to this when known; anything else defaults to a thin slab.
  // Also draws thin side walls down to baseY using the same texture, so a
  // multi-layer snow patch (or any other flat layer) shows its own colour
  // all the way around instead of exposing whatever real ground it's
  // sitting on - visible any time the camera looks at it from a low angle.
  function addFlatLayer(wx, baseY, wz, uvv, r, g, b, frac) {
    const y = baseY + Math.max(0.1, frac ?? 0.1);
    addQuad(
      [wx, y, wz], [wx+1, y, wz], [wx+1, y, wz+1], [wx, y, wz+1],
      0, 1, 0, uvv[0], uvv[1], uvv[2], uvv[3], r, g, b, true
    );
    const sides = [
      { p0:[wx+1,baseY,wz],   p1:[wx+1,baseY,wz+1], p2:[wx+1,y,wz+1], p3:[wx+1,y,wz],   n:[1,0,0] },
      { p0:[wx,baseY,wz+1],   p1:[wx,baseY,wz],     p2:[wx,y,wz],     p3:[wx,y,wz+1],   n:[-1,0,0] },
      { p0:[wx+1,baseY,wz+1], p1:[wx,baseY,wz+1],   p2:[wx,y,wz+1],   p3:[wx+1,y,wz+1], n:[0,0,1] },
      { p0:[wx,baseY,wz],     p1:[wx+1,baseY,wz],   p2:[wx+1,y,wz],   p3:[wx,y,wz],     n:[0,0,-1] },
    ];
    for (const { p0, p1, p2, p3, n } of sides) {
      addQuad(p0, p1, p2, p3, n[0], n[1], n[2], uvv[0], uvv[1], uvv[2], uvv[3], r, g, b, true);
    }
  }

  // Last atlas slot — always empty white since palette << 4096 slots total
  const _fuv = [(ATLAS-TEX)/ATLAS, (ATLAS-TEX)/ATLAS, 1.0, 1.0];
  function fallbackUV() { return _fuv; }

  const DIRS4 = [
    { dx: 1, dz: 0, nx: 1, nz: 0 },
    { dx:-1, dz: 0, nx:-1, nz: 0 },
    { dx: 0, dz: 1, nx: 0, nz: 1 },
    { dx: 0, dz:-1, nx: 0, nz:-1 },
  ];

  // A capped box (top face + 4 side walls) for one contiguous run of solid
  // material found in a column's own skirt - see the SELF SKIRT comment
  // below for why this needs to exist as its own thing rather than only
  // ever drawing walls where a shorter neighbour triggers them.
  function emitSelfRun(idx, mx, mz, wx, wz, yBot, yTop, bid, biomeId) {
    const uvv = getUV(bid, 'top') || fallbackUV();
    const tc = getBiomeTint(biomeId, 'top', bid);
    const bColor = blockCol[bid] || new THREE.Color(0x888888);
    const r = atlasTex ? tc[0] : bColor.r * tc[0];
    const g = atlasTex ? tc[1] : bColor.g * tc[1];
    const b = atlasTex ? tc[2] : bColor.b * tc[2];
    addQuad(
      [wx, yTop+1, wz], [wx+1, yTop+1, wz], [wx+1, yTop+1, wz+1], [wx, yTop+1, wz+1],
      0, 1, 0, uvv[0], uvv[1], uvv[2], uvv[3], r, g, b, true
    );
    // Only draw a wall face where the neighbour genuinely has nothing at
    // this exact Y - if it has matching solid material there too (its own
    // ground, or its own self-skirt run), the two patches should merge
    // seamlessly instead of both drawing a wall between them. Checked per
    // Y level (not just once for the whole run) since a neighbour's own
    // data can easily only cover part of this run's height.
    for (const {dx, dz, nx, nz} of DIRS4) {
      const nmx = mx + dx, nmz = mz + dz;
      const outOfBounds = nmx < 0 || nmx >= W || nmz < 0 || nmz >= H;
      const nidx = outOfBounds ? -1 : nmz * W + nmx;
      const noNeighbourData = outOfBounds || !groundBlock[nidx];
      let wallRunStart = -1;
      for (let y = yBot; y <= yTop; y++) {
        let exposed;
        if (noNeighbourData) {
          exposed = true; // world edge or unscanned neighbour - nothing to merge with
        } else {
          const nMy = groundHeight[nidx];
          const nDepth = nMy - y;
          const nBlock = nDepth < 0 ? 0 : getBlockAtDepth(nidx, nDepth);
          exposed = !nBlock || isWalkPast(nBlock);
        }
        if (exposed) {
          if (wallRunStart < 0) wallRunStart = y;
        } else if (wallRunStart >= 0) {
          emitSideFace(wx, wz, wallRunStart, y - 1, dx, dz, nx, nz, bid, biomeId, pos, norm, uv, col);
          wallRunStart = -1;
        }
      }
      if (wallRunStart >= 0) emitSideFace(wx, wz, wallRunStart, yTop, dx, dz, nx, nz, bid, biomeId, pos, norm, uv, col);
    }
  }

  for (let mz = sz; mz < ez; mz++) {
    for (let mx = sx; mx < ex; mx++) {
      const idx = mz * W + mx;
      const my = groundHeight[idx];
      if (!isFinite(my)) continue; // bad height data
      const displayBid = groundBlock[idx];
      if (!displayBid) continue; // no data for this column (never generated)
      const water = waterArr[idx];
      const biomeId = biomes[idx];
      const tc = getBiomeTint(biomeId, 'top', displayBid);
      const bColor = blockCol[displayBid] || new THREE.Color(0x888888);
      const br = bColor.r, bg = bColor.g, bb = bColor.b;

      // World coords (centered)
      const wx = mx, wy = my, wz = mz;

      // TOP FACE
      {
        const uvv = getUV(displayBid, 'top') || fallbackUV();
        const cr = atlasTex ? tc[0] : br * tc[0], cg = atlasTex ? tc[1] : bg * tc[1], cb2 = atlasTex ? tc[2] : bb * tc[2];
        addQuad(
          [wx, wy+1, wz], [wx+1, wy+1, wz], [wx+1, wy+1, wz+1], [wx, wy+1, wz+1],
          0, 1, 0, uvv[0], uvv[1], uvv[2], uvv[3], cr, cg, cb2, true
        );
      }

      // SELF SKIRT — a leaf-topped column's own recorded material below its
      // top, drawn regardless of whether any neighbour is short enough to
      // expose a wall the normal way. This is what makes a tree canopy
      // column show its trunk and its forest floor: its skirt often
      // contains real solid data further down - a log run continuing the
      // trunk under the canopy, then an air gap, then the real ground -
      // none of which a neighbour-height comparison alone would ever
      // expose if surrounding canopy is the same height on every side.
      //
      // Gated on the column's own top being leaves specifically (not e.g.
      // "no neighbour is shorter", which is trivially true for *any*
      // ordinary flat terrain too, since same-height neighbours count as
      // "not shorter") - ordinary ground's skirt is just a boring
      // dirt/stone run that would look identical whether drawn here or via
      // the normal neighbour-triggered wall the moment a real height
      // difference exposes it, so self-rendering it here too would only
      // add many times more geometry for zero visual difference. Leaves
      // are different: a leaf-topped column is very often never exposed by
      // height differences at all (canopy tends to be a fairly uniform
      // blob), so this is the only way that column's trunk/floor data ever
      // gets drawn.
      //
      // Every wall face is checked against the actual neighbouring column's
      // own data at that exact Y level (not just drawn unconditionally):
      // in a dense forest, hundreds of adjacent columns are *all*
      // leaf-topped and each independently computes its own floor/trunk
      // material, so unconditionally boxing each one in its own 4 walls
      // produced a shattered mess of disconnected floating pillars with
      // sky gaps between them wherever neighbouring columns' self-skirt
      // data didn't line up perfectly - this is what was actually causing
      // "sky with no surface at all" under trees, confirmed by rendering
      // this exact real-world data locally. Skipping the wall whenever the
      // neighbour has matching solid material at the same Y (via
      // getBlockAtDepth, the same lookup already used for the normal
      // neighbour-triggered walls) means two adjacent columns' patches
      // merge seamlessly instead of both drawing a redundant, potentially
      // misaligned wall between them.
      if (blockName[displayBid]?.endsWith('_leaves')) {
        // Walk this column's own recorded runs directly - they're already
        // grouped by identical block id, so unlike the old fixed-skirt
        // version there's no need to re-detect run boundaries by hand, and
        // no depth cap short of whatever the scan actually captured.
        const rs = runStart[idx], rc = runCount[idx];
        const skip = plantShift[idx]; // run-depth-units already consumed elsewhere
        let d0 = 0; // 0-based depth-units at the start of the current run
        for (let r = 0; r < rc; r++) {
          const bid = runBlockIds[rs + r];
          const len = runLengths[rs + r];
          const segStart = d0, segEnd = d0 + len;
          d0 = segEnd;
          if (segEnd <= skip) continue; // entirely within the already-consumed region
          if (bid && !isWalkPast(bid)) {
            const effStart = Math.max(segStart, skip);
            const yTop = wy - 1 - effStart;
            const yBot = wy - effStart - (segEnd - effStart);
            emitSelfRun(idx, mx, mz, wx, wz, yBot, yTop, bid, biomeId);
          }
        }
      }

      // PLANT SPRITE(S) — one or more decorative non-solid blocks (grass,
      // flowers, ferns, a double-tall plant's two halves, a snow layer on
      // top of grass...) stacked on this column's real ground. Each layer
      // is drawn on top of the one below it, not folded into the solid cube.
      const layerCount = plantShift[idx];
      const layerBlockAt = k => k === 0 ? surface[idx] : blockAtRunDepth(idx, k - 1);
      for (let k = 0; k < layerCount; k++) {
        const plantBid = layerBlockAt(k);
        if (!plantBid || noRenderIds.has(plantBid)) continue; // e.g. a player head - nothing to draw
        const name = blockName[plantBid];
        const plantTc = getBiomeTint(biomeId, 'top', plantBid);
        let uvv;
        if (DOUBLE_TALL.has(name)) {
          // Both halves share one block id (see DOUBLE_TALL comment). Newer
          // scans capture the real half=upper/lower property directly
          // (blockProps); fall back to inferring it from whichever
          // neighbouring layer in the stack shares this same block id for
          // older scans that only ever recorded the bare name.
          const half = blockProps[plantBid]?.half;
          let suffix;
          if (half === 'upper') suffix = '_top';
          else if (half === 'lower') suffix = '_bottom';
          else {
            const aboveBid = k > 0 ? layerBlockAt(k - 1) : 0;
            suffix = aboveBid === plantBid ? '_bottom' : '_top';
          }
          uvv = uvCache[name + suffix] || getUV(plantBid, 'top') || fallbackUV();
        } else {
          uvv = getUV(plantBid, 'top') || fallbackUV();
        }
        const plantColor = blockCol[plantBid] || new THREE.Color(0xffffff);
        const pr = atlasTex ? plantTc[0] : plantColor.r * plantTc[0];
        const pg = atlasTex ? plantTc[1] : plantColor.g * plantTc[1];
        const pb = atlasTex ? plantTc[2] : plantColor.b * plantTc[2];
        const layerBaseY = wy + (layerCount - k - 1); // top of whatever this layer sits on
        if (isFlatLayer(name)) {
          // Real snow accumulates 1-8 layers deep (a full layers=8 stack is
          // the same height as a solid snow_block); use the actual recorded
          // depth when the scan captured it instead of a fixed thin slab.
          const layers = +blockProps[plantBid]?.layers;
          const frac = layers >= 1 && layers <= 8 ? layers / 8 : 0.1;
          addFlatLayer(wx, layerBaseY + 1, wz, uvv, pr, pg, pb, frac);
        } else {
          addCross(wx, layerBaseY + 1, wz, uvv, pr, pg, pb);
        }
      }

      // SIDE FACES — check 4 neighbours
      for (const {dx, dz, nx, nz} of DIRS4) {
        const nx2 = mx + dx, nz2 = mz + dz;
        if (nx2 < 0 || nx2 >= W || nz2 < 0 || nz2 >= H) continue;
        const nidx = nz2 * W + nx2;
        if (!groundBlock[nidx]) continue; // neighbour has no data - don't fake a cliff toward it
        const nh = groundHeight[nidx];
        if (nh >= my) continue; // neighbor is same height or higher; no exposed face

        // Emit faces from nh+1 to my (run-length merged by block). Depths
        // whose resolved block is air or non-solid - e.g. the empty space
        // under a floating leaf canopy with nothing physically holding it
        // up - are skipped entirely rather than drawn as a wall: there's
        // nothing solid there, so a real Minecraft view would show empty
        // space (or the leaf block's own underside), never a blank cube.
        let runStart = -1, runBid = 0;
        for (let y = nh + 1; y <= my; y++) {
          const depth = my - y;
          const b2 = getBlockAtDepth(idx, depth);
          const solidHere = b2 && !isWalkPast(b2);
          if (runStart >= 0 && solidHere && b2 === runBid) continue; // extend run
          if (runStart >= 0) emitSideFace(wx, wz, runStart, y - 1, dx, dz, nx, nz, runBid, biomeId, pos, norm, uv, col);
          runStart = solidHere ? y : -1;
          runBid = solidHere ? b2 : 0;
        }
        if (runStart >= 0) emitSideFace(wx, wz, runStart, my, dx, dz, nx, nz, runBid, biomeId, pos, norm, uv, col);
      }

      // WATER SURFACE — CCW winding matching addQuad corrected top face
      if (water > my) {
        const wy2 = water;
        wpos.push(
          wx,wy2+1,wz,   wx+1,wy2+1,wz+1, wx+1,wy2+1,wz,   // tri 1: p0,p2,p1 → +Y normal
          wx,wy2+1,wz,   wx,wy2+1,wz+1,   wx+1,wy2+1,wz+1   // tri 2: p0,p3,p2 → +Y normal
        );
        for (let i=0;i<6;i++) { wnorm.push(0,1,0); wuv.push(0,0); }
      }
    }
  }

  function makeGeo(p, n, u, c) {
    if (!p.length) return null;
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(p), 3));
    geo.setAttribute('normal',   new THREE.BufferAttribute(new Float32Array(n), 3));
    geo.setAttribute('uv',       new THREE.BufferAttribute(new Float32Array(u), 2));
    if (c) geo.setAttribute('color', new THREE.BufferAttribute(new Float32Array(c), 3));
    return geo;
  }

  const solidGeo = makeGeo(pos, norm, uv, col);
  const waterGeo = makeGeo(wpos, wnorm, wuv, null);

  const solidMesh = solidGeo ? new THREE.Mesh(solidGeo, solidMat) : null;
  const waterMesh = waterGeo ? new THREE.Mesh(waterGeo, waterMat) : null;
  if (solidMesh) { solidMesh.receiveShadow = true; solidGroup.add(solidMesh); }
  if (waterMesh) waterGroup.add(waterMesh);

  chunks.set(key, { solid: solidMesh, water: waterMesh });
}

function emitSideFace(wx, wz, yBot, yTop, dx, dz, nx, nz, bid, biomeId, pos, norm, uv, col) {
  const uvv = getUV(bid, 'side') || getUV(bid, 'top') || [(ATLAS-TEX)/ATLAS, (ATLAS-TEX)/ATLAS, 1.0, 1.0];
  const bColor = blockCol[bid] || new THREE.Color(0x888888);
  // Side faces need the same biome tint as the top face (this was previously
  // missing entirely, which is why leaves rendered as pale/white blobs - their
  // texture is grayscale and *meant* to be tinted, and only the top face was).
  const tc = getBiomeTint(biomeId, 'side', bid);
  const r = atlasTex ? tc[0] : bColor.r * tc[0];
  const g = atlasTex ? tc[1] : bColor.g * tc[1];
  const b2 = atlasTex ? tc[2] : bColor.b * tc[2];

  // Emit one 1-block-high quad per Y level so the texture tiles correctly (no stretching)
  for (let y = yBot; y <= yTop; y++) {
    let p0, p1, p2, p3;
    if (dx === 1) {
      p0=[wx+1,y,wz];   p1=[wx+1,y,wz+1]; p2=[wx+1,y+1,wz+1]; p3=[wx+1,y+1,wz];
    } else if (dx === -1) {
      p0=[wx,y,wz+1];   p1=[wx,y,wz];     p2=[wx,y+1,wz];     p3=[wx,y+1,wz+1];
    } else if (dz === 1) {
      p0=[wx+1,y,wz+1]; p1=[wx,y,wz+1];   p2=[wx,y+1,wz+1];   p3=[wx+1,y+1,wz+1];
    } else {
      p0=[wx,y,wz];     p1=[wx+1,y,wz];   p2=[wx+1,y+1,wz];   p3=[wx,y+1,wz];
    }
    // uvv=[u0,v0,u1,v1]: face top (y+1) → texture top (v0), face bottom (y) → texture bottom (v1)
    const verts = [p0,p2,p1, p0,p3,p2];
    const uvs = [
      [uvv[0],uvv[3]], [uvv[2],uvv[1]], [uvv[2],uvv[3]],
      [uvv[0],uvv[3]], [uvv[0],uvv[1]], [uvv[2],uvv[1]],
    ];
    for (let i = 0; i < 6; i++) {
      pos.push(...verts[i]);
      norm.push(nx, 0, nz);
      uv.push(...uvs[i]);
      col.push(r, g, b2);
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// CAMERA CONTROLS
// ══════════════════════════════════════════════════════════════════════════════

function updateCamera() {
  const sinPhi = Math.sin(cam.phi), cosPhi = Math.cos(cam.phi);
  const sinTh = Math.sin(cam.theta), cosTh = Math.cos(cam.theta);
  camera.position.set(
    cam.tx + cam.r * sinPhi * sinTh,
    cam.ty + cam.r * cosPhi,
    cam.tz + cam.r * sinPhi * cosTh
  );
  camera.lookAt(cam.tx, cam.ty, cam.tz);
}

function doPan(dx, dy) {
  const right = new THREE.Vector3(), up = new THREE.Vector3(), fwd = new THREE.Vector3();
  camera.matrix.extractBasis(right, up, fwd);
  const spd = cam.r * 0.0015;
  cam.tx -= right.x * dx * spd; cam.tz -= right.z * dx * spd;
  cam.tx += fwd.x * dy * spd * 0.5; cam.tz += fwd.z * dy * spd * 0.5;
  updateCamera();
}

function setupControls(canvas) {
  canvas.addEventListener('mousedown', e => {
    if (e.button === 0) {
      if (planMode !== 'nav') { handlePlanClick(e); return; }
      dragging = true; dragBtn = 0; lx = e.clientX; ly = e.clientY;
    } else if (e.button === 1 || e.button === 2) {
      dragging = true; dragBtn = e.button; lx = e.clientX; ly = e.clientY;
      e.preventDefault();
    }
  });
  canvas.addEventListener('contextmenu', e => e.preventDefault());
  window.addEventListener('mouseup', () => { dragging = false; });
  window.addEventListener('mousemove', e => {
    if (dragging) {
      const dx = e.clientX - lx, dy = e.clientY - ly;
      lx = e.clientX; ly = e.clientY;
      if (dragBtn === 0 || dragBtn === 1) { // left or middle = pan
        doPan(dx, dy);
      } else if (dragBtn === 2) { // right = orbit
        cam.theta -= dx * 0.005;
        cam.phi = Math.max(0.05, Math.min(Math.PI * 0.48, cam.phi + dy * 0.005));
        updateCamera();
      }
    }
    updateCoords(e);
  });
  canvas.addEventListener('wheel', e => {
    cam.r = Math.max(10, Math.min(3000, cam.r * (1 + e.deltaY * 0.001)));
    updateCamera();
    e.preventDefault();
  }, { passive: false });
  window.addEventListener('keydown', e => { keys[e.code] = true; });
  window.addEventListener('keyup',   e => { keys[e.code] = false; });
}

function processKeys() {
  if (!camera) return;
  const spd = Math.max(cam.r * 0.02, 8); // fast enough to cross the map in reasonable time
  const right = new THREE.Vector3(), up = new THREE.Vector3(), fwd = new THREE.Vector3();
  camera.matrix.extractBasis(right, up, fwd);
  fwd.y = 0; fwd.normalize(); right.y = 0; right.normalize();
  if (keys['KeyW'] || keys['ArrowUp'])   { cam.tx -= fwd.x*spd; cam.tz -= fwd.z*spd; }
  if (keys['KeyS'] || keys['ArrowDown']) { cam.tx += fwd.x*spd; cam.tz += fwd.z*spd; }
  if (keys['KeyA'] || keys['ArrowLeft']) { cam.tx -= right.x*spd; cam.tz -= right.z*spd; }
  if (keys['KeyD'] || keys['ArrowRight']){ cam.tx += right.x*spd; cam.tz += right.z*spd; }
  if (keys['Space'])     cam.ty += spd;
  if (keys['ShiftLeft']) cam.ty -= spd;
  if (Object.values(keys).some(Boolean)) updateCamera();
}

// ══════════════════════════════════════════════════════════════════════════════
// CHUNK MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════════

function updateChunks() {
  const camChunkX = Math.floor(camera.position.x / CHUNK);
  const camChunkZ = Math.floor(camera.position.z / CHUNK);
  const maxCX = Math.ceil(W / CHUNK), maxCZ = Math.ceil(H / CHUNK);
  const queued = new Set(chunkQueue.map(c => c.key));

  // Queue chunks sorted closest-first
  for (let dz = -RENDER_DIST; dz <= RENDER_DIST; dz++) {
    for (let dx = -RENDER_DIST; dx <= RENDER_DIST; dx++) {
      const d2 = dx*dx + dz*dz;
      if (d2 > RENDER_DIST * RENDER_DIST) continue;
      const cx = camChunkX + dx, cz = camChunkZ + dz;
      if (cx < 0 || cz < 0 || cx >= maxCX || cz >= maxCZ) continue;
      const key = cx + '_' + cz;
      if (!chunks.has(key) && !queued.has(key)) {
        chunkQueue.push({ cx, cz, key, d2 });
        queued.add(key);
      }
    }
  }
  chunkQueue.sort((a, b) => a.d2 - b.d2);

  // Unload distant chunks
  for (const [key, ch] of chunks) {
    const [cx, cz] = key.split('_').map(Number);
    if (Math.abs(cx - camChunkX) > RENDER_DIST + 3 || Math.abs(cz - camChunkZ) > RENDER_DIST + 3) {
      if (ch.solid) { solidGroup.remove(ch.solid); ch.solid.geometry.dispose(); }
      if (ch.water) { waterGroup.remove(ch.water); ch.water.geometry.dispose(); }
      chunks.delete(key);
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// ANIMATION
// ══════════════════════════════════════════════════════════════════════════════

let lastChunkUpdate = 0;
const CHUNKS_PER_FRAME = 3;
let statsEl = null;
let frameCount = 0;
function animate() {
  animId = requestAnimationFrame(animate);
  processKeys();
  // Build a few queued chunks per frame to avoid freezing the main thread
  for (let i = 0; i < CHUNKS_PER_FRAME && chunkQueue.length > 0; i++) {
    const c = chunkQueue.shift();
    if (!chunks.has(c.key)) buildChunk(c.cx, c.cz);
  }
  const now = performance.now();
  if (now - lastChunkUpdate > 300) { updateChunks(); lastChunkUpdate = now; }
  renderer.render(scene, camera);
  // Stats overlay (every 30 frames)
  frameCount++;
  if (frameCount % 30 === 0) {
    if (!statsEl) statsEl = document.getElementById('mv-stats');
    if (statsEl) {
      const loaded = chunks.size, queued = chunkQueue.length;
      const camP = camera.position;
      const texCount = Object.keys(blockUV).length;
      statsEl.innerHTML = `World: ${W}×${H} | Chunks: ${loaded} loaded, ${queued} queued<br>Cam: ${Math.round(camP.x)}, ${Math.round(camP.y)}, ${Math.round(camP.z)}<br>Atlas: ${atlasTex ? 'loaded' : 'MISSING'} | blockUV: ${texCount} entries`;
    }
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// COORDINATE READOUT
// ══════════════════════════════════════════════════════════════════════════════

const coordsEl = document.getElementById('mv-coords');
function updateCoords(e) {
  if (!camera || !scene) return;
  const canvas = document.getElementById('mv-canvas');
  const rect = canvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  const my = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera({ x: mx, y: my }, camera);
  // Cast against a rough terrain plane at average height
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -(minY + 80));
  const hit = new THREE.Vector3();
  raycaster.ray.intersectPlane(plane, hit);
  if (hit) coordsEl.textContent = `X: ${Math.round(hit.x)}  Y: ${Math.round(-hit.y)}  Z: ${Math.round(hit.z)}`;
}

// ══════════════════════════════════════════════════════════════════════════════
// PLANNING TOOLS
// ══════════════════════════════════════════════════════════════════════════════

function setTool(mode) {
  planMode = mode;
  document.querySelectorAll('.mv-tool').forEach(el => el.classList.remove('active'));
  const toolMap = { nav: 'tool-nav', spawn: null, mining: null, contested: null, polygon: null, label: null };
  const id = 'tool-' + mode;
  const el = document.getElementById(id);
  if (el) el.classList.add('active');
  else document.querySelectorAll('.mv-tool').forEach(el => { if (el.textContent.trim().toLowerCase().includes(mode)) el.classList.add('active'); });
  document.getElementById('mv-poly-finish').style.display = mode === 'polygon' ? '' : 'none';
  if (mode !== 'polygon') { polyPts = []; if (polyLine) { planGroup.remove(polyLine); polyLine = null; } }
}

function getTerrainHit(e) {
  const canvas = document.getElementById('mv-canvas');
  const rect = canvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  const my = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  raycaster.setFromCamera({ x: mx, y: my }, camera);
  // Cast against elevated plane for approximate hit
  const plane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -(minY + 80));
  const hit = new THREE.Vector3();
  return raycaster.ray.intersectPlane(plane, hit) ? hit : null;
}

function handlePlanClick(e) {
  const hit = getTerrainHit(e);
  if (!hit) return;
  if (planMode === 'polygon') {
    polyPts.push(hit.clone());
    updatePolyLine();
    return;
  }
  if (planMode === 'label') {
    pendingLabelPos = hit.clone();
    const li = document.getElementById('mv-label-input');
    li.style.display = '';
    document.getElementById('mv-label-text').focus();
    return;
  }
  if (['spawn','mining','contested'].includes(planMode)) {
    placeMarker(hit, planMode);
  }
}

function placeMarker(pos, type) {
  const color = new THREE.Color(planColors[type]);
  const geo = new THREE.SphereGeometry(3, 8, 6);
  const mat = new THREE.MeshBasicMaterial({ color });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.position.copy(pos).setY(pos.y + 4);
  planGroup.add(mesh);
  const item = { type, pos: { x: Math.round(pos.x), y: Math.round(pos.y), z: Math.round(pos.z) }, mesh };
  plan.markers.push(item);
  refreshPlanUI();
}

function updatePolyLine() {
  if (polyLine) { planGroup.remove(polyLine); polyLine = null; }
  if (polyPts.length < 2) return;
  const geo = new THREE.BufferGeometry().setFromPoints(polyPts.map(p => p.clone().setY(p.y + 2)));
  polyLine = new THREE.Line(geo, new THREE.LineBasicMaterial({ color: 0x74c0fc, linewidth: 2 }));
  planGroup.add(polyLine);
}

function finishPolygon() {
  if (polyPts.length < 3) { alert('Need at least 3 points for a border.'); return; }
  const pts = polyPts.map(p => ({ x: Math.round(p.x), y: Math.round(p.y), z: Math.round(p.z) }));
  plan.polygons.push({ pts, mesh: polyLine });
  polyPts = []; polyLine = null;
  refreshPlanUI();
}

function confirmLabel() {
  const text = document.getElementById('mv-label-text').value.trim();
  if (!text || !pendingLabelPos) return;
  document.getElementById('mv-label-input').style.display = 'none';
  document.getElementById('mv-label-text').value = '';
  const pos = pendingLabelPos;
  pendingLabelPos = null;
  plan.labels.push({ text, pos: { x: Math.round(pos.x), y: Math.round(pos.y), z: Math.round(pos.z) } });
  // Sprite label
  const c = document.createElement('canvas'); c.width = 256; c.height = 64;
  const ctx = c.getContext('2d');
  ctx.fillStyle = 'rgba(17,18,22,0.85)'; ctx.roundRect(4,4,248,56,10); ctx.fill();
  ctx.fillStyle = '#e0e2ed'; ctx.font = 'bold 24px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
  ctx.fillText(text, 128, 32);
  const tex = new THREE.CanvasTexture(c);
  const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, depthTest: false }));
  sprite.position.copy(pos).setY(pos.y + 20);
  sprite.scale.set(40, 10, 1);
  planGroup.add(sprite);
  refreshPlanUI();
}

function cancelLabel() {
  document.getElementById('mv-label-input').style.display = 'none';
  document.getElementById('mv-label-text').value = '';
  pendingLabelPos = null;
}

// ══════════════════════════════════════════════════════════════════════════════
// PLAN UI
// ══════════════════════════════════════════════════════════════════════════════

function refreshPlanUI() {
  const list = document.getElementById('mv-plan-list');
  const total = plan.markers.length + plan.polygons.length + plan.labels.length;
  document.getElementById('mv-plan-count').textContent = total + ' item' + (total !== 1 ? 's' : '');
  list.innerHTML = '';
  plan.markers.forEach((m, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors[m.type]}"></span>${m.type} (${m.pos.x},${m.pos.z})<span class="mv-plan-del" onclick="deleteMarker(${i})">✕</span>`;
    list.appendChild(d);
  });
  plan.polygons.forEach((p, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors.polygon}"></span>Border (${p.pts.length} pts)<span class="mv-plan-del" onclick="deletePolygon(${i})">✕</span>`;
    list.appendChild(d);
  });
  plan.labels.forEach((l, i) => {
    const d = document.createElement('div'); d.className = 'mv-plan-item';
    d.innerHTML = `<span class="mv-plan-dot" style="background:${planColors.label}"></span>"${l.text}"<span class="mv-plan-del" onclick="deleteLabel(${i})">✕</span>`;
    list.appendChild(d);
  });
}

window.deleteMarker = i => {
  const m = plan.markers.splice(i, 1)[0];
  if (m.mesh) { planGroup.remove(m.mesh); m.mesh.geometry.dispose(); }
  refreshPlanUI();
};
window.deletePolygon = i => {
  const p = plan.polygons.splice(i, 1)[0];
  if (p.mesh) { planGroup.remove(p.mesh); p.mesh.geometry.dispose(); }
  refreshPlanUI();
};
window.deleteLabel = i => { plan.labels.splice(i, 1); refreshPlanUI(); };

// ══════════════════════════════════════════════════════════════════════════════
// EXPORT / SAVE / LOAD
// ══════════════════════════════════════════════════════════════════════════════

function exportPNG() {
  renderer.render(scene, camera);
  const url = renderer.domElement.toDataURL('image/png');
  const a = document.createElement('a'); a.href = url; a.download = 'map-view.png'; a.click();
}

function savePlan() {
  const data = {
    markers: plan.markers.map(m => ({ type: m.type, pos: m.pos })),
    polygons: plan.polygons.map(p => ({ pts: p.pts })),
    labels: plan.labels.map(l => ({ text: l.text, pos: l.pos })),
  };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'event-plan.json'; a.click();
}

window.loadPlanFile = function(input) {
  const file = input.files[0]; if (!file) return;
  file.text().then(t => {
    const data = JSON.parse(t);
    (data.markers || []).forEach(m => placeMarker(new THREE.Vector3(m.pos.x, m.pos.y, m.pos.z), m.type));
    refreshPlanUI();
  });
  input.value = '';
};

// ══════════════════════════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════════════════════════

function showProgress(visible, text, err) {
  const el = document.getElementById('mv-progress');
  el.style.display = visible ? 'flex' : 'none';
  if (text) document.getElementById('mv-prog-text').textContent = text;
  const errEl = document.getElementById('mv-prog-err');
  if (err) { errEl.textContent = err; errEl.style.display = ''; }
  else errEl.style.display = 'none';
}

// Expose globals needed by inline onclick handlers
window.setTool = setTool;
window.finishPolygon = finishPolygon;
window.confirmLabel = confirmLabel;
window.cancelLabel = cancelLabel;
window.savePlan = savePlan;
window.exportPNG = exportPNG;

})();
</script>

