<%- include('partials/head', { pageTitle: 'Map Viewer' }) %>
<%- include('partials/header') %>

<style>
#mv-root{position:fixed;top:64px;left:0;right:0;bottom:0;background:#0c0d10;display:flex;flex-direction:column;overflow:hidden}
/* Load panel */
#mv-load{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;gap:20px;padding:40px}
#mv-load h2{font-family:'Baloo 2';font-weight:800;font-size:22px;color:#e0e2ed;margin:0}
#mv-load p{font-size:13px;color:var(--muted);margin:0;max-width:480px;text-align:center;line-height:1.7}
.mv-drop{border:2px dashed rgba(255,255,255,.15);border-radius:16px;padding:40px 60px;text-align:center;cursor:pointer;transition:border-color .2s,background .2s}
.mv-drop:hover,.mv-drop.dragover{border-color:rgba(91,227,143,.5);background:rgba(91,227,143,.04)}
.mv-drop input{display:none}
.mv-drop-icon{font-size:40px;margin-bottom:12px;opacity:.5}
.mv-drop-label{font-family:'Baloo 2';font-weight:700;font-size:14px;color:#c9ccdb}
.mv-drop-sub{font-size:12px;color:var(--muted);margin-top:4px}
.mv-files-hint{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;padding:14px 18px;font-size:12px;color:var(--muted);font-family:monospace;text-align:left;line-height:1.8}
/* Viewer layout */
#mv-viewer{display:none;flex:1;position:relative;overflow:hidden;flex-direction:column}
#mv-canvas{display:block;width:100%!important;height:100%!important;flex:1}
/* Progress overlay */
#mv-progress{display:none;position:absolute;inset:0;background:rgba(12,13,16,.92);z-index:200;flex-direction:column;align-items:center;justify-content:center;gap:14px}
#mv-progress p{font-family:'Baloo 2';font-weight:700;font-size:14px;color:#e0e2ed;margin:0}
.mv-prog-bar{width:260px;height:4px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden}
.mv-prog-fill{height:100%;width:60%;background:linear-gradient(90deg,#22863a,#5be38f);border-radius:4px;animation:mvprog 1.2s ease-in-out infinite alternate}
@keyframes mvprog{from{width:20%}to{width:80%}}
/* Toolbar */
#mv-toolbar{position:absolute;top:14px;left:14px;z-index:10;display:flex;flex-direction:column;gap:6px}
.mv-tool{background:rgba(17,18,22,.9);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-family:'Baloo 2';font-weight:700;font-size:12px;color:var(--muted);cursor:pointer;white-space:nowrap;transition:border-color .15s,color .15s}
.mv-tool:hover{border-color:rgba(91,227,143,.4);color:#c9ccdb}
.mv-tool.active{border-color:rgba(91,227,143,.6);color:#5be38f;background:rgba(91,227,143,.06)}
/* Coords */
#mv-coords{position:absolute;bottom:14px;left:14px;z-index:10;background:rgba(17,18,22,.85);border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-family:monospace;font-size:12px;color:#c9ccdb}
/* Info panel */
#mv-panel{position:absolute;top:14px;right:14px;z-index:10;width:220px;background:rgba(17,18,22,.92);border:1px solid var(--line);border-radius:12px;overflow:hidden}
#mv-panel-header{padding:10px 14px;font-family:'Baloo 2';font-weight:800;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
#mv-plan-list{max-height:320px;overflow-y:auto;padding:6px}
.mv-plan-item{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:6px;font-family:'Baloo 2';font-weight:700;font-size:12px;color:#c9ccdb}
.mv-plan-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.mv-plan-del{margin-left:auto;cursor:pointer;color:var(--muted);font-size:10px;opacity:.6}
.mv-plan-del:hover{opacity:1;color:#f87171}
#mv-panel-actions{padding:8px;border-top:1px solid var(--line);display:flex;gap:6px}
.mv-act{flex:1;background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:6px;padding:5px 0;font-family:'Baloo 2';font-weight:700;font-size:11px;color:var(--muted);cursor:pointer;text-align:center}
.mv-act:hover{background:rgba(255,255,255,.09);color:#e0e2ed}
/* Poly finish button */
#mv-poly-finish{display:none;position:absolute;bottom:50px;left:50%;transform:translateX(-50%);z-index:20;background:#22863a;color:#fff;border:none;border-radius:8px;padding:8px 22px;font-family:'Baloo 2';font-weight:800;font-size:13px;cursor:pointer}
/* Label input */
#mv-label-input{display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:30;background:rgba(17,18,22,.96);border:1px solid var(--line);border-radius:12px;padding:20px;min-width:260px}
#mv-label-input input{width:100%;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-family:'Baloo 2';font-weight:700;font-size:14px;color:#fff;outline:none;box-sizing:border-box}
#mv-label-input .mv-li-btns{display:flex;gap:8px;margin-top:10px}
#mv-label-input button{flex:1;padding:7px;border-radius:7px;font-family:'Baloo 2';font-weight:800;font-size:12px;cursor:pointer;border:none}
</style>

<div id="mv-root">
  <!-- Progress overlay (covers whole root) -->
  <div id="mv-progress">
    <p id="mv-prog-text">Loading…</p>
    <div class="mv-prog-bar"><div class="mv-prog-fill"></div></div>
    <p id="mv-prog-err" style="color:#f87171;font-size:12px;max-width:400px;text-align:center;display:none"></p>
  </div>

  <!-- ── File load panel ── -->
  <div id="mv-load">
    <h2>Map Viewer</h2>
    <p>Load your scanner output to view the world in 3D. Block textures are loaded automatically.</p>
    <div class="mv-drop" id="mv-drop">
      <input type="file" id="mv-file-input" multiple accept=".json,.png,.bin" style="display:none">
      <input type="file" id="mv-folder-input" webkitdirectory style="display:none">
      <div class="mv-drop-icon">📂</div>
      <div class="mv-drop-label">Drop the scan3d-output folder here</div>
      <div class="mv-drop-sub" style="margin-bottom:14px">Or use one of the buttons below</div>
      <div style="display:flex;gap:10px;justify-content:center">
        <button onclick="event.stopPropagation();document.getElementById('mv-folder-input').click()" style="background:rgba(91,227,143,.12);border:1px solid rgba(91,227,143,.3);color:#5be38f;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:8px 18px;border-radius:8px;cursor:pointer">Select Folder</button>
        <button onclick="event.stopPropagation();document.getElementById('mv-file-input').click()" style="background:rgba(255,255,255,.05);border:1px solid var(--line);color:var(--muted);font-family:'Baloo 2';font-weight:700;font-size:13px;padding:8px 18px;border-radius:8px;cursor:pointer">Select Files</button>
      </div>
    </div>
    <div class="mv-files-hint">
      Required: meta.json &nbsp;·&nbsp; palette.json &nbsp;·&nbsp; biome_palette.json<br>
      &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; heightmap.png &nbsp;·&nbsp; blocks.bin &nbsp;·&nbsp; biomes.bin
    </div>
  </div>

  <!-- ── 3D viewer ── -->
  <div id="mv-viewer">
    <canvas id="mv-canvas"></canvas>

    <div id="mv-toolbar">
      <div class="mv-tool" id="tool-nav" onclick="setTool('nav')">✦ Navigate</div>
      <div style="height:6px"></div>
      <div class="mv-tool" onclick="setTool('spawn')">⊕ Spawn Zone</div>
      <div class="mv-tool" onclick="setTool('mining')">⊕ Mining Zone</div>
      <div class="mv-tool" onclick="setTool('contested')">⊕ Contested Zone</div>
      <div class="mv-tool" onclick="setTool('polygon')">⬡ Draw Border</div>
      <div class="mv-tool" onclick="setTool('label')">T Label</div>
      <div style="height:6px"></div>
      <div class="mv-tool" onclick="exportPNG()">↓ Export PNG</div>
    </div>

    <div id="mv-coords">X: — &nbsp;Y: — &nbsp;Z: —</div>
    <div id="mv-stats" style="position:absolute;bottom:14px;right:14px;z-index:10;background:rgba(17,18,22,.85);border:1px solid var(--line);border-radius:8px;padding:6px 12px;font-family:monospace;font-size:11px;color:var(--muted);line-height:1.6"></div>

    <div id="mv-panel">
      <div id="mv-panel-header">
        Plan
        <span id="mv-plan-count" style="font-weight:600;color:var(--muted)">0 items</span>
      </div>
      <div id="mv-plan-list"></div>
      <div id="mv-panel-actions">
        <div class="mv-act" onclick="savePlan()">Save JSON</div>
        <div class="mv-act" onclick="document.getElementById('mv-plan-file').click()">Load JSON</div>
        <input type="file" id="mv-plan-file" accept=".json" style="display:none" onchange="loadPlanFile(this)">
      </div>
    </div>

    <button id="mv-poly-finish" onclick="finishPolygon()">Finish Border</button>

    <div id="mv-label-input">
      <input id="mv-label-text" type="text" placeholder="Enter label text…" onkeydown="if(event.key==='Enter')confirmLabel()">
      <div class="mv-li-btns">
        <button onclick="confirmLabel()" style="background:#22863a;color:#fff">Add</button>
        <button onclick="cancelLabel()" style="background:rgba(255,255,255,.06);border:1px solid var(--line);color:var(--muted)">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/upng-js@2.1.0/UPNG.js"></script>
<script>
(function () {
'use strict';

// ── Constants ─────────────────────────────────────────────────────────────────
const CHUNK = 32;
const RENDER_DIST = 12; // chunks
const ATLAS = 1024;     // atlas texture side (pixels) — 64×64 = 4096 slots
const TEX = 16;         // block texture size

// ── World state ───────────────────────────────────────────────────────────────
let meta, paletteArr, biomePal;
let heights, surface, waterArr, biomes;
// Per-column material below the surface, run-length encoded (see parseBlocksBin):
// column i's runs are runBlockIds[runStart[i] .. runStart[i]+runCount[i]) with
// matching runLengths - e.g. a column with 3 leaf blocks then 40 blocks of air
// then a log is 3 runs, regardless of how deep the air gap is. This replaced a
// fixed-size "skirt" array (a flat N-blocks-below-surface window) specifically
// because a fixed shallow window couldn't reach past a tall tree's vertical
// foliage gaps - the real gap between two leaf clusters is very often deeper
// than any fixed window short enough to stay cheap for the other 99% of
// (boring, uniform) columns. Run-length encoding costs almost nothing extra
// for uniform ground (still ~2-3 runs no matter how deep you scan) while
// scaling with a column's actual complexity, so scanning much deeper is free
// for the common case and correct for the rare one.
let runBlockIds, runLengths, runStart, runCount;
// Derived once after loading (see computeGroundHeights): groundHeight/groundBlock
// are the *solid* terrain's top Y and block - equal to heights/surface for an
// ordinary solid surface, but shifted down for columns whose surface is a
// decorative plant (grass, flowers...), whose real solid ground is found by
// walking that column's runs. plantShift counts how many depth-units of
// non-solid material sit above the real ground (0 for an ordinary column) so
// getBlockAtDepth can offset its run-walking to match. The plant itself is
// drawn separately as a cross.
let groundHeight, groundBlock, plantShift;
let W = 0, H = 0, minY = 0, maxDepth = 64;

// ── Three.js ──────────────────────────────────────────────────────────────────
let scene, camera, renderer;
let solidMat, waterMat, planeMat;
let solidGroup, waterGroup, planGroup;
let chunks = new Map();
let chunkQueue = [];
let animId = null;

// ── Textures ──────────────────────────────────────────────────────────────────
let atlasTex = null;
let waterTex = null;
let uvCache = {};    // texName -> [u0,v0,u1,v1]
let blockUV = {};    // blockId -> {top,side,bottom} each [u0,v0,u1,v1]
let blockCol = {};   // blockId -> THREE.Color (fallback)

// ── Camera ────────────────────────────────────────────────────────────────────
const cam = { theta: 0.6, phi: 0.35, r: 300, tx: 0, ty: 0, tz: 0 };
const keys = {};
let dragging = false, dragBtn = -1, lx = 0, ly = 0;
let pendingLabelPos = null;

// ── Planning ──────────────────────────────────────────────────────────────────
let planMode = 'nav';
let polyPts = [], polyLine = null;
let plan = { markers: [], polygons: [], labels: [] };
const raycaster = new THREE.Raycaster();
const planColors = { spawn: '#5be38f', mining: '#fbbf24', contested: '#f87171', polygon: '#74c0fc', label: '#e0e2ed' };

// ══════════════════════════════════════════════════════════════════════════════
// FILE UI
// ══════════════════════════════════════════════════════════════════════════════

const drop = document.getElementById('mv-drop');
const fileInput = document.getElementById('mv-file-input');
const folderInput = document.getElementById('mv-folder-input');

drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('dragover'); });
drop.addEventListener('dragleave', () => drop.classList.remove('dragover'));
drop.addEventListener('drop', async e => {
  e.preventDefault(); drop.classList.remove('dragover');
  const map = new Map();
  const items = [...(e.dataTransfer.items || [])];
  await Promise.all(items.map(item => {
    if (item.kind !== 'file') return;
    const entry = item.webkitGetAsEntry ? item.webkitGetAsEntry() : null;
    if (entry && entry.isDirectory) return readDir(entry, map);
    const f = item.getAsFile();
    if (f) map.set(f.name, f);
  }));
  startLoad(map);
});

fileInput.addEventListener('change', () => {
  const map = new Map();
  for (const f of fileInput.files) map.set(f.name, f);
  startLoad(map);
});
folderInput.addEventListener('change', () => {
  const map = new Map();
  for (const f of folderInput.files) map.set(f.name, f);
  startLoad(map);
});

function readDir(dirEntry, map) {
  return new Promise(res => {
    const reader = dirEntry.createReader();
    const readAll = () => reader.readEntries(async entries => {
      if (!entries.length) return res();
      await Promise.all(entries.map(e => e.isDirectory ? readDir(e, map) : new Promise(r => e.file(f => { map.set(f.name, f); r(); }))));
      readAll();
    });
    readAll();
  });
}

function startLoad(map) {
  const required = ['meta.json','palette.json','biome_palette.json','heightmap.png','blocks.bin','biomes.bin'];
  const missing = required.filter(r => !map.has(r));
  if (missing.length) { alert('Missing required files:\n' + missing.join('\n')); return; }
  loadWorld(map);
}

// ══════════════════════════════════════════════════════════════════════════════
// DATA LOADING
// ══════════════════════════════════════════════════════════════════════════════

async function loadWorld(files) {
  try {
    showProgress(true, 'Parsing JSON…');
    meta = JSON.parse(await files.get('meta.json').text());
    const rawPalette = JSON.parse(await files.get('palette.json').text());
    const rawBiome   = JSON.parse(await files.get('biome_palette.json').text());

    // Normalise palette to array of {id, name, textures}
    paletteArr = Array.isArray(rawPalette)
      ? rawPalette
      : Object.entries(rawPalette).map(([k, v]) =>
          typeof v === 'object' ? { id: isNaN(k) ? v.id ?? k : +k, name: v.name ?? k, textures: v.textures, ...v }
                                : { id: +k, name: String(v) });
    // The scan mod can record blockstate Properties alongside the block
    // Name, e.g. "minecraft:snow[layers=3]" or "minecraft:oak_log[axis=y]"
    // (older scans, or blocks with no properties, are just the bare name).
    // Strip the "minecraft:" prefix and split off "[...]" into a separate
    // props object here, once, so every other lookup in this file can keep
    // treating b.name as a plain bare name like before - only the few
    // property-aware call sites (see e.g. isFlatLayer's layers handling,
    // DOUBLE_TALL's half handling) need to look at b.props.
    for (const b of paletteArr) {
      let n = (b.name || '').replace(/^minecraft:/, '');
      const bracket = n.indexOf('[');
      b.props = {};
      if (bracket >= 0) {
        const propsStr = n.slice(bracket + 1, n.endsWith(']') ? -1 : undefined);
        n = n.slice(0, bracket);
        for (const pair of propsStr.split(',')) {
          const eq = pair.indexOf('=');
          if (eq > 0) b.props[pair.slice(0, eq)] = pair.slice(eq + 1);
        }
      }
      b.name = n;
    }
    // Normalise biome palette to array of {id, ...}
    biomePal = Array.isArray(rawBiome)
      ? rawBiome
      : Object.entries(rawBiome).map(([k, v]) =>
          typeof v === 'object' ? { id: isNaN(k) ? v.id ?? k : +k, ...v }
                                : { id: +k, name: String(v) });

    console.log('meta:', JSON.stringify(meta));

    W = meta.width ?? meta.worldWidth ?? meta.sizeX ?? meta.size ?? 0;
    H = meta.height ?? meta.worldHeight ?? meta.worldDepth ?? meta.depth ?? meta.length ?? meta.sizeZ ?? meta.worldLength ?? W;
    minY = meta.minHeight ?? meta.minY ?? meta.minY ?? -64;
    maxDepth = meta.maxDepth ?? 64;
    if (meta.blocksFormatVersion !== 2) {
      throw new Error(`This scan uses an old blocks.bin format (blocksFormatVersion=${meta.blocksFormatVersion ?? 'none'}) that this viewer no longer reads - please re-run /scan3d with the updated mod to produce a new scan.`);
    }

    if (!W || !H) throw new Error(`Could not read world dimensions. meta.json keys: ${Object.keys(meta).join(', ')}`);

    showProgress(true, 'Loading heightmap…');
    heights = await parseHeightmap(files.get('heightmap.png'));

    showProgress(true, 'Parsing blocks.bin…');
    const bl = parseBlocksBin(await files.get('blocks.bin').arrayBuffer());
    surface = bl.surface; waterArr = bl.water;
    runBlockIds = bl.runBlockIds; runLengths = bl.runLengths; runStart = bl.runStart; runCount = bl.runCount;

    showProgress(true, 'Parsing biomes.bin…');
    biomes = parseBiomesBin(await files.get('biomes.bin').arrayBuffer());

    buildBlockColors();
    computeGroundHeights();

    // Auto-load Minecraft textures from server
    showProgress(true, 'Loading block textures…');
    await autoLoadTextures();

    // Compute center terrain height for camera positioning
    const ci = Math.floor(H / 2) * W + Math.floor(W / 2);
    const centerH = isFinite(heights[ci]) ? heights[ci] : 64;
    const nonZeroBlocks = [surface[ci], surface[ci+1], surface[ci+2], surface[ci-1], surface[ci-2]].filter(Boolean);

    // Debug dump — visible in F12 console
    console.log('[MapViewer] World:', W, 'x', H, '| minY:', minY, '| maxDepth:', maxDepth);
    console.log('[MapViewer] Center height:', centerH, '| Center block IDs:', surface[ci], surface[ci+1], surface[ci+2]);
    console.log('[MapViewer] Height range:', Math.min(...Array.from(heights).slice(0,1000)), '-', Math.max(...Array.from(heights).slice(0,1000)));
    console.log('[MapViewer] Palette entries 0-5:', paletteArr.slice(0,6).map(b=>`${b.id}:${b.name}`).join(', '));
    console.log('[MapViewer] Surface sample (first 10):', Array.from(surface.slice(0, 10)).join(','));
    console.log('[MapViewer] heights sample (first 10):', Array.from(heights.slice(0, 10)).join(','));

    showProgress(true, 'Initialising scene…');
    // Show viewer first so the canvas has real dimensions before Three.js inits
    document.getElementById('mv-load').style.display = 'none';
    document.getElementById('mv-viewer').style.display = 'flex';
    await new Promise(r => requestAnimationFrame(r));
    initScene(centerH);
    showProgress(false);
    setTool('nav');
    animate();
  } catch (err) {
    console.error('Map load error:', err);
    showProgress(true, 'Failed to load — check the browser console (F12) for details', String(err));
  }
}

async function parseHeightmap(file) {
  const ab = await file.arrayBuffer();
  try {
    return await parsePNG16Gray(new Uint8Array(ab));
  } catch (e) {
    console.warn('[MapViewer] 16-bit PNG decode failed, using 8-bit canvas fallback:', e.message);
  }
  // Canvas 8-bit fallback (loses precision for heights > 255)
  return new Promise(res => {
    const img = new Image();
    img.onload = () => {
      const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
      const ctx = c.getContext('2d'); ctx.drawImage(img, 0, 0);
      const d = ctx.getImageData(0, 0, img.width, img.height).data;
      const out = new Float32Array(img.width * img.height);
      for (let i = 0; i < out.length; i++) out[i] = d[i*4] + minY; // 8-bit gray → R channel
      URL.revokeObjectURL(img.src); res(out);
    };
    img.onerror = () => res(new Float32Array(W * H).fill(minY));
    img.src = URL.createObjectURL(new Blob([ab]));
  });
}

// Direct 16-bit grayscale PNG decoder — UPNG always converts to 8-bit which
// destroys precision for values < 256, so we parse raw bytes ourselves.
async function parsePNG16Gray(bytes) {
  if (bytes[0] !== 137 || bytes[1] !== 80) throw new Error('Not a PNG');
  const dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  let off = 8, imgW = 0, imgH = 0, depth = 0, colorType = 0;
  const idatParts = [];

  while (off + 12 <= bytes.length) {
    const len = dv.getUint32(off); off += 4;
    const type = String.fromCharCode(bytes[off], bytes[off+1], bytes[off+2], bytes[off+3]); off += 4;
    if (type === 'IHDR') {
      imgW = dv.getUint32(off); imgH = dv.getUint32(off+4);
      depth = bytes[off+8]; colorType = bytes[off+9];
    } else if (type === 'IDAT') {
      idatParts.push(bytes.slice(off, off + len));
    } else if (type === 'IEND') { break; }
    off += len + 4;
  }

  if (!imgW || !imgH) throw new Error('IHDR not found');
  if (depth !== 16 || colorType !== 0) throw new Error(`depth=${depth} ctype=${colorType} — not 16-bit grayscale`);

  // Concatenate all IDAT chunks then decompress (zlib = deflate with 2-byte header)
  const totalLen = idatParts.reduce((s, p) => s + p.length, 0);
  const idat = new Uint8Array(totalLen);
  let pos = 0;
  for (const p of idatParts) { idat.set(p, pos); pos += p.length; }

  const ds = new DecompressionStream('deflate');
  const w2 = ds.writable.getWriter(), r2 = ds.readable.getReader();
  w2.write(idat); w2.close();

  const rawChunks = []; let rawTotal = 0;
  while (true) {
    const { done, value } = await r2.read();
    if (done) break;
    rawChunks.push(value); rawTotal += value.length;
  }
  const raw = new Uint8Array(rawTotal);
  pos = 0;
  for (const c of rawChunks) { raw.set(c, pos); pos += c.length; }

  // Apply PNG reverse filters scanline by scanline, extract u16 big-endian pixels
  const bpp = 2; // 1 channel × 2 bytes
  const stride = imgW * bpp;
  const out = new Float32Array(imgW * imgH);
  let prev = new Uint8Array(stride), rawOff = 0;

  for (let y = 0; y < imgH; y++) {
    const ft = raw[rawOff++];
    const curr = raw.slice(rawOff, rawOff + stride); rawOff += stride;
    if (ft === 1) { // Sub
      for (let i = bpp; i < stride; i++) curr[i] = (curr[i] + curr[i-bpp]) & 0xFF;
    } else if (ft === 2) { // Up
      for (let i = 0; i < stride; i++) curr[i] = (curr[i] + prev[i]) & 0xFF;
    } else if (ft === 3) { // Average
      for (let i = 0; i < stride; i++) {
        const a = i >= bpp ? curr[i-bpp] : 0;
        curr[i] = (curr[i] + Math.floor((a + prev[i]) / 2)) & 0xFF;
      }
    } else if (ft === 4) { // Paeth
      for (let i = 0; i < stride; i++) {
        const a = i >= bpp ? curr[i-bpp] : 0, b = prev[i], c2 = i >= bpp ? prev[i-bpp] : 0;
        const p2 = a + b - c2, pa = Math.abs(p2-a), pb = Math.abs(p2-b), pc2 = Math.abs(p2-c2);
        curr[i] = (curr[i] + (pa <= pb && pa <= pc2 ? a : pb <= pc2 ? b : c2)) & 0xFF;
      }
    }
    for (let x = 0; x < imgW; x++) out[y * imgW + x] = ((curr[x*2] << 8) | curr[x*2+1]) + minY;
    prev = curr;
  }
  return out;
}

function parseBlocksBin(ab) {
  const dv = new DataView(ab);
  // header: width,length,maxDepth,originX,originZ,resolution = 6 × int32 = 24 bytes
  // (values already known from meta.json - this just skips past them). Each
  // column is now variable-length: surfaceId (u16), runCount (u16), then
  // runCount × [blockId (u16), runLength (u16)], then waterY (i16) - see
  // meta.json's blocksBinLayout note for the authoritative format.
  let off = 24;
  const cols = W * H;
  const surf = new Uint16Array(cols);
  const wat = new Int16Array(cols);
  const rStart = new Int32Array(cols);
  const rCount = new Uint16Array(cols);

  // Total run count isn't known up front - grow the flat run buffers as needed.
  let cap = cols * 4; // average-case guess; wrong guesses just cost a realloc
  let rBlock = new Uint16Array(cap);
  let rLen = new Uint16Array(cap);
  let w = 0;
  function ensureCap(extra) {
    if (w + extra <= cap) return;
    cap = Math.max(cap * 2, w + extra);
    const nb = new Uint16Array(cap); nb.set(rBlock.subarray(0, w)); rBlock = nb;
    const nl = new Uint16Array(cap); nl.set(rLen.subarray(0, w)); rLen = nl;
  }

  for (let i = 0; i < cols; i++) {
    surf[i] = dv.getUint16(off, false); off += 2;
    const rc = dv.getUint16(off, false); off += 2;
    ensureCap(rc);
    rStart[i] = w;
    rCount[i] = rc;
    for (let r = 0; r < rc; r++) {
      rBlock[w] = dv.getUint16(off, false); off += 2;
      rLen[w] = dv.getUint16(off, false); off += 2;
      w++;
    }
    wat[i] = dv.getInt16(off, false); off += 2;
  }
  return {
    surface: surf, water: wat,
    runBlockIds: rBlock.subarray(0, w), runLengths: rLen.subarray(0, w),
    runStart: rStart, runCount: rCount,
  };
}

function parseBiomesBin(ab) {
  // row-major z outer/x inner, u16 per column, no header
  return new Uint16Array(ab);
}

