<% const r = locals.rec, acc = locals.account; %>
<%- include('partials/head', { publicBg: true, pageTitle: r ? acc.name + (r.rank ? ', ' + r.rank : '') + (r.nationName ? ' of ' + r.nationName : '') : 'Service records', pageDescription: r ? `${acc.name}'s service record in The Great War: ${r.kills} kills, ${r.captures} captures, ${r.daysSurvived} days served${r.medalList.length ? ', ' + r.medalList.map(m => m.title).join(', ') : ''}.` : 'Look up any soldier\'s service record in The Great War.' }) %>
<%- include('partials/header') %>
<style>
.sr-wrap { max-width: 820px; margin: 0 auto; padding-bottom: 80px; }
.sr-search { display: flex; gap: 10px; margin: 0 0 22px; }
.sr-search input { flex: 1; min-width: 0; padding: 11px 14px; border-radius: 12px; border: 1px solid var(--line); background: rgba(0,0,0,.25); color: #fff; font: 600 15px 'Baloo 2', sans-serif; }
.sr-wrap .sr-btn { padding: 11px 16px; border-radius: 12px; border: 0; background: #5be38f; color: #0c1a12; font: 800 15px 'Baloo 2', sans-serif; cursor: pointer; }
.sr-sample { margin: 0 0 18px; padding: 10px 14px; border-radius: 10px; border: 1px solid rgba(251,191,36,.35); background: rgba(251,191,36,.08); color: #f4e3b5; font: 700 14px 'Baloo 2', sans-serif; }
.sr-paper { background: #ebe4d1; color: #23201a; border-radius: 6px; padding: 26px 28px; box-shadow: 0 10px 30px rgba(0,0,0,.45); }
.sr-mast { display: flex; justify-content: space-between; gap: 14px; align-items: flex-start; border-bottom: 2px solid #23201a; padding-bottom: 12px; margin-bottom: 16px; }
.sr-mast small { display: block; font: 700 11px Georgia, serif; letter-spacing: .14em; text-transform: uppercase; color: #6a6252; }
.sr-mast h1 { font: 800 clamp(26px, 5vw, 38px)/1.1 'Fraunces', Georgia, serif; margin: 4px 0 0; }
.sr-mast .sr-flag { width: 72px; height: 48px; image-rendering: pixelated; border: 2px solid #23201a; flex: none; }
.sr-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 18px; margin-bottom: 18px; }
.sr-grid div { border-bottom: 1px dotted #8a8170; padding-bottom: 6px; }
.sr-grid span { display: block; font: 700 10.5px Georgia, serif; letter-spacing: .12em; text-transform: uppercase; color: #6a6252; }
.sr-grid b { font: 700 17px Georgia, serif; }
.sr-grid img, .sr-medal img { width: 32px; height: 32px; image-rendering: pixelated; vertical-align: middle; margin-right: 6px; }
.sr-h { font: 800 13px Georgia, serif; letter-spacing: .12em; text-transform: uppercase; margin: 18px 0 8px; }
.sr-medal { display: flex; align-items: center; gap: 8px; margin: 0 0 8px; font: 15px Georgia, serif; }
.sr-medal small { color: #6a6252; }
.sr-noicon { display: inline-block; width: 32px; height: 32px; margin-right: 6px; flex: none; }
.sr-paper p { font: 15px/1.55 Georgia, serif; margin: 0 0 8px; }
.sr-paper a { color: #2a4c8a; }
.sr-none { font: 600 15px 'Baloo 2', sans-serif; color: #c4c8d2; }
@media (max-width: 640px) { .sr-grid { grid-template-columns: 1fr 1fr; } .sr-paper { padding: 18px 16px; } }
</style>
<main class="wrap"><div class="sr-wrap">
  <%- include('partials/home-link') %>
  <div class="page-head"><div><h1 class="page-title">Service records</h1><p class="page-sub">The Great War · every soldier's record</p></div></div>
  <form class="sr-search" method="GET" action="/soldier"><input name="name" maxlength="16" placeholder="A Minecraft name" value="<%= locals.q || '' %>" autocomplete="off" spellcheck="false"><button class="sr-btn" type="submit">Look up</button></form>
  <% if (locals.notice) { %><p class="sr-none"><%= notice %></p><% } %>
  <% if (locals.like && like.length) { %><p class="sr-none">Did you mean: <%- like.slice(0, 8).map(p => `<a href="/soldier/${encodeURIComponent(p.name)}" style="color:#8fb8ff">${p.name.replace(/[<>&"]/g, '')}</a>`).join(', ') %></p><% } %>
  <% if (r) { %>
    <% if (r.sample) { %><div class="sr-sample">The war hasn't started yet: this is a sample record, to show what the page will look like from 17 December.</div><% } %>
    <article class="sr-paper">
      <div class="sr-mast"><div><small>Service record · The Great War, 1914</small><h1><%= acc.name %></h1></div>
        <% if (r.flag) { %><img class="sr-flag" src="/img/flags/<%= r.flag %>.png" alt="The flag of <%= r.nationName %>"><% } %></div>
      <div class="sr-grid">
        <div><span>Nation</span><b><% if (r.nationPage) { %><a href="/nations/<%= r.nationPage %>"><%= r.nationName %></a><% } else { %>None<% } %></b></div>
        <div><span>Rank</span><b><% if (r.rankIcon) { %><img src="/img/career/<%= r.rankIcon %>.png" alt=""><% } %><%= r.rank || (r.alive ? '—' : 'Fallen') %></b></div>
        <div><span>Status</span><b><%= r.alive ? 'Serving' : 'Fallen' %></b></div>
        <div><span>Class</span><b><%= r.class || '—' %></b></div>
        <div><span>Trade</span><b><%= r.specialisation || '—' %></b></div>
        <div><span>Days served</span><b><%= r.daysSurvived %></b></div>
        <div><span>Kills</span><b><%= r.kills %></b></div>
        <div><span>Captures</span><b><%= r.captures %></b></div>
        <% if (r.deaths != null) { %><div><span>Deaths</span><b><%= r.deaths %></b></div><% } %>
        <% if (r.regiment) { %><div><span>Regiment</span><b>[<%= r.regiment %>]</b></div><% } %>
      </div>
      <div class="sr-h">Medals</div>
      <% if (r.medalList.length) { r.medalList.forEach(m => { %><div class="sr-medal"><% if (m.icon) { %><img src="/img/career/medal_<%= m.id %>.png" alt=""><% } else { %><span class="sr-noicon"></span><% } %><span><b><%= m.title %></b> <small><%= m.why %></small></span></div><% }) } else { %><p>None yet.</p><% } %>
      <% if (r.wager && r.wager.rounds) { %><div class="sr-h">The front-line wager</div><p><%= r.wager.points %> points in season <%= r.wager.season %>: <%= r.wager.right %> called right over <%= r.wager.rounds %> window<%= r.wager.rounds === 1 ? '' : 's' %>. <a href="/wager">The table</a></p><% } %>
      <p><a href="/night/<%= encodeURIComponent(acc.name) %>">Their last night at the front</a></p>
      <div class="sr-h">In the Daily Front</div>
      <% if (fights.length) { fights.forEach(f => { %><p><b><%= f.title %></b> (day <%= f.day %>). <%= f.body %></p><% }) } else { %><p>Not in the paper yet.</p><% } %>
    </article>
  <% } else if (!locals.notice) { %><p class="sr-none">Look up any soldier by their Minecraft name: nation, rank, medals and their part in the war.</p><% } %>
</div></main>
<%- include('partials/foot') %>
