<%- include('partials/head', { pageTitle: 'Recording Timeline — Admin' }) %>
<%- include('partials/header') %>

<style>
.rec-wrap { max-width: 960px; margin: 0 auto; padding: 32px 20px 80px; }
.rec-title { font-family: 'Baloo 2'; font-weight: 900; font-size: 24px; color: var(--text); margin-bottom: 4px; }
.rec-sub { font-size: 13px; color: var(--muted); margin-bottom: 28px; }

.rec-toolbar { display: flex; gap: 10px; margin-bottom: 28px; flex-wrap: wrap; align-items: center; }
.rec-input { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; color: var(--text); padding: 9px 13px; font-size: 13px; }
.rec-input::placeholder { color: var(--muted); }
.rec-search { width: 220px; }
.rec-ch-input { width: 220px; }
.rec-btn { padding: 9px 16px; border-radius: 8px; border: 1px solid var(--line); font-size: 13px; font-weight: 600; cursor: pointer; background: var(--panel); color: var(--text); transition: .15s; white-space: nowrap; }
.rec-btn:hover { border-color: var(--accent); color: var(--accent); }
.rec-btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
.rec-btn-primary:hover { opacity: .85; color: #fff; }
.rec-status { font-size: 13px; color: var(--muted); }

.day-tabs { display: flex; gap: 0; margin-bottom: 24px; border-bottom: 1px solid var(--line); overflow-x: auto; }
.day-tab { padding: 10px 20px; font-size: 13px; font-weight: 700; cursor: pointer; border-bottom: 3px solid transparent; color: var(--muted); margin-bottom: -1px; transition: .15s; white-space: nowrap; flex-shrink: 0; }
.day-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.day-tab:hover:not(.active) { color: var(--text); }
.day-tab .badge { display: inline-block; background: var(--line); border-radius: 20px; font-size: 10px; padding: 1px 7px; margin-left: 5px; vertical-align: middle; }
.day-tab.active .badge { background: color-mix(in srgb, var(--accent) 20%, transparent); color: var(--accent); }

.day-panel { display: none; }
.day-panel.active { display: block; }

/* Player card */
.player-card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; margin-bottom: 12px; overflow: hidden; transition: border-color .15s; }
.player-card.hidden { display: none; }
.player-card-head { display: flex; align-items: center; gap: 12px; padding: 14px 18px; cursor: pointer; user-select: none; }
.player-card-head:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
.player-avatar { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: var(--line); }
.player-avatar-fallback { width: 38px; height: 38px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: #fff; flex-shrink: 0; }
.player-info { flex: 1; min-width: 0; }
.player-name { font-size: 14px; font-weight: 700; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-count { font-size: 12px; color: var(--muted); margin-top: 1px; }
.player-chevron { font-size: 14px; color: var(--muted); transition: transform .2s; }
.player-card.open .player-chevron { transform: rotate(180deg); }

/* Submissions inside a card */
.player-body { display: none; border-top: 1px solid var(--line); padding: 16px 18px; }
.player-card.open .player-body { display: block; }

.sub-list { display: flex; flex-direction: column; gap: 12px; }
.sub-entry { display: flex; gap: 10px; align-items: flex-start; }
.sub-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-top: 6px; flex-shrink: 0; }
.sub-content { flex: 1; min-width: 0; }
.sub-time { font-size: 11px; color: var(--muted); margin-bottom: 4px; }
.sub-text { font-size: 13px; color: var(--text); line-height: 1.6; white-space: pre-wrap; word-break: break-word; }

/* Image grid */
.img-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; margin-top: 4px; }
.img-thumb { width: 100%; aspect-ratio: 16/9; object-fit: cover; border-radius: 8px; cursor: pointer; border: 1px solid var(--line); transition: opacity .15s; }
.img-thumb:hover { opacity: .8; }
.video-entry { width: 100%; max-width: 480px; border-radius: 8px; border: 1px solid var(--line); margin-top: 4px; }
.att-link { display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); font-size: 12px; color: var(--accent); text-decoration: none; margin-top: 4px; }
.att-link:hover { border-color: var(--accent); }
.att-size { color: var(--muted); }

.empty-day { text-align: center; padding: 60px 20px; color: var(--muted); font-size: 14px; }
.empty-day strong { display: block; font-size: 18px; color: var(--text); margin-bottom: 8px; }

.lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.88); z-index: 9999; align-items: center; justify-content: center; }
.lightbox.open { display: flex; }
.lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 8px; }
.lightbox-close { position: absolute; top: 20px; right: 24px; color: #fff; font-size: 30px; cursor: pointer; opacity: .7; line-height: 1; }
.lightbox-close:hover { opacity: 1; }
</style>

<%
// Group each day's entries by player
function groupByPlayer(entries) {
  const map = {};
  for (const e of entries) {
    if (!map[e.discord_id]) {
      map[e.discord_id] = { discord_id: e.discord_id, discord_tag: e.discord_tag, discord_avatar: e.discord_avatar, items: [] };
    }
    map[e.discord_id].items.push(e);
  }
  return Object.values(map).sort((a,b) => a.discord_tag.localeCompare(b.discord_tag));
}
%>

<div class="rec-wrap">
  <div class="rec-title">Recording Timeline</div>
  <div class="rec-sub">Player submissions grouped by contributor. Use the day tabs to navigate.</div>

  <div class="rec-toolbar">
    <input class="rec-input rec-search" id="searchInput" placeholder="Search player..." oninput="filterPlayers()" />
    <input class="rec-input rec-ch-input" id="channelInput" placeholder="Channel ID" />
    <button class="rec-btn rec-btn-primary" onclick="postPanel()">Post Panel</button>
    <button class="rec-btn" onclick="collectNow()">Collect Now</button>
    <span class="rec-status" id="collectStatus"></span>
  </div>

  <div class="day-tabs">
    <% for (let d = 1; d <= 6; d++) { %>
    <div class="day-tab <%= d === 1 ? 'active' : '' %>" onclick="showDay(<%= d %>)" id="tab-<%= d %>">
      Day <%= d %>
      <span class="badge"><%= byDay[d].length %></span>
    </div>
    <% } %>
  </div>

  <% for (let d = 1; d <= 6; d++) {
    const players = groupByPlayer(byDay[d]);
  %>
  <div class="day-panel <%= d === 1 ? 'active' : '' %>" id="panel-<%= d %>">
    <% if (!players.length) { %>
    <div class="empty-day">
      <strong>No submissions yet</strong>
      Post the panel in a Discord channel and players can start submitting.
    </div>
    <% } else { %>
    <% for (const player of players) { %>
    <div class="player-card" data-name="<%= (player.discord_tag || '').toLowerCase() %>">
      <div class="player-card-head" onclick="toggleCard(this.parentElement)">
        <% if (player.discord_avatar) { %>
        <img class="player-avatar" src="<%= player.discord_avatar %>" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="player-avatar-fallback" style="display:none"><%= (player.discord_tag || '?')[0].toUpperCase() %></div>
        <% } else { %>
        <div class="player-avatar-fallback"><%= (player.discord_tag || '?')[0].toUpperCase() %></div>
        <% } %>
        <div class="player-info">
          <div class="player-name"><%= player.discord_tag || player.discord_id %></div>
          <div class="player-count"><%= player.items.length %> submission<%= player.items.length !== 1 ? 's' : '' %></div>
        </div>
        <span class="player-chevron">&#9660;</span>
      </div>
      <div class="player-body">
        <div class="sub-list">
          <% for (const item of player.items) { %>
          <div class="sub-entry">
            <div class="sub-dot"></div>
            <div class="sub-content">
              <div class="sub-time"><%= item.submitted_at ? new Date(item.submitted_at).toLocaleString('en-GB', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' }) : '' %></div>
              <% if (item.content_type === 'text') { %>
              <div class="sub-text"><%= item.message_text %></div>
              <% } else { %>
              <% const mime = item.attachment_mime || ''; %>
              <% if (mime.startsWith('image/')) { %>
              <div class="img-grid">
                <img class="img-thumb" src="<%= item.attachment_url %>" alt="<%= item.attachment_filename %>" onclick="openLightbox('<%= item.attachment_url %>')" loading="lazy">
              </div>
              <% } else if (mime.startsWith('video/')) { %>
              <video class="video-entry" controls preload="metadata">
                <source src="<%= item.attachment_url %>" type="<%= mime %>">
                <a href="<%= item.attachment_url %>" target="_blank">Download video</a>
              </video>
              <% } else { %>
              <a class="att-link" href="<%= item.attachment_url %>" target="_blank" rel="noopener">
                <span><%= item.attachment_filename || 'Download file' %></span>
                <% if (item.attachment_size) { %><span class="att-size">(<%= (item.attachment_size/1024/1024).toFixed(1) %> MB)</span><% } %>
              </a>
              <% } %>
              <% } %>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
    <% } %>
  </div>
  <% } %>
</div>

<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close">&times;</span>
  <img id="lightboxImg" src="" alt="">
</div>

<script>
function showDay(d) {
  document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.day-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('tab-' + d).classList.add('active');
  document.getElementById('panel-' + d).classList.add('active');
  filterPlayers();
}

function toggleCard(card) {
  card.classList.toggle('open');
}

function filterPlayers() {
  const q = document.getElementById('searchInput').value.toLowerCase().trim();
  const activePanel = document.querySelector('.day-panel.active');
  if (!activePanel) return;
  activePanel.querySelectorAll('.player-card').forEach(card => {
    const name = card.dataset.name || '';
    card.classList.toggle('hidden', q.length > 0 && !name.includes(q));
  });
}

function openLightbox(src) {
  document.getElementById('lightboxImg').src = src;
  document.getElementById('lightbox').classList.add('open');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('open');
}

async function postPanel() {
  const ch = document.getElementById('channelInput').value.trim();
  if (!ch) { alert('Enter a channel ID.'); return; }
  const r = await fetch('/admin/recording/post-panel', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channel_id: ch })
  });
  const data = await r.json();
  alert(data.ok ? 'Panel posted!' : 'Error: ' + data.error);
}

async function collectNow() {
  const s = document.getElementById('collectStatus');
  s.textContent = 'Collecting...';
  try {
    const r = await fetch('/admin/recording/collect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    });
    const text = await r.text();
    let data;
    try { data = JSON.parse(text); } catch(e) { s.textContent = 'Server error: ' + text.slice(0, 200); return; }
    s.textContent = data.ok
      ? `Collected ${data.collected} item${data.collected !== 1 ? 's' : ''} from ${data.channels} ticket${data.channels !== 1 ? 's' : ''}. Reload to see updates.`
      : 'Error: ' + data.error;
  } catch (err) {
    s.textContent = 'Error: ' + err.message;
  }
}
</script>

<%- include('partials/foot') %>
