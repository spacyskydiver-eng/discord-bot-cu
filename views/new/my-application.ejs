<%- include('partials/head', { pageTitle: 'Your Application' }) %>
<%- include('partials/header') %>

<%
const islandNames = { jungle:'Jungle', snow:'Snow', badlands:'Badlands', forest:'Forest' };
const islandColors = { jungle:'#2f9e44', snow:'#74c0fc', badlands:'#e8590c', forest:'#82c91e' };
function parseJsonField(v) {
  if (!v) return [];
  if (Array.isArray(v)) return v;
  try { return JSON.parse(v) || []; } catch(_) { return []; }
}
const choices = parseJsonField(app.island_choices);
const sessAvail = parseJsonField(app.session_availability);
const ordinals = ['1st','2nd','3rd','4th'];
%>

<style>
.mya-wrap{max-width:820px;margin:0 auto;padding-bottom:60px}
.mya-section{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:24px;margin-bottom:16px}
.mya-section-title{font-family:'Baloo 2';font-weight:800;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:0 0 16px}
.mya-row{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
.mya-field{}
.mya-label{font-size:11px;font-family:'Baloo 2';font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px}
.mya-value{font-size:14px;color:#e0e2ed;font-family:'Baloo 2';font-weight:600;line-height:1.5}
.mya-value.long{white-space:pre-wrap;line-height:1.6;font-family:inherit;font-weight:400;font-size:14px;color:#c9ccdb}
.mya-pill{display:inline-flex;align-items:center;gap:5px;font-family:'Baloo 2';font-weight:700;font-size:12px;padding:3px 10px;border-radius:99px}
.mya-island-row{display:flex;align-items:center;gap:8px;margin-bottom:6px}
.mya-island-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.mya-sess-grid{display:flex;flex-wrap:wrap;gap:6px}
.mya-sess-chip{font-family:'Baloo 2';font-weight:700;font-size:12px;padding:3px 10px;border-radius:99px;background:rgba(91,227,143,.1);color:#5be38f;border:1px solid rgba(91,227,143,.2)}
.mya-sess-chip.missing{background:rgba(255,255,255,.04);color:var(--muted);border-color:var(--border)}
.mya-edit-banner{display:flex;align-items:center;gap:12px;padding:14px 18px;border-radius:var(--radius);margin-bottom:16px;font-family:'Baloo 2';font-weight:700;font-size:14px}
.mya-status-badge{display:inline-flex;align-items:center;gap:6px;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:5px 12px;border-radius:99px}
</style>

<main class="wrap">
  <div class="mya-wrap">

    <div class="page-head" style="margin-bottom:20px">
      <a href="<%= lp %>/applications" class="back">← Applications</a>
      <div>
        <h1 class="page-title">Your Application</h1>
        <% if (event) { %><p class="page-sub">For: <strong><%= (lang === 'fr' && event.title_fr) ? event.title_fr : event.title %></strong></p><% } %>
      </div>
    </div>

    <% if (updated) { %>
    <div style="display:flex;align-items:center;gap:10px;padding:14px 18px;background:rgba(91,227,143,.08);border:1px solid rgba(91,227,143,.25);border-radius:var(--radius);margin-bottom:16px;font-family:'Baloo 2';font-weight:700;font-size:14px;color:#5be38f">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
      Your application has been updated successfully.
    </div>
    <% } %>

    <!-- Edit request status -->
    <% if (app.edit_approved) { %>
    <div class="mya-edit-banner" style="background:rgba(116,192,252,.08);border:1px solid rgba(116,192,252,.25);color:#74c0fc">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span style="flex:1">Staff have approved your edit request. You can now make changes to your application.</span>
      <a href="<%= lp %>/my-application/edit" style="background:rgba(116,192,252,.2);border:1px solid rgba(116,192,252,.3);color:#74c0fc;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:7px 16px;border-radius:8px;text-decoration:none">Edit now →</a>
    </div>
    <% } else if (app.edit_requested) { %>
    <div class="mya-edit-banner" style="background:rgba(251,191,36,.07);border:1px solid rgba(251,191,36,.2);color:#fbbf24">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Your edit request is pending staff approval. You'll get a Discord DM when it's approved.</span>
    </div>
    <% } else if (app.status !== 'declined') { %>
    <div class="mya-edit-banner" style="background:rgba(255,255,255,.04);border:1px solid var(--border);color:#c9ccdb">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      <span style="flex:1">Need to change something? Request an edit and staff will review it.</span>
      <form method="POST" action="<%= lp %>/my-application/request-edit" style="display:inline">
        <button type="submit" style="background:rgba(255,255,255,.08);border:1px solid var(--border);color:#e0e2ed;font-family:'Baloo 2';font-weight:800;font-size:13px;padding:7px 16px;border-radius:8px;cursor:pointer">Request Edit</button>
      </form>
    </div>
    <% } %>

    <!-- Status -->
    <div class="mya-section">
      <div class="mya-section-title">Application Status</div>
      <div style="display:flex;align-items:center;gap:10px">
        <% if (app.status === 'accepted') { %>
          <span class="mya-status-badge" style="background:rgba(91,227,143,.12);color:#5be38f;border:1px solid rgba(91,227,143,.25)">✓ Accepted</span>
        <% } else if (app.status === 'declined') { %>
          <span class="mya-status-badge" style="background:rgba(248,113,113,.1);color:#f87171;border:1px solid rgba(248,113,113,.25)">✕ Declined</span>
        <% } else { %>
          <span class="mya-status-badge" style="background:rgba(251,191,36,.1);color:#fbbf24;border:1px solid rgba(251,191,36,.25)">◎ Under Review</span>
        <% } %>
        <span style="font-size:13px;color:var(--muted)">Submitted <%= app.submitted_at ? new Date(app.submitted_at).toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric'}) : '—' %></span>
      </div>
    </div>

    <!-- Basic Info -->
    <div class="mya-section">
      <div class="mya-section-title">Basic Information</div>
      <div class="mya-row">
        <div class="mya-field"><div class="mya-label">Minecraft IGN</div><div class="mya-value"><%= app.ign || '—' %></div></div>
        <div class="mya-field"><div class="mya-label">Discord Username</div><div class="mya-value"><%= app.discord_username_input || '—' %></div></div>
        <div class="mya-field"><div class="mya-label">Age</div><div class="mya-value"><%= app.age || '—' %></div></div>
        <div class="mya-field"><div class="mya-label">Country</div><div class="mya-value"><%= app.country || '—' %></div></div>
        <div class="mya-field" style="grid-column:1/-1"><div class="mya-label">How did you hear about us?</div><div class="mya-value"><%= app.how_heard || '—' %></div></div>
      </div>
    </div>

    <!-- Session Availability -->
    <div class="mya-section">
      <div class="mya-section-title">Session Availability</div>
      <% if (sessAvail.length === 0) { %>
        <p style="color:var(--muted);font-size:13px;margin:0">No sessions recorded.</p>
      <% } else { %>
        <div class="mya-sess-grid">
          <% for (let i = 1; i <= 10; i++) { %>
            <span class="mya-sess-chip <%= sessAvail.includes(i) ? '' : 'missing' %>">
              Session <%= i %><%= sessAvail.includes(i) ? ' ✓' : ' ✕' %>
            </span>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Experience -->
    <div class="mya-section">
      <div class="mya-section-title">Experience & Content</div>
      <div class="mya-row">
        <div class="mya-field">
          <div class="mya-label">Played civ events before?</div>
          <div class="mya-value"><%= app.played_civ ? 'Yes' : 'No' %></div>
          <% if (app.played_civ && app.played_civ_details) { %>
            <div class="mya-value" style="margin-top:4px;color:var(--muted);font-size:13px"><%= app.played_civ_details %></div>
          <% } %>
        </div>
        <div class="mya-field">
          <div class="mya-label">Creates content?</div>
          <div class="mya-value"><%= app.creates_content ? 'Yes' : 'No' %></div>
          <% if (app.creates_content && app.content_link) { %>
            <div style="margin-top:4px"><a href="<%= app.content_link %>" target="_blank" rel="noopener" style="font-size:13px;color:#74c0fc;text-decoration:none"><%= app.content_link %></a></div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Island Preferences -->
    <div class="mya-section">
      <div class="mya-section-title">Island Preferences</div>
      <% if (choices.length === 0) { %>
        <p style="color:var(--muted);font-size:13px;margin:0">No island preferences recorded.</p>
      <% } else { %>
        <% choices.forEach(function(isl, i) { %>
          <div class="mya-island-row">
            <div class="mya-island-dot" style="background:<%= islandColors[isl] || '#888' %>"></div>
            <span style="font-family:'Baloo 2';font-weight:700;font-size:12px;color:var(--muted);min-width:30px"><%= ordinals[i] || (i+1)+'th' %></span>
            <span style="font-size:14px;color:#e0e2ed"><%= islandNames[isl] || isl %></span>
          </div>
        <% }) %>
      <% } %>
    </div>

    <!-- Friends -->
    <% if (app.friend_requests && app.friend_requests.trim()) { %>
    <div class="mya-section">
      <div class="mya-section-title">Friends to play with</div>
      <div class="mya-value long"><%= app.friend_requests %></div>
    </div>
    <% } %>

    <!-- Playstyle -->
    <div class="mya-section">
      <div class="mya-section-title">Playstyle</div>
      <div class="mya-field" style="margin-bottom:12px">
        <div class="mya-label">Playstyle type</div>
        <div class="mya-value" style="text-transform:capitalize"><%= app.playstyle || '—' %></div>
      </div>
      <div class="mya-field">
        <div class="mya-label">How you'd play this event</div>
        <div class="mya-value long"><%= app.playstyle_description || '—' %></div>
      </div>
    </div>

    <!-- Scenarios -->
    <div class="mya-section">
      <div class="mya-section-title">Scenario Answers</div>
      <div class="mya-field" style="margin-bottom:16px">
        <div class="mya-label">Scenario 1</div>
        <div class="mya-value long"><%= app.scenario_1 || '—' %></div>
      </div>
      <div class="mya-field" style="margin-bottom:16px">
        <div class="mya-label">Scenario 2</div>
        <div class="mya-value long"><%= app.scenario_2 || '—' %></div>
      </div>
      <div class="mya-field">
        <div class="mya-label">Scenario 3</div>
        <div class="mya-value long"><%= app.scenario_3 || '—' %></div>
      </div>
    </div>

    <!-- Application Type -->
    <div class="mya-section">
      <div class="mya-section-title">Your Application</div>
      <% if (app.app_type === 'video') { %>
        <div class="mya-field">
          <div class="mya-label">Type</div>
          <div class="mya-value">Video</div>
        </div>
        <div class="mya-field" style="margin-top:10px">
          <div class="mya-label">Video Link</div>
          <div><a href="<%= app.video_link %>" target="_blank" rel="noopener" style="color:#74c0fc;font-size:14px;text-decoration:none;font-family:'Baloo 2';font-weight:600"><%= app.video_link %></a></div>
        </div>
      <% } else if (app.app_type === 'written') { %>
        <div class="mya-field">
          <div class="mya-label">Type</div>
          <div class="mya-value">Written</div>
        </div>
        <div class="mya-field" style="margin-top:10px">
          <div class="mya-label">Written Application</div>
          <div class="mya-value long"><%= app.written_app || '—' %></div>
        </div>
      <% } else { %>
        <p style="color:var(--muted);font-size:13px;margin:0">—</p>
      <% } %>
    </div>

  </div>
</main>

<%- include('partials/foot') %>
