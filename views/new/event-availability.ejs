<%- include('partials/head', { pageTitle: '150 Player Event — Session Availability' }) %>
<%- include('partials/header') %>

<style>
.av-wrap { max-width: 560px; margin: 0 auto; padding: 40px 20px 80px; }
.av-card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px 24px; margin-bottom: 16px; }
.av-title { font-family: 'Baloo 2'; font-weight: 800; font-size: 22px; color: var(--text); margin: 0 0 6px; }
.av-sub   { font-size: 13px; color: var(--muted); margin: 0 0 24px; line-height: 1.6; }
.sess-label { display: flex; align-items: flex-start; gap: 12px; padding: 12px 14px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 10px; cursor: pointer; transition: border-color .15s; font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; color: var(--text); margin-bottom: 8px; }
.sess-label:hover { border-color: rgba(116,192,252,.4); }
.sess-label.checked { background: rgba(116,192,252,.08); border-color: rgba(116,192,252,.4); }
.sess-label input[type="checkbox"] { width: 16px; height: 16px; flex-shrink: 0; accent-color: #74c0fc; margin-top: 2px; }
.sess-date { font-size: 13px; color: var(--text); }
.sess-time { font-size: 11px; color: var(--muted); margin-top: 2px; }
.sess-num  { font-size: 11px; color: var(--muted); margin-top: 1px; }
.av-status { font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; min-height: 20px; margin: 4px 0 20px; }
.av-status.ok   { color: #5be38f; }
.av-status.warn { color: #f87171; }
.btn-save { width: 100%; font-family: 'Baloo 2'; font-weight: 800; font-size: 15px; padding: 13px; border-radius: 10px; background: var(--banner-1); border: none; color: #fff; cursor: pointer; margin-bottom: 12px; }
.btn-save:hover { opacity: .9; }
.btn-withdraw { width: 100%; font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; padding: 11px; border-radius: 10px; background: transparent; border: 1px solid rgba(248,113,113,.35); color: #f87171; cursor: pointer; }
.btn-withdraw:hover { background: rgba(248,113,113,.08); }
.divider { text-align: center; color: var(--muted); font-size: 12px; margin: 12px 0; }
.alert { border-radius: 10px; padding: 16px 18px; font-family: 'Baloo 2'; font-weight: 700; font-size: 13px; margin-bottom: 20px; }
.alert-success  { background: rgba(91,227,143,.1); border: 1px solid rgba(91,227,143,.3); color: #5be38f; }
.alert-danger   { background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); color: #f87171; }
.alert-info     { background: rgba(116,192,252,.1); border: 1px solid rgba(116,192,252,.3); color: #74c0fc; }
.withdraw-confirm { display: none; }
.withdraw-confirm.visible { display: block; }
</style>

<main class="wrap">
  <div class="av-wrap">

    <%
    const withdrawn = query.withdrawn === '1';
    const saved     = query.saved === '1';
    const error     = query.error;
    const alreadyWithdrawn = app && app.status === 'withdrawn';
    %>

    <% if (withdrawn || alreadyWithdrawn) { %>
      <div class="av-card">
        <div class="av-title">Application Withdrawn</div>
        <div class="av-sub" style="margin-bottom:0">
          Your application for the 150 Player Event has been withdrawn. If you believe this was a mistake, please contact a staff member in the Discord server.
        </div>
      </div>
    <% } else if (!uid || !app) { %>
      <div class="av-card">
        <div class="av-title">Link Not Valid</div>
        <div class="av-sub" style="margin-bottom:0">
          This link isn't valid. Please use the personalised link sent to you via Discord DM. If you're having trouble, contact staff.
        </div>
      </div>
    <% } else { %>

      <div style="margin-bottom:20px">
        <div class="av-title" style="font-size:18px;margin-bottom:4px">150 Player Event</div>
        <div style="font-family:'Baloo 2';font-weight:800;font-size:26px;color:var(--text);margin:0">Session Availability</div>
        <p style="font-size:13px;color:var(--muted);margin:6px 0 0">Hi <strong><%= app.ign || app.discord_tag %></strong> — select the sessions you can attend. Try to attend all 6.</p>
      </div>

      <% if (saved) { %>
        <div class="alert alert-success">✓ Availability saved — thanks for letting us know!</div>
      <% } %>
      <% if (error === 'noselection') { %>
        <div class="alert alert-danger">Please select at least one session, or use the withdraw option below.</div>
      <% } %>

      <div class="av-card">
        <form method="POST" action="/150-availability/submit" id="sessForm" onsubmit="return beforeSubmit()">
          <input type="hidden" name="uid" value="<%= uid %>">
          <input type="hidden" name="sessions" id="sessInput">

          <p style="font-size:13px;color:var(--muted);margin:0 0 14px">Times shown in your local timezone.</p>

          <div id="sessGrid"></div>
          <div id="sessStatus" class="av-status"></div>

          <button type="submit" class="btn-save">Save my availability</button>
        </form>

        <div class="divider">or</div>

        <div id="withdrawStep1">
          <button class="btn-withdraw" onclick="showWithdrawConfirm()">I can't make any of these times</button>
        </div>

        <div class="withdraw-confirm" id="withdrawStep2">
          <div class="alert alert-danger" style="margin-bottom:12px">
            <strong>Are you sure?</strong> This will withdraw your application from the 150 Player Event. This cannot be undone from this page.
          </div>
          <form method="POST" action="/150-availability/withdraw">
            <input type="hidden" name="uid" value="<%= uid %>">
            <button type="submit" class="btn-withdraw">Yes, withdraw my application</button>
          </form>
          <button class="btn-save" style="margin-top:8px;background:var(--panel-2);border:1px solid var(--line);color:var(--muted);font-size:13px;padding:10px" onclick="hideWithdrawConfirm()">Cancel</button>
        </div>
      </div>

    <% } %>
  </div>
</main>

<script>
var SESSION_TIMES = [1787932800,1788019200,1788105600,1788192000,1788278400,1788364800];
var existingSess = <%- JSON.stringify((app && app.session_availability) ? (typeof app.session_availability === 'string' ? JSON.parse(app.session_availability) : app.session_availability) : [1,2,3,4,5,6]) %>;

(function() {
  var grid = document.getElementById('sessGrid');
  if (!grid) return;
  SESSION_TIMES.forEach(function(ts, i) {
    var n = i + 1;
    var d = new Date(ts * 1000);
    var dateStr = d.toLocaleDateString(undefined, { weekday:'long', day:'numeric', month:'long', year:'numeric' });
    var timeStr = d.toLocaleTimeString(undefined, { hour:'2-digit', minute:'2-digit', timeZoneName:'short' });
    var checked = existingSess.includes(n);
    var lbl = document.createElement('label');
    lbl.className = 'sess-label' + (checked ? ' checked' : '');
    lbl.innerHTML =
      '<input type="checkbox" class="sess-chk" data-n="' + n + '"' + (checked ? ' checked' : '') + '>' +
      '<div>' +
        '<div class="sess-date">' + dateStr + '</div>' +
        '<div class="sess-time">' + timeStr + '</div>' +
        '<div class="sess-num">Session ' + n + '</div>' +
      '</div>';
    lbl.querySelector('input').addEventListener('change', function(e) {
      lbl.classList.toggle('checked', e.target.checked);
      updateStatus();
    });
    grid.appendChild(lbl);
  });
  updateStatus();
})();

function updateStatus() {
  var checked = Array.from(document.querySelectorAll('.sess-chk:checked'));
  var st = document.getElementById('sessStatus');
  if (!st) return;
  if (checked.length === 0)      { st.textContent = 'No sessions selected'; st.className = 'av-status warn'; }
  else if (checked.length < 6)   { st.textContent = checked.length + ' of 6 sessions selected — try to attend all if possible'; st.className = 'av-status warn'; }
  else                           { st.textContent = 'All 6 sessions selected ✓'; st.className = 'av-status ok'; }
}

function beforeSubmit() {
  var checked = Array.from(document.querySelectorAll('.sess-chk:checked')).map(function(c){ return +c.dataset.n; });
  if (checked.length === 0) { window.location.href = window.location.pathname + '?uid=<%= uid %>&error=noselection'; return false; }
  document.getElementById('sessInput').value = JSON.stringify(checked);
  return true;
}

function showWithdrawConfirm() {
  document.getElementById('withdrawStep1').style.display = 'none';
  document.getElementById('withdrawStep2').classList.add('visible');
}
function hideWithdrawConfirm() {
  document.getElementById('withdrawStep1').style.display = '';
  document.getElementById('withdrawStep2').classList.remove('visible');
}
</script>

<%- include('partials/foot') %>
