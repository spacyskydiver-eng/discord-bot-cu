<%- include('partials/head', { publicBg: true, noindex: true, _url: '/updates', pageTitle: 'Updates', pageDescription: 'What has changed in The Great War modpack.' }) %>
<%- include('partials/header') %>
<style>
.up-wrap { max-width: 760px; margin: 0 auto; padding-bottom: 80px; }
.up-rel { background: rgba(10,12,18,.74); border: 1px solid var(--line); border-radius: 16px; padding: 18px 22px; margin-bottom: 16px; }
.up-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 8px; }
.up-head h2 { font: 800 22px 'Baloo 2', sans-serif; color: #fff; margin: 0; }
.up-head span { font: 700 14px 'Baloo 2', sans-serif; color: #9aa0ad; }
.up-rel ul { margin: 0; padding: 0 0 0 18px; }
.up-rel li { font: 600 15px/1.55 'Baloo 2', sans-serif; color: #c4c8d2; margin: 0 0 4px; }
.up-empty { font: 600 15px 'Baloo 2', sans-serif; color: #9aa0ad; }
</style>
<main class="wrap"><div class="up-wrap">
  <%- include('partials/home-link') %>
  <div class="page-head"><div><h1 class="page-title">Updates</h1><p class="page-sub">What's changed in the modpack.</p></div></div>
  <% if (!releases.length) { %><p class="up-empty">Nothing here yet.</p><% } %>
  <% releases.forEach(r => { %>
    <article class="up-rel" id="<%= r.version %>">
      <div class="up-head"><h2><%= r.version %></h2><span><%= r.date %></span></div>
      <ul><% r.changes.forEach(c => { %><li><%= c %></li><% }) %></ul>
    </article>
  <% }) %>
</div></main>
<%- include('partials/foot') %>
