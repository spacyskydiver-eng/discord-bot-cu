<%- include('partials/head', { publicBg: true, noindex: true, _url: '/updates', pageTitle: 'Updates', pageDescription: 'The big updates to The Great War.' }) %>
<%- include('partials/header') %>
<style>
.up-wrap { max-width: 820px; margin: 0 auto; padding-bottom: 80px; }
.up-post { background: rgba(10,12,18,.74); border: 1px solid var(--line); border-radius: 16px; padding: 20px 22px; margin-bottom: 18px; }
.up-post.draft { border-style: dashed; border-color: rgba(251,191,36,.5); }
.up-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 0 0 8px; }
.up-head h2 { font: 800 24px 'Baloo 2', sans-serif; color: #fff; margin: 0; }
.up-head .when { font: 700 14px 'Baloo 2', sans-serif; color: #9aa0ad; }
.up-badge { font: 800 11px Inter, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: #fbbf24; border: 1px solid rgba(251,191,36,.5); border-radius: 999px; padding: 2px 8px; }
.up-intro { font: 600 16px/1.6 'Baloo 2', sans-serif; color: #dfe2ea; margin: 0 0 12px; }
.up-post h3 { font: 800 16px 'Baloo 2', sans-serif; color: #fff; margin: 14px 0 4px; }
.up-post ul { margin: 0; padding: 0 0 0 18px; }
.up-post li { font: 600 15px/1.55 'Baloo 2', sans-serif; color: #c4c8d2; margin: 0 0 4px; }
.up-ver { font: 600 12px Inter, sans-serif; color: #6f7484; margin: 14px 0 0; }
.up-empty { font: 600 15px 'Baloo 2', sans-serif; color: #9aa0ad; }
.up-staff { font: 600 13px 'Baloo 2', sans-serif; color: #fbbf24; margin: 0 0 14px; }
.up-staff a { color: #fbbf24; }
</style>
<main class="wrap"><div class="up-wrap">
  <%- include('partials/home-link') %>
  <div class="page-head"><div><h1 class="page-title">Updates</h1><p class="page-sub">The big updates to The Great War, newest first.</p></div></div>
  <% if (staff) { %><p class="up-staff">Staff view: drafts are marked and only staff see them; Alex publishes each post from the control centre. Every small release is on <a href="/staff/releases">the staff list</a>.</p><% } %>
  <% if (!posts.length) { %><p class="up-empty">Nothing here yet.</p><% } %>
  <% posts.forEach(p => { %>
    <article class="up-post<%= p.draft ? ' draft' : '' %>" id="<%= p.id %>">
      <div class="up-head"><h2><%= p.name %></h2><span class="when"><%= p.date %></span><% if (p.draft) { %><span class="up-badge">Draft</span><% } %></div>
      <% if (p.intro) { %><p class="up-intro"><%= p.intro %></p><% } %>
      <% (p.sections || []).forEach(s => { %><h3><%= s.title %></h3><ul><% s.items.forEach(i => { %><li><%= i %></li><% }) %></ul><% }) %>
      <% if (p.version) { %><p class="up-ver">Version <%= p.version %></p><% } %>
    </article>
  <% }) %>
</div></main>
<%- include('partials/foot') %>
