<%- include('partials/head', { pageTitle: 'Mass Kick — Admin' }) %>
<%- include('partials/header') %>

<style>
.kp-wrap { max-width: 900px; margin: 0 auto; padding: 32px 20px 60px; }
.kp-title { font-family: 'Baloo 2'; font-weight: 900; font-size: 22px; color: var(--text); margin-bottom: 4px; }
.kp-sub { font-size: 13px; color: var(--muted); margin-bottom: 28px; }

.kp-warning { background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.3); border-radius: 10px; padding: 14px 18px; margin-bottom: 24px; color: #f87171; font-weight: 700; font-size: 13px; }

.kp-form { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 24px; margin-bottom: 28px; }
.kp-form label { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .05em; }
.kp-form input[type=password] { width: 100%; padding: 10px 14px; background: var(--panel-2); border: 1px solid var(--line); border-radius: 8px; color: var(--text); font-size: 14px; outline: none; }
.kp-form input[type=password]:focus { border-color: rgba(116,192,252,.5); }
.kp-btn { display: inline-block; margin-top: 14px; padding: 10px 22px; border-radius: 9px; border: none; font-family: 'Baloo 2'; font-weight: 800; font-size: 13px; cursor: pointer; }
.kp-btn-preview { background: rgba(116,192,252,.15); border: 1px solid rgba(116,192,252,.35); color: #74c0fc; }
.kp-btn-preview:hover { background: rgba(116,192,252,.22); }
.kp-btn-execute { background: rgba(248,113,113,.15); border: 1px solid rgba(248,113,113,.4); color: #f87171; margin-left: 10px; }
.kp-btn-execute:hover { background: rgba(248,113,113,.22); }

.kp-error { color: #f87171; font-size: 13px; font-weight: 700; margin-top: 10px; }

.kp-server { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; margin-bottom: 16px; overflow: hidden; }
.kp-server-head { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
.kp-server-name { font-family: 'Baloo 2'; font-weight: 800; font-size: 15px; color: var(--text); flex: 1; }
.kp-server-meta { font-size: 12px; color: var(--muted); font-family: 'Baloo 2'; font-weight: 700; }
.kp-badge { display: inline-block; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; }
.kp-badge-kick { background: rgba(248,113,113,.12); border: 1px solid rgba(248,113,113,.3); color: #f87171; }
.kp-badge-ok { background: rgba(74,222,128,.1); border: 1px solid rgba(74,222,128,.25); color: #4ade80; }

.kp-server-body { padding: 14px 18px; }
.kp-server-err { color: #f87171; font-size: 13px; font-weight: 700; }
.kp-no-kick { color: var(--muted); font-size: 13px; }

.kp-user-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.kp-user { background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; padding: 4px 9px; font-size: 12px; color: var(--text); font-family: 'Baloo 2'; font-weight: 700; }
.kp-user-id { font-size: 10px; color: var(--muted); display: block; }

.kp-result-kicked { color: #4ade80; font-weight: 800; font-size: 13px; }
.kp-result-failed { color: #f87171; font-weight: 800; font-size: 13px; margin-left: 12px; }
.kp-result-errors { margin-top: 8px; font-size: 11px; color: var(--muted); }

.kp-confirm-box { background: rgba(248,113,113,.05); border: 1px solid rgba(248,113,113,.25); border-radius: 10px; padding: 16px 20px; margin-top: 20px; }
.kp-confirm-title { font-family: 'Baloo 2'; font-weight: 900; font-size: 14px; color: #f87171; margin-bottom: 8px; }
</style>

<div class="kp-wrap">
  <div class="kp-title">Mass Kick — Nation Servers</div>
  <div class="kp-sub">Preview and execute a kick of all non-event members from every nation server. The main CU server is never touched.</div>

  <div class="kp-warning">
    ⚠️ This will kick every Discord user who is <strong>not</strong> an accepted event participant from every nation server. Bots and nation leaders are excluded. The main CU server (1449004906068312189) is always excluded. This action cannot be undone.
  </div>

  <% if (error) { %>
    <div class="kp-error"><%= error %></div>
  <% } %>

  <% if (!authed) { %>
  <div class="kp-form">
    <form method="POST" action="/admin/kick-preview">
      <label for="pw">Admin password</label>
      <input type="password" id="pw" name="password" placeholder="Enter password" autocomplete="off" autofocus>
      <button type="submit" class="kp-btn kp-btn-preview">Preview kick list</button>
    </form>
  </div>
  <% } %>

  <% if (authed && preview && !executed) { %>
    <%
      const totalToKick = preview.reduce((s, p) => s + (p.to_kick ? p.to_kick.length : 0), 0);
    %>
    <div style="margin-bottom:16px; font-family:'Baloo 2'; font-weight:800; font-size:14px; color:var(--text);">
      Preview: <span style="color:#f87171"><%= totalToKick %> member<%= totalToKick === 1 ? '' : 's' %></span> would be kicked across <%= preview.filter(p=>!p.error).length %> server<%= preview.filter(p=>!p.error).length === 1 ? '' : 's' %>.
    </div>

    <% for (const s of preview) { %>
      <div class="kp-server">
        <div class="kp-server-head">
          <span class="kp-server-name"><%= s.server_name || s.guild_id %></span>
          <% if (!s.error) { %>
            <span class="kp-server-meta"><%= s.total %> members total</span>
            <% if (s.protected_count > 0) { %>
              <span class="kp-badge" style="background:rgba(116,192,252,.1);border-color:rgba(116,192,252,.3);color:#74c0fc">🛡 <%= s.protected_count %> protected</span>
            <% } %>
            <% if (s.to_kick.length > 0) { %>
              <span class="kp-badge kp-badge-kick">kick <%= s.to_kick.length %></span>
            <% } else { %>
              <span class="kp-badge kp-badge-ok">all clear</span>
            <% } %>
          <% } else { %>
            <span class="kp-badge kp-badge-kick">error</span>
          <% } %>
        </div>
        <div class="kp-server-body">
          <% if (s.error) { %>
            <div class="kp-server-err">Failed to fetch members: <%= s.error %></div>
          <% } else if (s.to_kick.length === 0) { %>
            <div class="kp-no-kick">No members to kick — everyone here is in the event.</div>
          <% } else { %>
            <div style="font-size:12px;color:var(--muted);margin-bottom:8px;">Members that would be kicked:</div>
            <div class="kp-user-list">
              <% for (const u of s.to_kick) { %>
                <div class="kp-user">
                  <%= u.tag %>
                  <span class="kp-user-id"><%= u.id %></span>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (totalToKick > 0) { %>
    <div class="kp-confirm-box">
      <div class="kp-confirm-title">Execute kicks</div>
      <p style="font-size:13px;color:var(--muted);margin:0 0 12px;">Enter the password again to confirm and execute. This will kick all <strong style="color:#f87171"><%= totalToKick %> members</strong> listed above.</p>
      <form method="POST" action="/admin/kick-execute">
        <input type="password" name="password" placeholder="Enter password to confirm" autocomplete="off"
          style="padding:9px 13px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;color:var(--text);font-size:13px;outline:none;width:260px;">
        <button type="submit" class="kp-btn kp-btn-execute" onclick="return confirm('Are you absolutely sure? This will kick <%= totalToKick %> people.')">
          ⚡ Execute kicks
        </button>
      </form>
    </div>
    <% } %>
  <% } %>

  <% if (authed && preview && executed) { %>
    <%
      const totalKicked = preview.reduce((s, p) => s + (p.kicked || 0), 0);
      const totalFailed = preview.reduce((s, p) => s + (p.failed || 0), 0);
    %>
    <div style="margin-bottom:16px;font-family:'Baloo 2';font-weight:800;font-size:15px;color:var(--text);">
      Done: <span style="color:#4ade80"><%= totalKicked %> kicked</span><% if (totalFailed > 0) { %>, <span style="color:#f87171"><%= totalFailed %> failed</span><% } %>
    </div>

    <% for (const s of preview) { %>
      <div class="kp-server">
        <div class="kp-server-head">
          <span class="kp-server-name"><%= s.server_name || s.guild_id %></span>
          <span class="kp-badge <%= s.kicked > 0 ? 'kp-badge-kick' : 'kp-badge-ok' %>"><%= s.kicked %> kicked</span>
        </div>
        <% if (s.kicked > 0 || s.failed > 0 || (s.errors && s.errors.length)) { %>
        <div class="kp-server-body">
          <span class="kp-result-kicked">✓ <%= s.kicked %> kicked</span>
          <% if (s.failed > 0) { %><span class="kp-result-failed">✗ <%= s.failed %> failed</span><% } %>
          <% if (s.errors && s.errors.length) { %>
            <div class="kp-result-errors">
              <% for (const e of s.errors) { %><div><%= e %></div><% } %>
            </div>
          <% } %>
        </div>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:20px;">
      <a href="/admin/kick-preview" class="kp-btn kp-btn-preview" style="text-decoration:none;">Run again</a>
    </div>
  <% } %>
</div>

<%- include('partials/foot') %>
