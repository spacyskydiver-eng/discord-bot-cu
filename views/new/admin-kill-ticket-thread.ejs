<%- include('partials/head', { pageTitle: '#' + (log.channel_name || log.channel_id) + ' — Kill Ticket' }) %>
<%- include('partials/header') %>

<style>
.ktt-wrap { max-width: 820px; margin: 0 auto; padding: 32px 20px 80px; }
.ktt-back { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); text-decoration: none; margin-bottom: 20px; transition: .15s; }
.ktt-back:hover { color: var(--accent); }
.ktt-title { font-family: 'Baloo 2'; font-weight: 900; font-size: 22px; color: var(--text); margin-bottom: 4px; }
.ktt-meta { font-size: 13px; color: var(--muted); margin-bottom: 28px; }

.msg { display: flex; gap: 12px; align-items: flex-start; margin-bottom: 18px; }
.msg-avatar { width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; object-fit: cover; background: var(--line); }
.msg-avatar-fallback { width: 38px; height: 38px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: #fff; flex-shrink: 0; }
.msg-body { flex: 1; min-width: 0; }
.msg-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 4px; }
.msg-author { font-size: 14px; font-weight: 700; color: var(--text); }
.msg-time { font-size: 11px; color: var(--muted); }
.msg-text { font-size: 14px; color: var(--text); line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
.msg-img { max-width: 100%; max-height: 360px; border-radius: 8px; margin-top: 6px; cursor: pointer; border: 1px solid var(--line); display: block; }
.msg-video { max-width: 100%; max-height: 360px; border-radius: 8px; margin-top: 6px; border: 1px solid var(--line); }
.msg-file { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); font-size: 12px; color: var(--accent); text-decoration: none; margin-top: 6px; }
.msg-file:hover { border-color: var(--accent); }

.divider { border: none; border-top: 1px solid var(--line); margin: 24px 0; }

.lightbox { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.88); z-index: 9999; align-items: center; justify-content: center; }
.lightbox.open { display: flex; }
.lightbox img { max-width: 92vw; max-height: 92vh; border-radius: 8px; }
.lightbox-close { position: absolute; top: 20px; right: 24px; color: #fff; font-size: 30px; cursor: pointer; opacity: .7; line-height: 1; }
.lightbox-close:hover { opacity: 1; }

.empty { text-align: center; padding: 60px 20px; color: var(--muted); background: var(--panel); border: 1px solid var(--line); border-radius: 12px; }
</style>

<div class="ktt-wrap">
  <a class="ktt-back" href="/admin/kill-ticket-logs">← Back to all tickets</a>
  <div class="ktt-title">#<%= log.channel_name || log.channel_id %></div>
  <div class="ktt-meta">
    Opened by <strong style="color:var(--text)"><%= log.opener_tag || log.opener_discord_id || 'Unknown' %></strong>
    &nbsp;&middot;&nbsp; <%= messages.length %> message<%= messages.length !== 1 ? 's' : '' %>
    &nbsp;&middot;&nbsp; Collected <%= log.collected_at ? new Date(log.collected_at).toLocaleString('en-GB', {day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '—' %>
  </div>

  <% if (!messages.length) { %>
  <div class="empty">No messages collected yet. Run Collect Now from the logs page.</div>
  <% } else { %>
    <% let lastAuthor = null; %>
    <% for (const msg of messages) { %>
      <% const sameAuthor = lastAuthor === msg.author_id; %>
      <% lastAuthor = msg.author_id; %>
      <div class="msg" style="<%= sameAuthor ? 'margin-top:-10px' : '' %>">
        <% if (sameAuthor) { %>
        <div style="width:38px;flex-shrink:0"></div>
        <% } else if (msg.author_avatar) { %>
        <img class="msg-avatar" src="<%= msg.author_avatar %>" alt="" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
        <div class="msg-avatar-fallback" style="display:none"><%= (msg.author_tag || '?')[0].toUpperCase() %></div>
        <% } else { %>
        <div class="msg-avatar-fallback"><%= (msg.author_tag || '?')[0].toUpperCase() %></div>
        <% } %>
        <div class="msg-body">
          <% if (!sameAuthor) { %>
          <div class="msg-head">
            <span class="msg-author"><%= msg.author_tag || msg.author_id %></span>
            <span class="msg-time"><%= msg.sent_at ? new Date(msg.sent_at).toLocaleString('en-GB', {day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) : '' %></span>
          </div>
          <% } %>
          <% if (msg.content_type === 'text') { %>
          <div class="msg-text"><%= msg.content %></div>
          <% } else { %>
          <% const mime = msg.attachment_mime || ''; %>
          <% if (mime.startsWith('image/')) { %>
          <img class="msg-img" src="<%= msg.attachment_url %>" alt="<%= msg.attachment_filename %>" onclick="openLightbox(this.src)" loading="lazy">
          <% } else if (mime.startsWith('video/')) { %>
          <video class="msg-video" controls preload="metadata"><source src="<%= msg.attachment_url %>" type="<%= mime %>"></video>
          <% } else { %>
          <a class="msg-file" href="<%= msg.attachment_url %>" target="_blank" rel="noopener">
            <span><%= msg.attachment_filename || 'Download file' %></span>
            <% if (msg.attachment_size) { %><span style="color:var(--muted)">(<%= (msg.attachment_size/1024/1024).toFixed(1) %> MB)</span><% } %>
          </a>
          <% } %>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close">&times;</span>
  <img id="lightboxImg" src="" alt="">
</div>

<script>
function openLightbox(src) { document.getElementById('lightboxImg').src = src; document.getElementById('lightbox').classList.add('open'); }
function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); }
</script>

<%- include('partials/foot') %>
