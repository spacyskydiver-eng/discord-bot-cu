<header class="banner">
  <div class="banner-inner">
    <a href="<%= lp %>/" class="brand" data-tooltip="Home">
      <span class="cube" data-electric-logo></span>
      CUE
    </a>
    <div class="banner-right">
      <a href="<%= locals.langSwitchUrl %>" class="banner-btn lang-btn" data-tooltip="Switch language"><%= t('lang_switch') %></a>
      <a href="<%= lp %>/staff" class="banner-btn staff-nav" data-tooltip="Staff page"><%= t('header_staff') %></a>
      <% if (locals.user) { %>
        <div class="banner-user">
          <% if (locals.user.avatar) { %>
            <img class="banner-avatar" src="<%= locals.user.avatar %>" alt="">
          <% } %>
          <span><%= locals.user.globalName || locals.user.username %></span>
        </div>
        <% if (locals.isAdmin || locals.isStaffAccess) { %>
          <a href="<%= lp %>/admin" class="banner-btn admin" data-tooltip="Admin panel"><%= t('header_control') %></a>
        <% } %>
        <a href="<%= lp %>/auth/logout" class="banner-btn" data-tooltip="Sign out"><%= t('header_logout') %></a>
      <% } else { %>
        <a href="<%= lp %>/auth/discord" class="banner-login" data-tooltip="Login with Discord"><%= t('header_login') %></a>
      <% } %>
    </div>
  </div>
</header>
