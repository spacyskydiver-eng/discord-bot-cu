<main class="wrap"><div class="tg-wrap">
  <%- include('partials/home-link') %>
  <div class="page-head"><div><h1 class="page-title">Testers' guide</h1><p class="page-sub">Saturday 21 November · one hour · thank you for helping</p></div></div>
  <% if (!isPublic) { %><div class="tg-draft">Hidden: only the owner sees this page until it's made public (site setting testers_guide_public). Check the "not in yet" list against the build before publishing.</div><% } %>
