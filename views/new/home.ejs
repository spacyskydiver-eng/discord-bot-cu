                  <% }); %>
                </div>
              </div>

              <div class="gw-col-sep"></div>

              <!-- Column 3: Wiki -->
              <div class="gw-col">
                <div class="gw-col-head">
                  <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                  Wiki
                </div>

                <div style="font-size:12px;color:#6E769C;margin-bottom:10px;line-height:1.5">
                  Documentation for The Great War event systems, nations, and rules.
                </div>

                <a class="gw-link-item amber" href="/wiki#overview">
                  <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="12" cy="12" r="10"/></svg>
                  <span class="gw-link-label">Overview</span>
                </a>
                <a class="gw-link-item" href="/wiki#nations">
                  <svg viewBox="0 0 24 24"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                  <span class="gw-link-label">Nations</span>
                </a>
                <a class="gw-link-item" href="/wiki#warfare">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  <span class="gw-link-label">Warfare</span>
                </a>
                <a class="gw-link-item" href="/wiki#rules">
                  <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  <span class="gw-link-label">Rules</span>
