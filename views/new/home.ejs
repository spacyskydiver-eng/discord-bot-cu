</div><!-- .wiki-app -->

<script>
(function() {

// ── Sidebar toggle ──────────────────────────────────────────────────────────
function toggleLeft() {
  const left = document.getElementById('leftSplit');
  const handle = document.getElementById('resizeHandle');
  left.classList.toggle('is-collapsed');
  handle.style.display = left.classList.contains('is-collapsed') ? 'none' : '';
}
window.toggleLeft = toggleLeft;

// Ribbon buttons
document.querySelectorAll('[data-ribbon]').forEach(btn => {
  btn.addEventListener('click', function() {
    const panel = this.dataset.ribbon;
    if (panel === 'graph') { window.location = '/wiki#graph'; return; }
    const left = document.getElementById('leftSplit');
    const handle = document.getElementById('resizeHandle');
    if (left.classList.contains('is-collapsed')) {
      left.classList.remove('is-collapsed');
      handle.style.display = '';
    } else {
      left.classList.add('is-collapsed');
      handle.style.display = 'none';
    }
    document.querySelectorAll('[data-ribbon]').forEach(b => b.classList.remove('is-active'));
    this.classList.add('is-active');
  });
});

// Sidebar tab switching
document.querySelectorAll('[data-pane]').forEach(btn => {
  btn.addEventListener('click', function() {
    const id = this.dataset.pane;
    document.querySelectorAll('.sidebar-pane').forEach(p => p.classList.remove('is-active'));
    document.querySelectorAll('[data-pane]').forEach(t => t.classList.remove('is-active'));
    document.getElementById('pane' + id.charAt(0).toUpperCase() + id.slice(1)).classList.add('is-active');
    this.classList.add('is-active');
  });
});

// Resize handle
(function() {
  const handle = document.getElementById('resizeHandle');
  const left = document.getElementById('leftSplit');
  let dragging = false, startX, startW;
  handle.addEventListener('mousedown', e => {
    dragging = true; startX = e.clientX; startW = left.offsetWidth;
    document.body.style.cursor = 'col-resize';
    document.body.style.userSelect = 'none';
    handle.classList.add('is-dragging');
  });
  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    left.style.width = Math.max(160, Math.min(480, startW + e.clientX - startX)) + 'px';
  });
  document.addEventListener('mouseup', () => {
    dragging = false;
    document.body.style.cursor = '';
    document.body.style.userSelect = '';
    handle.classList.remove('is-dragging');
  });
})();

// ── Atmospheric beam canvas ──────────────────────────────────────────────────
(function() {
  const canvas = document.getElementById('beamCanvas');
  const banner = document.getElementById('gwBanner');
  if (!canvas || !banner) return;

  let W, H, dpr, raf = 0;

  function resize() {
    const r = banner.getBoundingClientRect();
    dpr = window.devicePixelRatio || 1;
    W = r.width; H = r.height;
    canvas.width = W * dpr; canvas.height = H * dpr;
    draw();
  }

  function draw() {
    const ctx = canvas.getContext('2d');
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);

    const bx = W * 0.72;   // beam x position (right area)
    const bEnd = H * 0.92; // beam reaches bottom

    // ── Wide atmospheric glow around beam ──
    const aGrad = ctx.createRadialGradient(bx, H * 0.3, 0, bx, H * 0.3, W * 0.55);
    aGrad.addColorStop(0, 'rgba(212,168,75,.07)');
    aGrad.addColorStop(1, 'transparent');
    ctx.fillStyle = aGrad;
    ctx.fillRect(0, 0, W, H);

    // ── Light cone expanding downward from top ──
    const halfCone = bEnd * 0.28;
    const coneGrad = ctx.createLinearGradient(bx, 0, bx, bEnd);
    coneGrad.addColorStop(0, 'rgba(255,248,220,.13)');
    coneGrad.addColorStop(0.35, 'rgba(212,168,75,.07)');
    coneGrad.addColorStop(0.75, 'rgba(212,168,75,.02)');
    coneGrad.addColorStop(1, 'transparent');
    ctx.beginPath();
    ctx.moveTo(bx, 0);
    ctx.lineTo(bx + halfCone, bEnd);
    ctx.lineTo(bx - halfCone, bEnd);
    ctx.closePath();
    ctx.fillStyle = coneGrad;
    ctx.fill();

    // ── Beam layers (bright core + glowing halo) ──
    const layers = [
      { w: 140, alpha: 0.025 },
      { w: 50,  alpha: 0.07  },
      { w: 14,  alpha: 0.35  },
      { w: 4,   alpha: 0.72  },
      { w: 1.5, alpha: 1.0   },
    ];
    for (const layer of layers) {
      const g = ctx.createLinearGradient(bx, 0, bx, bEnd);
      g.addColorStop(0,    `rgba(255,252,235,${layer.alpha})`);
      g.addColorStop(0.08, `rgba(255,230,140,${layer.alpha * 0.92})`);
      g.addColorStop(0.3,  `rgba(212,168,75,${layer.alpha * 0.65})`);
      g.addColorStop(0.65, `rgba(212,168,75,${layer.alpha * 0.22})`);
      g.addColorStop(0.88, `rgba(212,168,75,${layer.alpha * 0.06})`);
      g.addColorStop(1,    'transparent');
      ctx.fillStyle = g;
      ctx.fillRect(bx - layer.w / 2, 0, layer.w, bEnd);
    }

    // ── Base halo where beam meets the banner bottom ──
    const baseY = bEnd;
    const bHalo = ctx.createRadialGradient(bx, baseY, 0, bx, baseY, 120);
    bHalo.addColorStop(0, 'rgba(255,240,180,.22)');
    bHalo.addColorStop(0.45, 'rgba(212,168,75,.08)');
    bHalo.addColorStop(1, 'transparent');
    ctx.fillStyle = bHalo;
    ctx.fillRect(0, 0, W, H);

    // ── Subtle particle/dust scatter around beam ──
    const seed = 42;
    function rng(i) { let x = Math.sin(i * 127.1 + seed * 311.7) * 43758.5453; return x - Math.floor(x); }
    for (let i = 0; i < 60; i++) {
      const px = bx + (rng(i) - 0.5) * 340;
      const py = rng(i * 2) * bEnd * 0.9 + bEnd * 0.05;
      const pr = rng(i * 3) * 1.4 + 0.3;
      const dist = Math.abs(px - bx);
      const alpha = Math.max(0, (1 - dist / 180)) * (0.08 + rng(i * 5) * 0.12) * (1 - py / H);
      ctx.beginPath();
      ctx.arc(px, py, pr, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,220,120,${alpha})`;
      ctx.fill();
    }
  }

  new ResizeObserver(resize).observe(banner);
  resize();
})();

})();
</script>

