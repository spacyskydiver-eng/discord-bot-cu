                <div class="gw-divider"></div>

                <a class="gw-link-item" href="/wiki#graph">
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><path d="M12 10 6 7M12 10l6-3M12 14l-6 3M12 14l6 3"/></svg>
                  <span class="gw-link-label">Graph View</span>
