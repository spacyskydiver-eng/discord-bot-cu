                  <% [['Infantry Weapons','Custom period-accurate firearms'],['Artillery','Indirect fire &amp; siege systems'],['Vehicles','Early-war armour &amp; cavalry'],['Trench Systems','Fortification mechanics']].forEach(function(s){ %>
