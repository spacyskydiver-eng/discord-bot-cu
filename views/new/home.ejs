<%- include('partials/head', { pageTitle: '' }) %>
<%- include('partials/header') %>

<!-- Aurora orbs — follow the mouse like the Astra page -->
<div id="aurora" aria-hidden="true">
  <div class="orb" id="orb1"></div>
  <div class="orb" id="orb2"></div>
  <div class="orb" id="orb3"></div>
  <div class="orb" id="orb4"></div>
</div>
<style>
#aurora{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.orb{position:absolute;border-radius:50%;will-change:transform;top:0;left:0}
#orb1{width:520px;height:520px;background:radial-gradient(circle at center,rgba(124,58,237,.45),transparent 70%);filter:blur(72px)}
#orb2{width:420px;height:420px;background:radial-gradient(circle at center,rgba(37,99,235,.38),transparent 70%);filter:blur(90px)}
#orb3{width:360px;height:360px;background:radial-gradient(circle at center,rgba(192,38,211,.32),transparent 70%);filter:blur(80px)}
#orb4{width:300px;height:300px;background:radial-gradient(circle at center,rgba(20,184,166,.28),transparent 70%);filter:blur(100px)}
</style>

