<% if (locals.isAdmin) { %>
<!-- ── Snake game (admin only) ─────────────────────────────────────────────── -->
<section id="snake-section" style="position:relative;z-index:1;padding:48px 20px 60px;max-width:1100px;margin:0 auto">
  <div style="display:flex;align-items:center;gap:14px;margin-bottom:20px">
    <div style="font-family:'Baloo 2';font-weight:900;font-size:20px;color:#e0e2ed">🐍 Slither</div>
    <div style="font-size:12px;color:var(--muted);font-family:'Baloo 2';font-weight:700;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.25);color:#f87171;padding:2px 9px;border-radius:99px">Admin only</div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 260px;gap:20px;align-items:start">
    <!-- Game canvas -->
    <div style="position:relative">
      <canvas id="snakeCanvas" width="720" height="460"
        style="width:100%;max-width:720px;border-radius:12px;border:1px solid var(--line);background:#060810;display:block;cursor:none;touch-action:none"></canvas>

      <!-- Overlay: start / game-over -->
      <div id="snakeOverlay" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12px;background:rgba(6,8,16,.88);backdrop-filter:blur(4px)">
        <div id="snakeOverlayTitle" style="font-family:'Baloo 2';font-weight:900;font-size:28px;color:#fff;margin-bottom:6px">🐍 Slither</div>
        <div id="snakeOverlaySub" style="font-size:14px;color:rgba(255,255,255,.6);margin-bottom:24px;text-align:center;max-width:280px">Move your mouse to steer. Eat the glowing orbs to grow. Avoid yourself.</div>
        <div id="snakeOverlayScore" style="font-family:'Baloo 2';font-weight:900;font-size:22px;color:#5be38f;margin-bottom:18px;display:none"></div>
        <button id="snakeStartBtn" onclick="snakeStart()" style="font-family:'Baloo 2';font-weight:800;font-size:15px;padding:12px 32px;border-radius:10px;border:none;background:linear-gradient(135deg,#1f9c54,#5be38f);color:#0a0f0d;cursor:pointer">▶ Play</button>
      </div>

      <!-- HUD -->
      <div id="snakeHud" style="position:absolute;top:12px;left:12px;right:12px;display:none;justify-content:space-between;pointer-events:none">
        <div style="font-family:'Baloo 2';font-weight:800;font-size:14px;color:#fff;background:rgba(0,0,0,.55);padding:4px 12px;border-radius:8px">
          Score: <span id="snakeScore" style="color:#5be38f">0</span>
        </div>
        <div style="font-family:'Baloo 2';font-weight:800;font-size:14px;color:#fff;background:rgba(0,0,0,.55);padding:4px 12px;border-radius:8px">
          Best: <span id="snakeBest" style="color:#fbbf24">0</span>
        </div>
      </div>
    </div>

    <!-- Leaderboard -->
    <div style="background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden">
      <div style="padding:14px 16px;border-bottom:1px solid var(--line);font-family:'Baloo 2';font-weight:800;font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">Top 10</div>
      <div id="snakeLb" style="padding:0">
        <div style="padding:20px;color:var(--muted);font-size:13px;text-align:center">Loading...</div>
      </div>
    </div>
  </div>
</section>

<style>
#snakeCanvas { image-rendering: pixelated; }
</style>

<script>
(function() {
  // ── Constants ──────────────────────────────────────────────────────────────
  const CANVAS = document.getElementById('snakeCanvas');
  const CTX = CANVAS.getContext('2d');
  const CW = 720, CH = 460;
  const SPEED = 2.8;          // px per frame
  const SEG_DIST = 7;         // distance between body segments
  const SEG_RAD = 8;          // body segment radius
  const HEAD_RAD = 10;        // head radius
  const FOOD_RAD = 7;         // food radius
  const NUM_FOOD = 12;        // max food on screen

  let state = 'idle';         // idle | running | dead
  let snake, food, score, sessionBest, animId, mouseX, mouseY;

  // Track mouse position in canvas coordinates
  CANVAS.addEventListener('mousemove', e => {
    const r = CANVAS.getBoundingClientRect();
    const sx = CW / r.width, sy = CH / r.height;
    mouseX = (e.clientX - r.left) * sx;
    mouseY = (e.clientY - r.top) * sy;
  });
  CANVAS.addEventListener('touchmove', e => {
    e.preventDefault();
    const r = CANVAS.getBoundingClientRect();
    const sx = CW / r.width, sy = CH / r.height;
    mouseX = (e.touches[0].clientX - r.left) * sx;
    mouseY = (e.touches[0].clientY - r.top) * sy;
  }, { passive: false });

  // ── Colour palette ──────────────────────────────────────────────────────────
  const BODY_COLORS = ['#22c55e','#16a34a','#15803d','#166534'];

  // ── Food generation ─────────────────────────────────────────────────────────
  const FOOD_COLORS = ['#f472b6','#fb923c','#38bdf8','#a78bfa','#fbbf24','#34d399'];
  function randFood() {
    return {
      x: FOOD_RAD + Math.random() * (CW - FOOD_RAD * 2),
      y: FOOD_RAD + Math.random() * (CH - FOOD_RAD * 2),
      color: FOOD_COLORS[Math.floor(Math.random() * FOOD_COLORS.length)],
      phase: Math.random() * Math.PI * 2
    };
  }

  // ── Start ──────────────────────────────────────────────────────────────────
  window.snakeStart = function() {
    if (animId) cancelAnimationFrame(animId);
    score = 0;
    sessionBest = parseInt(document.getElementById('snakeBest').textContent) || 0;
    document.getElementById('snakeScore').textContent = '0';

    // Build initial snake segments (trail-based)
    const cx = CW / 2, cy = CH / 2;
    snake = { head: { x: cx, y: cy, angle: 0 }, trail: [] };
    for (let i = 0; i < 60; i++) snake.trail.push({ x: cx - i * (SEG_DIST / 3), y: cy });

    food = [];
    for (let i = 0; i < NUM_FOOD; i++) food.push(randFood());
    mouseX = cx; mouseY = cy - 40;

    state = 'running';
    document.getElementById('snakeOverlay').style.display = 'none';
    document.getElementById('snakeHud').style.display = 'flex';
    loop();
  };

  // ── Main loop ──────────────────────────────────────────────────────────────
  function loop() {
    update();
    draw();
    if (state === 'running') animId = requestAnimationFrame(loop);
  }

  function update() {
    // Steer head toward mouse
    const dx = mouseX - snake.head.x, dy = mouseY - snake.head.y;
    const dist = Math.sqrt(dx * dx + dy * dy);
    if (dist > 2) {
      const targetAngle = Math.atan2(dy, dx);
      let diff = targetAngle - snake.head.angle;
      while (diff > Math.PI) diff -= 2 * Math.PI;
      while (diff < -Math.PI) diff += 2 * Math.PI;
      const maxTurn = 0.10;
      snake.head.angle += Math.max(-maxTurn, Math.min(maxTurn, diff));
    }

    const newX = snake.head.x + Math.cos(snake.head.angle) * SPEED;
    const newY = snake.head.y + Math.sin(snake.head.angle) * SPEED;

    // Wall collision (bounce off edges)
    if (newX < HEAD_RAD || newX > CW - HEAD_RAD || newY < HEAD_RAD || newY > CH - HEAD_RAD) {
      die(); return;
    }

    snake.head.x = newX;
    snake.head.y = newY;

    // Add head position to trail
    snake.trail.unshift({ x: snake.head.x, y: snake.head.y });
    // Max trail length = score * segs + base
    const maxLen = (60 + score * 4) * (SEG_DIST / SEG_DIST);
    const numSegs = 8 + score * 2;
    const maxTrail = numSegs * SEG_DIST + 60;
    while (snake.trail.length > maxTrail) snake.trail.pop();

    // Food collision
    for (let i = food.length - 1; i >= 0; i--) {
      const f = food[i];
      const fdx = snake.head.x - f.x, fdy = snake.head.y - f.y;
      if (Math.sqrt(fdx * fdx + fdy * fdy) < HEAD_RAD + FOOD_RAD - 2) {
        food.splice(i, 1);
        food.push(randFood());
        score++;
        document.getElementById('snakeScore').textContent = score;
        if (score > sessionBest) {
          sessionBest = score;
          document.getElementById('snakeBest').textContent = score;
        }
      }
    }

    // Self collision (skip first ~40 trail points)
    const skipPts = Math.floor(HEAD_RAD * 3 / SPEED);
    for (let i = skipPts * 3; i < snake.trail.length; i += 3) {
      const s = snake.trail[i];
      const sdx = snake.head.x - s.x, sdy = snake.head.y - s.y;
      if (Math.sqrt(sdx * sdx + sdy * sdy) < SEG_RAD + HEAD_RAD - 4) {
        die(); return;
      }
    }
  }

  function draw() {
    CTX.clearRect(0, 0, CW, CH);

    // Background grid
    CTX.strokeStyle = 'rgba(255,255,255,.03)';
    CTX.lineWidth = 1;
    for (let x = 0; x < CW; x += 40) { CTX.beginPath(); CTX.moveTo(x, 0); CTX.lineTo(x, CH); CTX.stroke(); }
    for (let y = 0; y < CH; y += 40) { CTX.beginPath(); CTX.moveTo(0, y); CTX.lineTo(CW, y); CTX.stroke(); }

    // Food
    const t = performance.now() / 1000;
    for (const f of food) {
      const pulse = 0.85 + 0.15 * Math.sin(t * 2.5 + f.phase);
      const r = FOOD_RAD * pulse;
      // Glow
      const grd = CTX.createRadialGradient(f.x, f.y, 0, f.x, f.y, r * 3);
      grd.addColorStop(0, f.color + 'aa');
      grd.addColorStop(1, f.color + '00');
      CTX.beginPath(); CTX.arc(f.x, f.y, r * 3, 0, Math.PI * 2);
      CTX.fillStyle = grd; CTX.fill();
      // Core
      CTX.beginPath(); CTX.arc(f.x, f.y, r, 0, Math.PI * 2);
      CTX.fillStyle = f.color; CTX.fill();
      // Shine
      CTX.beginPath(); CTX.arc(f.x - r * 0.3, f.y - r * 0.3, r * 0.3, 0, Math.PI * 2);
      CTX.fillStyle = 'rgba(255,255,255,.5)'; CTX.fill();
    }

    // Body (sample trail at SEG_DIST intervals)
    const numSegs = 8 + score * 2;
    for (let s = Math.min(numSegs, Math.floor(snake.trail.length / SEG_DIST)); s >= 0; s--) {
      const idx = Math.min(s * SEG_DIST, snake.trail.length - 1);
      const pt = snake.trail[idx];
      const prog = s / numSegs;
      const r = SEG_RAD * (1 - prog * 0.35);
      const colorIdx = Math.floor(prog * (BODY_COLORS.length - 1));
      CTX.beginPath();
      CTX.arc(pt.x, pt.y, r, 0, Math.PI * 2);
      CTX.fillStyle = BODY_COLORS[Math.min(colorIdx, BODY_COLORS.length - 1)];
      CTX.fill();
    }

    // Head
    CTX.beginPath();
    CTX.arc(snake.head.x, snake.head.y, HEAD_RAD, 0, Math.PI * 2);
    const hg = CTX.createRadialGradient(snake.head.x - 2, snake.head.y - 2, 1, snake.head.x, snake.head.y, HEAD_RAD);
    hg.addColorStop(0, '#86efac');
    hg.addColorStop(1, '#16a34a');
    CTX.fillStyle = hg; CTX.fill();

    // Eyes
    const ex = Math.cos(snake.head.angle - 0.45) * 5;
    const ey = Math.sin(snake.head.angle - 0.45) * 5;
    const ex2 = Math.cos(snake.head.angle + 0.45) * 5;
    const ey2 = Math.sin(snake.head.angle + 0.45) * 5;
    CTX.fillStyle = '#fff';
    CTX.beginPath(); CTX.arc(snake.head.x + ex, snake.head.y + ey, 2.5, 0, Math.PI * 2); CTX.fill();
    CTX.beginPath(); CTX.arc(snake.head.x + ex2, snake.head.y + ey2, 2.5, 0, Math.PI * 2); CTX.fill();
    CTX.fillStyle = '#111';
    CTX.beginPath(); CTX.arc(snake.head.x + ex + Math.cos(snake.head.angle) * 0.7, snake.head.y + ey + Math.sin(snake.head.angle) * 0.7, 1.2, 0, Math.PI * 2); CTX.fill();
    CTX.beginPath(); CTX.arc(snake.head.x + ex2 + Math.cos(snake.head.angle) * 0.7, snake.head.y + ey2 + Math.sin(snake.head.angle) * 0.7, 1.2, 0, Math.PI * 2); CTX.fill();
  }

  function die() {
    state = 'dead';
    cancelAnimationFrame(animId);

    // Save score
    if (score > 0) {
      fetch('/snake/score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ score })
      }).then(() => loadLeaderboard());
    }

    // Show overlay
    const overlay = document.getElementById('snakeOverlay');
    const title = document.getElementById('snakeOverlayTitle');
    const sub = document.getElementById('snakeOverlaySub');
    const scoreEl = document.getElementById('snakeOverlayScore');
    const btn = document.getElementById('snakeStartBtn');
    title.textContent = '💀 Game Over';
    sub.textContent = score > 0 ? 'Your score has been saved to the leaderboard.' : 'Better luck next time.';
    scoreEl.textContent = 'Score: ' + score;
    scoreEl.style.display = '';
    btn.textContent = '↩ Play Again';
    overlay.style.display = 'flex';
    document.getElementById('snakeHud').style.display = 'none';
  }

  // ── Leaderboard ────────────────────────────────────────────────────────────
  async function loadLeaderboard() {
    const el = document.getElementById('snakeLb');
    try {
      const r = await fetch('/snake/leaderboard');
      const rows = await r.json();
      if (!rows.length) { el.innerHTML = '<div style="padding:20px;color:var(--muted);font-size:13px;text-align:center">No scores yet. Play!</div>'; return; }
      const MEDALS = ['🥇','🥈','🥉'];
      el.innerHTML = rows.map((r, i) => `
        <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid var(--line);${i===rows.length-1?'border-bottom:none':''}">
          <span style="font-size:15px;width:22px;text-align:center">${MEDALS[i] || (i+1)}</span>
          <img src="${r.discord_avatar||''}" onerror="this.style.display='none'" style="width:28px;height:28px;border-radius:50%;flex-shrink:0">
          <span style="flex:1;font-family:'Baloo 2';font-weight:700;font-size:13px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.discord_tag||'—'}</span>
          <span style="font-family:'Baloo 2';font-weight:900;font-size:14px;color:#5be38f">${r.score}</span>
        </div>`).join('');
    } catch(e) { el.innerHTML = '<div style="padding:20px;color:#f87171;font-size:13px">Failed to load.</div>'; }
  }

  loadLeaderboard();
})();
</script>
<% } %>

<script>
// ── Interactive repel starfield ───────────────────────────────────────────
(function() {
  var canvas = document.getElementById('starfield');
  var ctx = canvas.getContext('2d');
  var W, H;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', function() {
    resize();
    particles.forEach(function(p) {
      p.ox = Math.random() * W;
      p.oy = Math.random() * H;
      p.x = p.ox; p.y = p.oy;
    });
  });

  var particles = [];
  for (var i = 0; i < 160; i++) {
    var x = Math.random() * W;
    var y = Math.random() * H;
    particles.push({
      ox: x, oy: y, x: x, y: y,
      vx: 0, vy: 0,
      r: Math.random() * 1.3 + 0.4,
      a: Math.random() * 0.5 + 0.2
    });
  }

  var mx = -9999, my = -9999;
  document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
  document.addEventListener('mouseleave', function() { mx = -9999; my = -9999; });

  var REPEL_R = 110, REPEL_F = 6, SPRING = 0.04, DAMP = 0.82;

  function tick() {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var dx = p.x - mx, dy = p.y - my;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < REPEL_R && dist > 0) {
        var s = (1 - dist / REPEL_R);
        p.vx += (dx / dist) * s * REPEL_F;
        p.vy += (dy / dist) * s * REPEL_F;
      }
      p.vx += (p.ox - p.x) * SPRING;
      p.vy += (p.oy - p.y) * SPRING;
      p.vx *= DAMP; p.vy *= DAMP;
      p.x += p.vx; p.y += p.vy;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, 6.2832);
      ctx.fillStyle = 'rgba(255,255,255,' + p.a + ')';
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

// ── Show more ──────────────────────────────────────────────────────────────
var _showMore = document.getElementById('showMore');
var _showMoreText = _showMore ? _showMore.querySelector('.t') : null;
var _showLess = '<%= t("show_less").replace(/'/g, "\\'") %>';
var _showMoreLabel = '<%= t("show_more").replace(/'/g, "\\'") %>';
if (_showMore) {
  _showMore.addEventListener('click', function() {
    var m = document.getElementById('moreText');
    var open = m.classList.toggle('open');
    this.classList.toggle('open', open);
    _showMoreText.textContent = open ? _showLess : _showMoreLabel;
    this.setAttribute('aria-expanded', open);
  });
}
</script>

