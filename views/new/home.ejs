</main>

<script>
// ── Aurora orb mouse follower ──────────────────────────────────────────────
(function() {
  var orbs = [
    { el: document.getElementById('orb1'), x: window.innerWidth*.4,  y: window.innerHeight*.3, speed: 0.06 },
    { el: document.getElementById('orb2'), x: window.innerWidth*.6,  y: window.innerHeight*.5, speed: 0.04 },
    { el: document.getElementById('orb3'), x: window.innerWidth*.3,  y: window.innerHeight*.6, speed: 0.09 },
    { el: document.getElementById('orb4'), x: window.innerWidth*.7,  y: window.innerHeight*.4, speed: 0.12 },
  ];
  var mx = window.innerWidth / 2, my = window.innerHeight / 2;
  var active = true;

  document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
  document.addEventListener('mouseleave', function() { active = false; });
  document.addEventListener('mouseenter', function() { active = true; });

  function tick() {
    orbs.forEach(function(o, i) {
      // Each orb targets the mouse with a slight offset so they spread out
      var tx = mx - o.el.offsetWidth  / 2 + (i % 2 === 0 ? -60 : 60) * (i + 1) * 0.25;
      var ty = my - o.el.offsetHeight / 2 + (i < 2 ? -40 : 40) * (i + 1) * 0.2;
      o.x += (tx - o.x) * o.speed;
      o.y += (ty - o.y) * o.speed;
      o.el.style.transform = 'translate3d(' + Math.round(o.x) + 'px,' + Math.round(o.y) + 'px,0)';
    });
    requestAnimationFrame(tick);
  }
  // Initialise positions
  orbs.forEach(function(o) { o.el.style.transform = 'translate3d('+Math.round(o.x)+'px,'+Math.round(o.y)+'px,0)'; });
  requestAnimationFrame(tick);
})();

// ── Show more ──────────────────────────────────────────────────────────────
var _showMore = document.getElementById('showMore');
var _showMoreText = _showMore ? _showMore.querySelector('.t') : null;
var _showLess = '<%= t("show_less").replace(/'/g, "\\'") %>';
var _showMoreLabel = '<%= t("show_more").replace(/'/g, "\\'") %>';
if (_showMore) {
  _showMore.addEventListener('click', function() {
    var m = document.getElementById('moreText');
    var open = m.classList.toggle('open');
    this.classList.toggle('open', open);
    _showMoreText.textContent = open ? _showLess : _showMoreLabel;
    this.setAttribute('aria-expanded', open);
  });
}
</script>

