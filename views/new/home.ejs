<script>
// ── HoloCard 3-D tilt + moving shine ─────────────────────────────────────────
(function() {
  var cards = document.querySelectorAll('.holo-card');
  var MAX_TILT = 10; // degrees
  var PERSPECTIVE = 900;

  cards.forEach(function(card) {
    var shine = card.querySelector('.holo-shine');

    card.addEventListener('mousemove', function(e) {
      var rect = card.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var y = e.clientY - rect.top;
      var cx = rect.width / 2;
      var cy = rect.height / 2;
      var rx = ((y - cy) / cy) * -MAX_TILT;
      var ry = ((x - cx) / cx) * MAX_TILT;
      var px = ((x / rect.width) * 100).toFixed(1);
      var py = ((y / rect.height) * 100).toFixed(1);

      card.style.transform = 'perspective(' + PERSPECTIVE + 'px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg) translateZ(4px)';
      card.style.boxShadow = '0 24px 52px rgba(0,0,0,.65), 0 0 0 1px rgba(255,255,255,.08)';

      if (shine) {
        shine.style.opacity = '1';
        shine.style.background =
          'radial-gradient(circle at ' + px + '% ' + py + '%, rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.04) 45%, transparent 70%)';
      }
    });

    card.addEventListener('mouseleave', function() {
      card.style.transform = '';
      card.style.boxShadow = '';
      if (shine) {
        shine.style.opacity = '0';
      }
    });
  });
})();
</script>

<script>
// ── Interactive repel starfield ───────────────────────────────────────────
(function() {
  var canvas = document.getElementById('starfield');
  var ctx = canvas.getContext('2d');
  var W, H;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', function() {
    resize();
    particles.forEach(function(p) {
      p.ox = Math.random() * W;
      p.oy = Math.random() * H;
      p.x = p.ox; p.y = p.oy;
    });
  });

  var particles = [];
  for (var i = 0; i < 160; i++) {
    var x = Math.random() * W;
    var y = Math.random() * H;
    particles.push({
      ox: x, oy: y, x: x, y: y,
      vx: 0, vy: 0,
      r: Math.random() * 1.3 + 0.4,
      a: Math.random() * 0.5 + 0.2
    });
  }

  var mx = -9999, my = -9999;
  document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
  document.addEventListener('mouseleave', function() { mx = -9999; my = -9999; });

  var REPEL_R = 110, REPEL_F = 6, SPRING = 0.04, DAMP = 0.82;

  function tick() {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var dx = p.x - mx, dy = p.y - my;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < REPEL_R && dist > 0) {
        var s = (1 - dist / REPEL_R);
        p.vx += (dx / dist) * s * REPEL_F;
        p.vy += (dy / dist) * s * REPEL_F;
      }
      p.vx += (p.ox - p.x) * SPRING;
      p.vy += (p.oy - p.y) * SPRING;
      p.vx *= DAMP; p.vy *= DAMP;
      p.x += p.vx; p.y += p.vy;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, 6.2832);
      ctx.fillStyle = 'rgba(255,255,255,' + p.a + ')';
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

// ── Show more ──────────────────────────────────────────────────────────────
var _showMore = document.getElementById('showMore');
var _showMoreText = _showMore ? _showMore.querySelector('.t') : null;
var _showLess = '<%= t("show_less").replace(/'/g, "\\'") %>';
var _showMoreLabel = '<%= t("show_more").replace(/'/g, "\\'") %>';
if (_showMore) {
  _showMore.addEventListener('click', function() {
    var m = document.getElementById('moreText');
    var open = m.classList.toggle('open');
    this.classList.toggle('open', open);
    _showMoreText.textContent = open ? _showLess : _showMoreLabel;
    this.setAttribute('aria-expanded', open);
  });
}
</script>

