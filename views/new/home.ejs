<% if (locals.isAdmin) { %>
<section id="slither-section" style="position:relative;z-index:1;padding:48px 20px 64px;max-width:1100px;margin:0 auto">

  <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
    <span style="font-family:'Baloo 2';font-weight:900;font-size:20px;color:#e0e2ed">Slither</span>
    <span style="font-family:'Baloo 2';font-weight:700;font-size:11px;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.25);color:#f87171;padding:2px 9px;border-radius:99px">Admin only</span>
  </div>

  <div style="display:grid;grid-template-columns:1fr 256px;gap:20px;align-items:start">

    <div style="position:relative">
      <canvas id="slitherCanvas" width="760" height="480"
        style="width:100%;border-radius:12px;border:1px solid var(--line);display:block;background:#07090f"></canvas>

      <div id="slitherOverlay" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12px;background:rgba(7,9,15,.9);backdrop-filter:blur(6px)">
        <div id="slitherOverlayTitle" style="font-family:'Baloo 2';font-weight:900;font-size:30px;color:#fff;margin-bottom:10px;letter-spacing:-.5px">Slither</div>
        <div style="font-size:13px;color:rgba(255,255,255,.45);margin-bottom:4px;text-align:center;line-height:1.9">
          <span style="color:rgba(255,255,255,.75);font-weight:600">A / D</span> &nbsp;steer &nbsp;&nbsp; <span style="color:rgba(255,255,255,.75);font-weight:600">W</span> &nbsp;boost
        </div>
        <div id="slitherOverlaySub" style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:8px;text-align:center">Eat the orbs to grow. Avoid yourself.</div>
        <div id="slitherOverlayScore" style="font-family:'Baloo 2';font-weight:900;font-size:24px;color:#5be38f;margin:14px 0 2px;display:none"></div>
        <div id="slitherOverlayLen" style="font-size:12px;color:rgba(255,255,255,.35);margin-bottom:18px;display:none"></div>
        <button onclick="slitherStart()" id="slitherPlayBtn"
          style="font-family:'Baloo 2';font-weight:800;font-size:14px;padding:11px 30px;border-radius:9px;border:none;background:#1a7f42;color:#fff;cursor:pointer;letter-spacing:.02em">Play</button>
      </div>

      <div id="slitherHud" style="position:absolute;top:12px;left:12px;right:12px;display:none;justify-content:space-between;pointer-events:none">
        <div style="font-family:'Baloo 2';font-weight:800;font-size:13px;color:#fff;background:rgba(0,0,0,.5);padding:3px 11px;border-radius:7px">
          Score <span id="slitherScore" style="color:#5be38f;margin-left:4px">0</span>
        </div>
        <div id="slitherBoostHud" style="font-family:'Baloo 2';font-weight:700;font-size:12px;color:#93c5fd;background:rgba(0,0,0,.5);padding:3px 11px;border-radius:7px;display:none">BOOST</div>
        <div style="font-family:'Baloo 2';font-weight:800;font-size:13px;color:#fff;background:rgba(0,0,0,.5);padding:3px 11px;border-radius:7px">
          Best <span id="slitherBest" style="color:#fbbf24;margin-left:4px">0</span>
        </div>
      </div>
    </div>

    <div style="background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden">
      <div style="padding:13px 15px;border-bottom:1px solid var(--line);font-family:'Baloo 2';font-weight:800;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em">Top 10</div>
      <div id="slitherLb"><div style="padding:20px;color:var(--muted);font-size:13px;text-align:center">Loading...</div></div>
    </div>

  </div>
</section>

<script>
(function() {
  const C = document.getElementById('slitherCanvas');
  const X = C.getContext('2d');
  const W = 760, H = 480;
  const BODY_R = 9;
  const TAPER_PTS = 22;   // fixed number of tail points that taper — rest of body is full width
  const TURN_SPEED = 0.08; // radians per frame when A or D held
  const FOOD_PALETTE = ['#f472b6','#fb923c','#38bdf8','#a78bfa','#fbbf24','#34d399','#f87171','#c084fc'];

  const keys = {};
  let keyHandler;

  let running = false, raf;
  let score = 0, best = 0;
  let angle = 0;
  let trail = [];
  let targetLen = 0;
  let food = [];

  function onKey(e) {
    const k = e.key.toLowerCase();
    if (k === 'a' || k === 'd' || k === 'w' || k === 's' || k === 'arrowleft' || k === 'arrowright' || k === 'arrowup') {
      keys[k] = e.type === 'keydown';
      if (running) e.preventDefault();
    }
  }

  function spawnFood(n) {
    for (let i = 0; i < n; i++) {
      const r = 3.5 + Math.random() * 3.5;
      food.push({
        x: 24 + Math.random() * (W - 48),
        y: 24 + Math.random() * (H - 48),
        r,
        color: FOOD_PALETTE[Math.floor(Math.random() * FOOD_PALETTE.length)],
        phase: Math.random() * Math.PI * 2,
        value: Math.round(r)
      });
    }
  }

  function reset() {
    trail = [];
    const cx = W / 2, cy = H / 2;
    for (let i = 0; i < 140; i++) trail.push({ x: cx - i * 2, y: cy });
    angle = 0;
    targetLen = 140;
    score = 0;
    food = [];
    spawnFood(26);
    for (const k in keys) keys[k] = false;
  }

  window.slitherStart = function() {
    reset();
    running = true;
    document.getElementById('slitherOverlay').style.display = 'none';
    document.getElementById('slitherHud').style.display = 'flex';
    document.getElementById('slitherScore').textContent = '0';
    if (!keyHandler) { keyHandler = onKey; document.addEventListener('keydown', keyHandler); document.addEventListener('keyup', keyHandler); }
    if (raf) cancelAnimationFrame(raf);
    function loop() { if (!running) return; update(); draw(); raf = requestAnimationFrame(loop); }
    loop();
  };

  function update() {
    const boosting = keys.w || keys.arrowup;
    const speed = boosting ? 5.5 : 3.2;

    // A/D (or arrow keys) rotate the snake
    if (keys.a || keys.arrowleft) angle -= TURN_SPEED;
    if (keys.d || keys.arrowright) angle += TURN_SPEED;

    const nx = trail[0].x + Math.cos(angle) * speed;
    const ny = trail[0].y + Math.sin(angle) * speed;

    if (nx < BODY_R || nx > W - BODY_R || ny < BODY_R || ny > H - BODY_R) { die(); return; }

    trail.unshift({ x: nx, y: ny });

    if (boosting && targetLen > 90) targetLen -= 0.35;
    while (trail.length > Math.ceil(targetLen)) trail.pop();

    for (let i = food.length - 1; i >= 0; i--) {
      const f = food[i];
      if ((nx - f.x) ** 2 + (ny - f.y) ** 2 < (BODY_R + f.r) ** 2) {
        food.splice(i, 1);
        targetLen += f.value * 14;
        score += f.value;
        if (score > best) best = score;
        document.getElementById('slitherScore').textContent = score;
        document.getElementById('slitherBest').textContent = best;
        spawnFood(1);
      }
    }

    // Self collision — skip the first segment worth of points
    const skip = Math.ceil(BODY_R * 4);
    for (let i = skip; i < trail.length; i += 2) {
      if ((nx - trail[i].x) ** 2 + (ny - trail[i].y) ** 2 < (BODY_R - 1) ** 2) { die(); return; }
    }

    document.getElementById('slitherBoostHud').style.display = boosting ? '' : 'none';
  }

  function draw() {
    X.clearRect(0, 0, W, H);

    // Subtle dot grid
    X.fillStyle = 'rgba(255,255,255,0.02)';
    for (let gx = 30; gx < W; gx += 40) for (let gy = 30; gy < H; gy += 40) {
      X.beginPath(); X.arc(gx, gy, 1.2, 0, Math.PI * 2); X.fill();
    }

    const t = performance.now() / 1000;
    const boosting = keys.w || keys.arrowup;

    // Food
    for (const f of food) {
      const pulse = 1 + 0.18 * Math.sin(t * 2.8 + f.phase);
      const gr = X.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r * 3.5);
      gr.addColorStop(0, f.color + 'aa'); gr.addColorStop(1, f.color + '00');
      X.beginPath(); X.arc(f.x, f.y, f.r * 3.5, 0, Math.PI * 2); X.fillStyle = gr; X.fill();
      X.beginPath(); X.arc(f.x, f.y, f.r * pulse, 0, Math.PI * 2); X.fillStyle = f.color; X.fill();
      X.beginPath(); X.arc(f.x - f.r * 0.3, f.y - f.r * 0.3, f.r * 0.3, 0, Math.PI * 2);
      X.fillStyle = 'rgba(255,255,255,.5)'; X.fill();
    }

    const tLen = trail.length;
    if (!tLen) return;

    // Body: draw tail to head so head renders on top.
    // - Last TAPER_PTS points taper in radius to a point (fully opaque throughout).
    // - Rest of body is constant BODY_R.
    // - Color shifts slightly head to tail for depth.
    for (let i = tLen - 1; i >= 0; i--) {
      const p = trail[i];
      const fromTail = tLen - 1 - i; // 0 at tail tip, grows toward head

      const r = fromTail < TAPER_PTS
        ? BODY_R * (fromTail / TAPER_PTS)
        : BODY_R;

      // Slight colour gradient: tail is a bit darker
      const bright = fromTail < TAPER_PTS ? 28 + (fromTail / TAPER_PTS) * 24 : 52;
      const hue = boosting ? 215 : 136;
      const sat = boosting ? 78 : 62;

      X.beginPath(); X.arc(p.x, p.y, r, 0, Math.PI * 2);
      X.fillStyle = `hsl(${hue},${sat}%,${bright}%)`;
      X.fill();
    }

    // Boost trail
    if (boosting) {
      for (let i = 5; i < 24; i += 3) {
        if (i >= trail.length) break;
        const bp = trail[i];
        const a = 0.3 * (1 - i / 24);
        X.beginPath(); X.arc(bp.x, bp.y, BODY_R * 0.55 * (1 - i / 24), 0, Math.PI * 2);
        X.fillStyle = `rgba(147,197,253,${a})`; X.fill();
      }
    }

    // Head
    const hd = trail[0];
    const hgr = X.createRadialGradient(hd.x - 2, hd.y - 2, 0, hd.x, hd.y, BODY_R);
    hgr.addColorStop(0, boosting ? '#bfdbfe' : '#86efac');
    hgr.addColorStop(1, boosting ? '#1d4ed8' : '#166534');
    X.beginPath(); X.arc(hd.x, hd.y, BODY_R, 0, Math.PI * 2);
    X.fillStyle = hgr; X.fill();

    // Eyes
    for (const side of [-0.42, 0.42]) {
      const ex = hd.x + Math.cos(angle + side) * 5.5;
      const ey = hd.y + Math.sin(angle + side) * 5.5;
      X.beginPath(); X.arc(ex, ey, 2.8, 0, Math.PI * 2); X.fillStyle = '#fff'; X.fill();
      X.beginPath(); X.arc(ex + Math.cos(angle) * 0.9, ey + Math.sin(angle) * 0.9, 1.4, 0, Math.PI * 2);
      X.fillStyle = '#111'; X.fill();
    }
  }

  function die() {
    running = false;
    cancelAnimationFrame(raf);
    if (keyHandler) { document.removeEventListener('keydown', keyHandler); document.removeEventListener('keyup', keyHandler); keyHandler = null; }
    if (score > 0) {
      fetch('/snake/score', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ score }) })
        .then(() => loadLeaderboard());
    }
    document.getElementById('slitherOverlayTitle').textContent = 'Game Over';
    document.getElementById('slitherOverlaySub').textContent = score > 0 ? 'Score saved.' : 'Better luck next time.';
    const scoreEl = document.getElementById('slitherOverlayScore');
    scoreEl.textContent = 'Score: ' + score; scoreEl.style.display = '';
    const lenEl = document.getElementById('slitherOverlayLen');
    lenEl.textContent = 'Length: ' + trail.length; lenEl.style.display = '';
    document.getElementById('slitherPlayBtn').textContent = 'Play Again';
    document.getElementById('slitherOverlay').style.display = 'flex';
    document.getElementById('slitherHud').style.display = 'none';
  }

  async function loadLeaderboard() {
    const el = document.getElementById('slitherLb');
    try {
      const res = await fetch('/snake/leaderboard');
      const rows = await res.json();
      if (!rows.length) { el.innerHTML = '<div style="padding:20px;color:var(--muted);font-size:13px;text-align:center">No scores yet.</div>'; return; }
      const ranks = ['1st','2nd','3rd'];
      el.innerHTML = rows.map((r, i) => `
        <div style="display:flex;align-items:center;gap:9px;padding:9px 14px;${i < rows.length-1 ? 'border-bottom:1px solid var(--line)' : ''}">
          <span style="font-family:'Baloo 2';font-weight:900;font-size:10px;color:${i<3?'#fbbf24':'var(--muted)'};width:22px;flex-shrink:0">${ranks[i] || (i+1)}</span>
          <img src="https://cdn.discordapp.com/avatars/${r.discord_id}/${r.discord_avatar}.png?size=32" onerror="this.style.display='none'" style="width:24px;height:24px;border-radius:50%;flex-shrink:0">
          <span style="flex:1;font-family:'Baloo 2';font-weight:700;font-size:12px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${r.discord_tag || '—'}</span>
          <span style="font-family:'Baloo 2';font-weight:900;font-size:13px;color:#5be38f">${r.score}</span>
        </div>`).join('');
    } catch(e) { el.innerHTML = '<div style="padding:20px;color:#f87171;font-size:12px">Failed to load.</div>'; }
  }

  loadLeaderboard();
})();
</script>
<% } %>

<script>
// ── Interactive repel starfield ───────────────────────────────────────────
(function() {
  var canvas = document.getElementById('starfield');
  var ctx = canvas.getContext('2d');
  var W, H;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', function() {
    resize();
    particles.forEach(function(p) {
      p.ox = Math.random() * W;
      p.oy = Math.random() * H;
      p.x = p.ox; p.y = p.oy;
    });
  });

  var particles = [];
  for (var i = 0; i < 160; i++) {
    var x = Math.random() * W;
    var y = Math.random() * H;
    particles.push({
      ox: x, oy: y, x: x, y: y,
      vx: 0, vy: 0,
      r: Math.random() * 1.3 + 0.4,
      a: Math.random() * 0.5 + 0.2
    });
  }

  var mx = -9999, my = -9999;
  document.addEventListener('mousemove', function(e) { mx = e.clientX; my = e.clientY; });
  document.addEventListener('mouseleave', function() { mx = -9999; my = -9999; });

  var REPEL_R = 110, REPEL_F = 6, SPRING = 0.04, DAMP = 0.82;

  function tick() {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var dx = p.x - mx, dy = p.y - my;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < REPEL_R && dist > 0) {
        var s = (1 - dist / REPEL_R);
        p.vx += (dx / dist) * s * REPEL_F;
        p.vy += (dy / dist) * s * REPEL_F;
      }
      p.vx += (p.ox - p.x) * SPRING;
      p.vy += (p.oy - p.y) * SPRING;
      p.vx *= DAMP; p.vy *= DAMP;
      p.x += p.vx; p.y += p.vy;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, 6.2832);
      ctx.fillStyle = 'rgba(255,255,255,' + p.a + ')';
      ctx.fill();
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();

// ── Show more ──────────────────────────────────────────────────────────────
var _showMore = document.getElementById('showMore');
var _showMoreText = _showMore ? _showMore.querySelector('.t') : null;
var _showLess = '<%= t("show_less").replace(/'/g, "\\'") %>';
var _showMoreLabel = '<%= t("show_more").replace(/'/g, "\\'") %>';
if (_showMore) {
  _showMore.addEventListener('click', function() {
    var m = document.getElementById('moreText');
    var open = m.classList.toggle('open');
    this.classList.toggle('open', open);
    _showMoreText.textContent = open ? _showLess : _showMoreLabel;
    this.setAttribute('aria-expanded', open);
  });
}
</script>

