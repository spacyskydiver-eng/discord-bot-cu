                    <svg style="width:12px;height:12px;flex:none;stroke:#34D399;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;margin-top:2px" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                    <div>
                      <div style="font-size:12.5px;font-weight:600;color:#E8EBF8"><%= s[0] %></div>
                      <div style="font-size:11px;color:#6E769C"><%- s[1] %></div>
                    </div>
