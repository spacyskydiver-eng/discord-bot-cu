<%- include('partials/head', { pageTitle: '' }) %>
<link rel="stylesheet" href="/css/wiki.css">
<style>
/* ── Home-dashboard styles (home-only additions on top of wiki.css) ── */
.gw-home { display:flex; flex-direction:column; height:100%; overflow:auto; }

/* Banner: heading left, beam canvas right */
.gw-banner {
  position:relative; flex:none; min-height:240px;
  display:flex; align-items:center;
  padding:44px 52px 40px;
  overflow:hidden;
  border-bottom:1px solid rgba(140,155,255,.1);
}
.gw-banner-text { position:relative; z-index:2; flex:1 }
.gw-kicker {
  font-size:10px; font-weight:700; letter-spacing:.18em;
  text-transform:uppercase; color:#D4A84B;
  background:rgba(212,168,75,.10); border:1px solid rgba(212,168,75,.35);
  border-radius:999px; padding:5px 14px 4px;
  box-shadow:0 0 18px -5px rgba(212,168,75,.6);
  display:inline-block; margin-bottom:20px;
}
.gw-title {
  font-family:'Fraunces',Georgia,serif;
  font-size:clamp(38px,5.5vw,72px);
  font-weight:650; letter-spacing:-.025em; line-height:1.04;
  color:#E8EBF8; margin:0 0 14px;
}
.gw-subtitle { font-size:14px; color:#A7AFD2; line-height:1.6; max-width:380px; }
.gw-subtitle strong { color:#E8EBF8; font-weight:600; }

/* Atmospheric beam */
.gw-beam-wrap {
  position:absolute; inset:0; pointer-events:none; z-index:1;
}
.gw-beam-wrap canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }

/* Stat pills row */
.gw-stats {
  flex:none; display:flex; gap:0;
  border-bottom:1px solid rgba(140,155,255,.10);
}
.gw-stat {
  flex:1; padding:16px 24px;
  border-right:1px solid rgba(140,155,255,.10);
  display:flex; flex-direction:column; gap:3px;
}
.gw-stat:last-child { border-right:none; }
.gw-stat-label {
  font-size:10px; font-weight:700; letter-spacing:.12em;
  text-transform:uppercase; color:#6E769C;
}
.gw-stat-value { font-family:'Fraunces',Georgia,serif; font-size:18px; font-weight:650; color:#E8EBF8; }
.gw-stat-sub { font-size:12px; color:#6E769C; }

/* Dashboard body */
.gw-body {
  flex:1; display:grid;
  grid-template-columns: 1.1fr 1px 1.1fr 1px 1fr;
  min-height:0;
}
.gw-col-sep { background:rgba(140,155,255,.10); }
.gw-col { padding:22px 24px 40px; overflow-y:auto; }
.gw-col-head {
  font-size:10px; font-weight:700; letter-spacing:.12em;
  text-transform:uppercase; color:#6E769C;
  margin:0 0 14px; display:flex; align-items:center; gap:8px;
}
.gw-col-head svg { width:13px; height:13px; stroke:#6E769C; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round; }

/* Link items */
.gw-link-item {
  display:flex; align-items:center; gap:10px;
  padding:9px 10px; border-radius:9px;
  color:#A7AFD2; font-size:13.5px; text-decoration:none;
  cursor:pointer; margin:1px 0;
  transition:background .1s, color .1s;
  border:1px solid transparent;
}
.gw-link-item:hover { background:rgba(140,155,255,.09); color:#E8EBF8; border-color:rgba(140,155,255,.16); }
.gw-link-item svg { width:15px; height:15px; flex:none; stroke:currentColor; fill:none; stroke-width:1.75; stroke-linecap:round; stroke-linejoin:round; }
.gw-link-item .gw-link-label { flex:1; }
.gw-link-item .gw-link-tag {
  font-size:10px; letter-spacing:.06em; text-transform:uppercase;
  color:#6E769C; border:1px solid rgba(140,155,255,.2);
  border-radius:4px; padding:1px 5px;
}
.gw-link-item.accent { color:#34D399; }
.gw-link-item.accent:hover { background:rgba(52,211,153,.09); border-color:rgba(52,211,153,.2); }
.gw-link-item.amber { color:#D4A84B; }
.gw-link-item.amber:hover { background:rgba(212,168,75,.09); border-color:rgba(212,168,75,.2); }

/* Faction chips */
.gw-faction {
  display:flex; align-items:center; gap:10px; padding:10px 12px;
  border-radius:10px; border:1px solid rgba(140,155,255,.14);
  background:rgba(140,155,255,.04); margin:6px 0;
}
.gw-faction-dot { width:9px; height:9px; border-radius:50%; flex:none; box-shadow:0 0 8px currentColor; }
.gw-faction-name { font-size:13px; font-weight:600; color:#E8EBF8; }
.gw-faction-sub { font-size:11px; color:#6E769C; margin-left:auto; }

/* Divider */
.gw-divider { height:1px; background:rgba(140,155,255,.10); margin:14px 0; }

/* Status badge */
.gw-badge {
  display:inline-flex; align-items:center; gap:6px;
  font-size:11.5px; color:#6E769C; margin-top:8px;
  padding:4px 10px; border-radius:7px;
  background:rgba(140,155,255,.06);
  border:1px solid rgba(140,155,255,.14);
}
.gw-badge::before { content:''; width:7px; height:7px; border-radius:50%; background:#D4A84B; box-shadow:0 0 8px rgba(212,168,75,.7); flex:none; }

@media(max-width:860px){
  .gw-banner{ padding:28px 20px 24px; min-height:180px; }
  .gw-stat{ padding:12px 16px }
  .gw-body{ grid-template-columns:1fr; }
  .gw-col-sep{ display:none }
}
</style>

