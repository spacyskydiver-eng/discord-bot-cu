<%- include('partials/head', { pageTitle: 'Nation roles · Control Centre' }) %>
<%- include('partials/header') %>
<style>
.nr-wrap { max-width: 900px; margin: 0 auto; padding-bottom: 80px; }
.nr-box { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 16px; }
.nr-box h2 { font: 800 16px 'Baloo 2', sans-serif; color: #fff; margin: 0 0 8px; }
.nr-box p, .nr-box li { font: 600 14px/1.6 'Baloo 2', sans-serif; color: #b9bdc8; margin: 0 0 8px; }
.nr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 8px 14px; margin-bottom: 12px; }
.nr-grid label { font: 700 13px 'Baloo 2', sans-serif; color: #e8e9ee; }
.nr-grid input { width: 100%; box-sizing: border-box; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--line); background: rgba(0,0,0,.3); color: #fff; font: 13px ui-monospace, Menlo, monospace; }
.nr-wrap .nr-btn { padding: 8px 14px; border-radius: 10px; border: 1px solid var(--line); background: rgba(255,255,255,.06); color: #fff; font: 700 14px 'Baloo 2', sans-serif; cursor: pointer; text-decoration: none; }
.nr-wrap .nr-btn.on { background: #5be38f; color: #0c1a12; border-color: transparent; }
.nr-msg { padding: 10px 14px; border-radius: 10px; background: rgba(91,227,143,.08); border: 1px solid rgba(91,227,143,.35); color: #c9f7da; margin-bottom: 14px; font: 700 14px 'Baloo 2', sans-serif; }
.nr-log { width: 100%; border-collapse: collapse; font: 12.5px ui-monospace, Menlo, monospace; color: #dfe2ea; }
.nr-log td { padding: 4px 6px; border-bottom: 1px solid rgba(255,255,255,.05); }
.nr-warn { color: #fbbf24; }
</style>
<main class="wrap"><div class="nr-wrap">
  <div class="page-head"><div><h1 class="page-title">Nations on Discord</h1><p class="page-sub">Nation, Leader and Seat roles in the CUE Discord, following the game. Now: <b><%= mode %></b>.</p></div></div>
  <% if (msg) { %><div class="nr-msg"><%= msg %></div><% } %>
  <div class="nr-box"><h2>How it works</h2><ul>
    <li>Every 5 minutes it reads the game's nation list and gives each linked player their nation's role, plus Leader and Seat roles. A wiped nation's players lose theirs.</li>
    <li>It only removes roles it gave itself, only looks at players in the game's list (and people it gave roles to), and makes at most <%= MAX %> changes a run, one at a time.</li>
    <li>If the game's list fails, is empty or shrinks by more than a fifth, it changes nothing. <b>Dry</b> logs what it would do without doing it.</li>
    <li>The <b>welcome DM</b> (a link to /welcome/&lt;nation&gt;) goes out when a player first gets a nation role, only while site setting <code>nation_welcome</code> is <code>on</code> as well.</li>
    <li>It creates no roles or channels: make the roles (and each nation's channels, with the role's permissions) in Discord, then paste the role ids below.</li>
    <% if (!feed) { %><li class="nr-warn">The game's nation feed isn't set up yet (NATIONS_FEED_URL), so nothing can run.</li><% } %>
  </ul>
    <form method="POST" action="/admin/nation-roles/mode" style="display:flex;gap:8px;flex-wrap:wrap">
      <% ['off', 'dry', 'on'].forEach(m => { %><button class="nr-btn <%= mode === m ? 'on' : '' %>" name="mode" value="<%= m %>" <%= m === 'on' ? `onclick="return confirm('Switch nation roles ON? The bot will start giving and taking roles in the CUE Discord.')"` : '' %>><%= m === 'off' ? 'Off' : m === 'dry' ? 'Dry run' : 'On' %></button><% }) %>
      <a class="nr-btn" href="/admin/nation-roles?preview=1">Preview the next run</a>
    </form>
  </div>
  <% if (preview) { %><div class="nr-box"><h2>Next run</h2>
    <% if (preview.error) { %><p class="nr-warn"><%= preview.error %></p><% } else { %>
    <p><%= preview.members %> players in nations, <%= preview.linked %> linked on the site. To give: <b><%= preview.give.length %></b>, to take back: <b><%= preview.take.length %></b> (at most <%= MAX %> a run).</p><% } %></div><% } %>
  <form class="nr-box" method="POST" action="/admin/nation-roles/config"><h2>Role ids</h2>
    <div class="nr-grid">
      <% NATIONS.forEach(n => { %><div><label><%= n.name %></label><input name="role_<%= n.id %>" value="<%= cfg.nations[n.id] || '' %>" placeholder="role id"><input name="voice_<%= n.id %>" value="<%= (cfg.voice || {})[n.id] || '' %>" placeholder="voice channel id (for the welcome page)" style="margin-top:4px"></div><% }) %>
      <div><label>Leader</label><input name="role_leader" value="<%= cfg.leader || '' %>" placeholder="role id"></div>
      <div><label>Seat holder</label><input name="role_seat" value="<%= cfg.seat || '' %>" placeholder="role id"></div>
    </div><button class="nr-btn" type="submit">Save role ids</button></form>
  <div class="nr-box"><h2>Log</h2><% if (!log.length) { %><p>Nothing yet.</p><% } else { %>
    <table class="nr-log"><% log.forEach(l => { %><tr><td><%= new Date(l.ts * 1000).toISOString().slice(5, 16).replace('T', ' ') %></td><td><%= l.mode %></td><td><%= l.action %></td><td><%= l.discord_id || '' %></td><td><%= l.kind || '' %></td><td><%= l.note || '' %></td></tr><% }) %></table><% } %></div>
</div></main>
<%- include('partials/foot') %>
